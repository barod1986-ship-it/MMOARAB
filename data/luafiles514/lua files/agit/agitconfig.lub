main = function()
	local ret = true
	local msg = "success"
	for k, v in pairs(tbl_AgitInfo) do
		ret, msg = GlueFunc_SetAgitBaseInfo(k, v.Number, v.Name)
		if false == ret then
			return ret, msg
		end
	end
	for k, v in pairs(tbl_AgitInfo) do
		k = v.Warp.TargetPosY
		v = v.Warp.CostZeny
		ret, msg = GlueFunc_SetAgitAdditionalInfo(k, v.Warp.TargetPosX, k, v, v.Warp.CostZenySeigeTime, v.Warp.AdditionalEFST[1], v.Warp.AdditionalEFST[2])
		if false == ret then
			return ret, msg
		end
	end
	k = v.Name
	return true, "success"
end