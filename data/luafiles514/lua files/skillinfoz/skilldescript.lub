		"[المستوى 2]: ^777777الضرر 400%^000000",
		"[المستوى 3]: ^777777الضرر 500%^000000",
		"[المستوى 4]: ^777777الضرر 600%^000000",
		"[المستوى 5]: ^777777الضرر 700%^000000",
		"",
		"ملاحظات: ^777777تمتلك هذه المهارة خاصية فريدة",
		"جدا، إذ يتأخر الضرر والدفع",
		"بعد تفعيلها. ولهذا استخدامات",
		"متعددة. فمن الممكن، على سبيل المثال، دفع",
		"عدو خارج جدار الأمان لتعريضه",
		"لضربة أسورا. ولأن الدفع",
		"متأخر، يمكنك البدء بإلقاء أسورا قبل",
		"حدوث الدفع فعليا، فلا تمنح",
		"العدو وقتا للرد.",
		"عبر تفعيل المهارة عدة مرات على",
		"الهدف نفسه، يمكن ترتيب عدة",
		"نسخ من ضربة دفع الكف، وستلحق جميعها",
		"الضرر وتدفع العدو.",
		"يمكنك ترتيب عدد من النسخ بقدر ما",
		"تستطيع خلال مهلة الثانية الواحدة قبل تفعيل",
		"النسخة الأولى. ويتيح ASPD المرتفع تنفيذها",
		"بسرعة أكبر، وبالتالي مرات أكثر.",
		"مفيدة جدا للتغلب على مهارة",
		"انسلاخ جلد الزيز الخاصة بالنينجا.",
		"يعتمد اتجاه دفع العدو",
		"على موقع المستخدم عند حدوث",
		"التأثير، وليس عند استخدام المهارة، ويمكن استغلال ذلك",
		"لإرباك الأعداء أكثر. يؤدي تطبيق ضربة دفع الكف",
		"على عدو ثم استخدام نقل الجسد إلى",
		"الخلية نفسها التي يقف فيها إلى",
		"دفعه نحو الغرب.^000000"
	},
