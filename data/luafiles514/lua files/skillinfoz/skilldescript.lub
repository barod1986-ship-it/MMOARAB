	[SKID.ST_FULLSTRIP] = {
		"نزع كامل",
		"أقصى مستوى: 5",
		"^CC3399المتطلب: نزع السلاح 5^000000",
		"نمط المهارة: ^3F0099نشطة^000000",
		"النوع: ^FF0000إضعاف^000000",
		"الهدف: ^6666CCشخصية واحدة^000000",
		"الوصف: ^777777تحاول ^0000FFنزع السلاح والملابس",
		"والدرع^777777 و^0000FFالخوذة^777777 دفعة واحدة.",
		"مثل مهارات ^0000FFالنزع^777777 الفردية، يؤثر الفارق",
		"بين ^CC6600DEX^777777 المستخدم و^CC6600DEX^777777 الهدف",
		"بدرجة كبيرة في فرصة النجاح.^000000",
		"[المستوى 1]: ^777777فرصة أساسية 7% +[2*(uDEX - tDEX)]،",
		"المدة 75 ثانية^000000",
		"[المستوى 2]: ^777777فرصة أساسية 9% +[2*(uDEX - tDEX)]،",
		"المدة 90 ثانية^000000",
		"[المستوى 3]: ^777777فرصة أساسية 11% +[2*(uDEX - tDEX)]،",
		"المدة 105 ثوان^000000",
		"[المستوى 4]: ^777777فرصة أساسية 13% +[2*(uDEX - tDEX)]،",
		"المدة 120 ثانية^000000",
		"[المستوى 5]: ^777777فرصة أساسية 15% +[2*(uDEX - tDEX)]،",
		"المدة 135 ثانية^000000",
		"",
		"ملاحظات: ^777777لا يمكن لقيمة فارق DEX",
		"إلا أن تفيد المستخدم عبر زيادة فرصة",
		"النجاح. وإذا كان DEX الهدف أعلى من",
		"DEX المستخدم، تطبق الفرصة الأساسية",
		"دون أي خفض.",
		"لا يوجد نجاح جزئي، فإما تفشل أو",
		"تنجح وتطبق جميع تأثيرات النزع الممكنة.",
		"إذا لم يكن الهدف مجهزا بأي شيء",
		"في إحدى الخانات، فلن يحصل على تأثير الإضعاف",
		"الذي يمنعه من إعادة تجهيز العناصر. ويمكن لعدو",
		"يشعر بخطر النزع الوشيك",
		"أن ينزع العناصر قبل تلقي",
		"التأثير، وبذلك يمنع",
		"تطبيقه. كما يمكن لعدو",
		"نزعت منه أسلحة اليدين",
		"أن يجهز درعا، لأنه لن",
		"يمتلك تأثير الإضعاف الذي يمنعه من",
		"إعادة تجهيز الدروع.",
		"وفقا لإصدار اللعبة، قد لا يؤدي فشل النزع",
		"إلى عرض اسم المهارة فوق",
		"شخصية المستخدم، وقد لا يجعل",
		"الشخصية تنفذ حركة.",
		"لا تمتلك مهارة نزع كامل زمن إلقاء.",
		"عند الفشل، يتلقى المستخدم رسالة تحذير",
		"'فشلت المهارة'، إلا إذا استخدم /skillfail",
		"لإخفاء هذه الرسالة.",
		"تزداد المدة بمقدار 0.5 ثانية لكل نقطة",
		"DEX يمتلكها المستخدم فوق الهدف، وتستمر 15 ثانية إضافية",
		"على الوحوش. لا تعمل على زعماء MVP",
		"والزعماء.^000000"
	},
	[SKID.WS_WEAPONREFINE] = {
