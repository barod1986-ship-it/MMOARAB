		"والتحكم بالدمية، أو أي مهارة أخرى.^000000"
	},
	[SKID.CG_HERMODE] = {
		"عصا هيرمود",
		"أقصى مستوى: 5",
		"19^CC3399المتطلب: تحسين التركيز 10,\n درس موسيقي 10^000000",
		"20^CC3399المتطلب: تحسين التركيز 10,\n درس الرقص 10^000000",
		"نمط المهارة: ^3F0099نشطة^000000",
		"النوع: ^000099مهارة أغنية ورقصة^000000",
		"الهدف: ^6666CC‏7x7 خلايا حول المستخدم^000000",
		"الوصف: ^777777لا يمكن استخدام هذه المهارة إلا بالقرب",
		"من ^0000FFبوابات الانتقال^777777 داخل خرائط WoE أثناء WoE.",
