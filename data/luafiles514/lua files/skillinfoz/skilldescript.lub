	[SKID.HVAN_EXPLOSION] = {
		"انفجار حيوي",
		"أقصى مستوى: 3",
		"نمط المهارة: ^FF0000هجوم جسدي - ضرر خاص^000000",
		"الوصف: ^777777يدمر الهومنكولوس نفسه",
		"ويلحق ضررا يتجاهل الدفاع بكل",
		"شيء داخل منطقة 9x9 خلايا حوله. يعتمد",
		"الضرر على أقصى HP",
		"للهومنكولوس، وبعد الهجوم تنخفض ألفته",
		"إلى 1.^000000",
		"[المستوى 1]: ^777777ضرر الانفجار: أقصى HP*1^000000",
		"[المستوى 2]: ^777777ضرر الانفجار: أقصى HP*1.5^000000",
		"[المستوى 3]: ^777777ضرر الانفجار: أقصى HP*2^000000",
		"",
		"ملاحظات: ^777777يتجاهل هذا الهجوم أيضا FLEE",
		"وتخفيضات الضرر ومعاملات العناصر. وهو أضعف",
		"بكثير من مهارة فيلير التي تضحي بالألفة،",
		"لكنه يلحق ضرر انتشار بمنطقة تأثير.",
		"عند الاستخدام، يدمر الهومنكولوس نفسه فورا",
		"في مكان وقوفه. ولا يوجد استهداف.",
		"يجب أن تأمره يدويا بالتحرك إلى المكان",
		"الذي تريد استهدافه، ثم تأمره بالانفجار.",
		"سيلحق هذا الضرر بك وبحلفائك",
		"إذا أخطأت الاستخدام!!",
		"بخلاف مهارة فيلير، لا يؤثر مقدار الألفة",
		"المضحى بها في الضرر، بل يعتمد فقط",
		"على أقصى HP لديه. تحتاج إلى 450 نقطة ألفة",
		"على الأقل لاستخدام هذه المهارة.^000000"
	},
	[SKID.MS_BASH] = {
