	[SKID.SL_SKA] = {
		"إسكا",
		"أقصى مستوى: 3",
		"^CC3399المتطلب: روح الراهب 1^000000",
		"النوع: ^FF0000إضعاف^000000",
		"الهدف: ^6666CCشخصية واحدة^000000",
		"مهارات [Es-]: ^777777لا يمكن استخدامها إلا على الوحوش.^000000",
		"الوصف: ^777777تجبر الوحش المستهدف على دخول",
		"حالة مشابهة لمهارة ^0000FFالجسد الفولاذي^777777 الخاصة بالراهب.",
		"يضبط ^CC6600MDEF المرن^777777 على 90، وتنخفض",
		"^CC6600سرعة الحركة^777777 و^CC6600ASPD^777777.",
		"وفي كل هجوم، تضاف قيمة عشوائية",
		"بين 0 و100 إلى ^CC6600DEF المرن^777777.",
		"تعمل على زعماء MVP و^00A100الزعماء^777777.",
		"إذا استخدمت على شخصية لاعب، فلن",
		"يحدث شيء، ويصاب المستخدم بالصعق لمدة 0.5",
		"ثانية.^000000",
		"[المستوى 1]: ^777777المدة 10 ثوان، 100 SP^000000",
		"[المستوى 2]: ^777777المدة 20 ثانية، 80 SP^000000",
		"[المستوى 3]: ^777777المدة 30 ثانية، 60 SP^000000",
		"",
		"ملاحظات: ^777777لا تفعل هذه المهارة شيئا",
		"لقيم DEF الصلب وMDEF الصلب، بل",
		"تغير القيم المرنة فقط.",
		"إذا كان الوحش يمتلك INT مرتفعا جدا، فإن استخدام إسكا",
		"عليه قبل إلحاق ضرر سحري بواسطة إسما",
		"ينبغي أن ينتج ضررا أعلى. تضبط قيمة",
		"MDEF المرن على 90، سواء",
		"كانت أعلى أو أقل من ذلك.",
		"عند دعم حليف يستخدم خنجر الجليد",
		"أو بطاقة ثاناتوس، يجدر دائما",
		"استخدام إسكا على العدو، لأنها تزيد",
		"قيمة DEF المرن بدلا من ضبطها على",
		"قيمة ثابتة.^000000"
	},
	[SKID.ST_PRESERVE] = {
