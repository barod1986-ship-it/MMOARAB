	[SKID.AS_RIGHT] = {
		"إتقان اليد اليمنى",
		"أقصى مستوى: 5",
		"نمط المهارة: ^6666CCسلبية^000000",
		"الوصف: ^777777تزيد ضرر",
		"^990099السلاح^777777 الموجود في اليد اليمنى عند تجهيز",
		"سلاحين. يؤدي تجهيز سلاحين",
		"في الوقت نفسه إلى خفض ^CC6600قوة هجوم^777777 ^990099السلاح^777777",
		"في اليد اليمنى إلى 50% فقط.^000000",
		"[المستوى 1]: ^777777ضرر 60%^000000",
		"[المستوى 2]: ^777777ضرر 70%^000000",
		"[المستوى 3]: ^777777ضرر 80%^000000",
		"[المستوى 4]: ^777777ضرر 90%^000000",
		"[المستوى 5]: ^777777ضرر 100%^000000",
		"",
		"ملاحظات: ^777777تؤثر مهارتا إتقان اليدين",
		"اليمنى واليسرى في الهجمات التلقائية فقط.",
		"عند استخدام أي مهارة أثناء حمل سلاحين،",
		"تحسب اللعبة الضرر باستخدام ATK",
		"سلاح اليد اليمنى فقط، وتتجاهل تماما",
		"ATK سلاح اليد اليسرى. ولا توجد",
		"عقوبة لحمل سلاحين عند استخدام المهارات.",
		"لا تكون مهارتا إتقان اليدين اليمنى واليسرى",
		"ضروريتين إلا إذا كنت ستستخدم الهجمات التلقائية.",
		"ولا تفعل هذه المهارة شيئا عند استخدام الكاتار.",
		"",
		"وفقا لأحدث تطبيق في rAthena، توجد",
		"عدة أمور ينبغي تذكرها. تطبق جميع بطاقات",
		"الأسلحة، سواء وضعت في اليد اليمنى أو اليسرى،",
		"على اليد اليمنى فقط،",
		"وهي سلاحك الرئيسي. ورغم وجود",
		"خيار في الإعدادات لتغيير ذلك، فإن الإعداد الافتراضي",
		"يجعل البطاقات تحتسب لليد اليمنى",
		"فقط. أضف إلى ذلك أن EDP أصبح يؤثر",
		"في اليد اليمنى فقط. ولذلك، حتى لدى",
		"سيد مغتالين مجهز بالكامل وبطاقات كاملة",
		"مع تفعيل EDP، لن تتعزز اليد اليسرى،",
		"مما يجعل من الممكن أن يلحق هجوم اليد اليسرى",
		"أقل من 10% من",
		"إجمالي الضرر.",
		"",
		"تستثنى من قاعدة تطبيق البطاقات",
		"بطاقات زيادة ضرر CRIT بنسبة مئوية",
		"مثل bCritATKRate، ومنها موبستر",
		"وذا بيبر. تطبق زيادة الضرر في هذه",
		"الحالة فقط على ضربات اليدين",
		"اليمنى واليسرى. لكن هذه البطاقات",
		"ليست صعبة الحصول فحسب، بل يصعب استخدامها أيضا،",
		"لأن الهجمات المزدوجة في نظام ما قبل التجديد",
		"لا يمكن أن تكون ضربات حرجة في الوقت نفسه.^000000"
	},
