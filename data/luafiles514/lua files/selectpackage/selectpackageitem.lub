function querypackageitemboxname(Index)
	if packageitemboxName[Index] == nil then
		return nil, nil, nil
	end
	return packageitemboxName[Index][1], packageitemboxName[Index][2], packageitemboxName[Index][3]
end

function querychoicepackageitemlist(Index)
	if packageitemsetbox[Index] == nil then
		return nil, nil, nil, nil, nil, nil, nil, nil, nil
	end
	return packageitemsetbox[Index][1], packageitemsetbox[Index][2], packageitemsetbox[Index][3], packageitemsetbox[Index][4], packageitemsetbox[Index][5], packageitemsetbox[Index][6], packageitemsetbox[Index][7], packageitemsetbox[Index][8], packageitemsetbox[Index][9]
end