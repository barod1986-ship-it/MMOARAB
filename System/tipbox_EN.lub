	[28] = {
		Title = "الحظر",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip00028",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"يستخدم /ex [اسم الشخصية] لحظر الشخصية أو رسائل الهمس منها. ويمكنك إلغاء الحظر باستخدام /in [اسم الشخصية].\\nيمكنك أيضا حظر جميع المحادثات ورسائل الهمس أو إلغاء حظرها باستخدام الأمرين /exall و/inall.\\nلعرض قائمة الشخصيات المحظورة، استخدم /ex.\\n^ff0000لن يطلب منك تأكيد (Y/N)، لذا اختر بعناية.^000000\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
