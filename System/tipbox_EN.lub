	[4008] = {
		Title = "مدينة الجبال بايون",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04008",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"مدينة تقع بين الجبال جنوب شرق رون-ميدغارد. وقد طورت ثقافة مستقلة إلى حد كبير بسبب عزلتها الطويلة عن العالم الخارجي بفعل الجبال والغابات المعقدة. وتروى قصص كثيرة عن تمتعها بحماية الوحوش المقدسة الأربعة أو الوحوش الإلهية. كما يوجد فيها كثير من الرماة والصيادين المهرة، ويوجد منزل مهجور داخل الكهف الشمالي.\n?<NAVI>[نزل ضوء القمر]<INFO>payon_in01,136,61,0,101,0</INFO></NAVI>\n?<NAVI>[الحداد]<INFO>payon,144,173,0,101,0</INFO></NAVI>\n?<NAVI>[نقابة الرماة]<INFO>payon_in02,64,71,0,101,0</INFO></NAVI>\n?<NAVI>[بوذا بايون]<INFO>pay_arche,137,31,0,101,0</INFO></NAVI>\n?<NAVI>[القرية المهجورة]<INFO>pay_dun03,155,147,0,101,0</INFO></NAVI>\n\n?<TIPBOX>مملكة رون-ميدغارد<INFO>4004</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
