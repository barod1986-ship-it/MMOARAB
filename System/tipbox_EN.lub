		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04015",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"بعد أن دمر ملك الشياطين موروك مدينة الصحراء الجميلة ومزق الأبعاد وفر هاربا، أقام اتحاد الممالك الثلاث معسكرا للبعثة في العالم الواقع خلف الصدع البعدي لتعقبه. وتستمر مغامرتك هناك مع أشخاص تلتقي بهم لأول مرة وسط بيئة غريبة.\n\n?<TIPBOX>الأرض خلف الأبعاد<INFO>4002</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
