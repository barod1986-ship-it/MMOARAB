		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04009",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"مدينة تضم ميناء متصلا بجميع الطرق المائية في ميدغارد، وتعرف أيضا بالمدينة التجارية لوجود نقابة التجار فيها. وهي ملتقى لمن يستمتعون باستكشاف المجهول عبر البحار ولمن يتابعون حركة الأموال.\n?<NAVI>[نقابة التجار]<INFO>alberta_in,56,43,0,101,0</INFO></NAVI>\n?<NAVI>[متجر الأدوات]<INFO>alberta_in,183,90,0,101,0</INFO></NAVI>\n?<NAVI>[الحداد]<INFO>alberta_in,23,59,0,101,0</INFO></NAVI>\n?<NAVI>[نزل الصيادين]<INFO>alberta_in,23,142,0,101,0</INFO></NAVI>\n\nيمكنك السفر بالقارب من مدينة ألبرتا الساحلية إلى عدة مناطق.\n?<NAVI>[خدمة العبارة]<INFO>alberta,189,151,0,101,0</INFO></NAVI>\n?<NAVI>[إلى السفينة الغارقة]<INFO>alberta,195,151,0,101,0</INFO></NAVI>\n?<NAVI>[إلى أماتسو]<INFO>alberta,246,74,0,101,0</INFO></NAVI>\n?<NAVI>[إلى أيوثايا]<INFO>alberta,246,40,0,101,0</INFO></NAVI>\n?<NAVI>[إلى أيوثايا]<INFO>alberta,246 ,29,0,101,0</INFO></NAVI>\n?<NAVI>[إلى برازيليس]<INFO>alberta,246,82,0,101,0</INFO></NAVI>\n?<NAVI>[إلى ميناء مالايا]<INFO>alberta,196,202,0,101,0</INFO></NAVI>\n?<NAVI>[إلى كونلون]<INFO>alberta,246, 62,0,101,0</INFO></NAVI>\n?<NAVI>[إلى ديواتا]<INFO>alberta,212,202,0,101,0</INFO></NAVI>\n?<NAVI>[إلى موسكوفيا]<INFO>alberta,246,51,0,101,0</INFO></NAVI>\n?<NAVI>[إلى روك ريدج]<INFO>alberta,240,103,0,101,0</INFO></NAVI>\n\n?<TIPBOX>مملكة رون-ميدغارد<INFO>4004</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
