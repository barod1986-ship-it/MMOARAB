		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04011",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"قرية غامضة تقع داخل كهف تكون أسفل الساحل الجنوبي الغربي. يأتي إليها كثير من السياح للاستجمام، ولذلك طورت فيها منتجات محلية عديدة. كما تعد مكانا جذابا للمستكشفين لوجود المستنقعات والغابات والكهوف السرية بالقرب منها.\n?<NAVI>[قرية التخييم]<INFO>comodo,209,308,0,101,0</INFO></NAVI>\n?<NAVI>[الكازينو]<INFO>comodo,140,111,0,101,0</INFO></NAVI>\n?<NAVI>[كهف ماو الشرقي]<INFO>comodo,327,175,0,101,0</INFO></NAVI>\n?<NAVI>[كهف كارو الغربي]<INFO>comodo,28,215,0,101,0</INFO></NAVI>\n?<NAVI>[كهف رواندي الشمالي]<INFO>comodo,176,355,0,101,0</INFO></NAVI>\n?<NAVI>[مسرح رقصة الهولا]<INFO>comodo,189,163,0,101,0</INFO></NAVI>\n\n?<TIPBOX>مملكة رون-ميدغارد<INFO>4004</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4012] = {
