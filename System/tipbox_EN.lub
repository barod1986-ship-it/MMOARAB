		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04005",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"تقع في قلب مملكة رون-ميدغارد، وهي العاصمة التي يوجد فيها القصر الملكي.\nوبفضل سهولها الواسعة ووقوع جبال ميولنير خلفها، تتعرض لأضرار أقل من الوحوش مقارنة بالمناطق الأخرى وتنعم بالسلام.\nتوجد فيها كاتدرائية مكرسة للإله أودين وفرسان المعبد، لذلك يجتمع فيها كثير ممن يحلمون بأن يصبحوا كهنة أو فرسانا.\n?<NAVI>[كاتدرائية برونتيرا]<INFO>prontera,235,315,0,101,0</INFO></NAVI>\n?<NAVI>[مكتب الفرسان الصليبيين]<INFO> prt_cas,248,102,0,101,0</INFO></NAVI>\n?<NAVI>[فرسان برونتيرا]<INFO>prontera,49,342,0,101,0</INFO></NAVI>\n?<NAVI>[دير القديس كابيتولين]<INFO>prt_monk,180,205,0,101,0</INFO></NAVI>\n?<NAVI>[ورشة الظل]<INFO>prontera,268,108, 0,101,0</INFO></NAVI>\n?<NAVI>[نزل نينكاراس - الفرع الأول]<INFO>prt_in,240,136,0,101,0</INFO></NAVI>\n?<NAVI>[نزل نينكاراس - الفرع الثاني]<INFO>prt_in,67,135,0,101,0</INFO></NAVI>\n?<NAVI>[الحداد]<INFO>prt_in,60,70, 0,101,0</INFO></NAVI>\n?<NAVI>[تاجر الأدوات]<INFO>prt_in,129,72,0,101,0</INFO></NAVI>\n\n?<TIPBOX>مملكة رون-ميدغارد<INFO>4004</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4006] = {
		Title = "مدينة السحر غيفن",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04006",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"مدينة للسحرة تقع خلف المستنقعات غرب برونتيرا. ويتوسطها برج ضخم يدعى برج غيفن، وتشير الشائعات إلى أن موقعه كان في الماضي موطن مدينة غيفينيا الأسطورية. وتقام فيها مهرجانات للسحرة، مثل بطولة غيفن السحرية.\n?<NAVI>[نقابة السحرة]<INFO>geffen_in,164,124,0,101,0</INFO></NAVI>\n?<NAVI>[برج غيفن]<INFO> gef_tower,111,27,0,101,0</INFO></NAVI>\n?<NAVI>[مرصد غيفن]<INFO>gef_fild07,179,242,0,101,0</INFO></NAVI>\n?<NAVI>[نزل إفريت]<INFO>geffen_in,70,56,0,101,0</INFO></NAVI>\n\n?<TIPBOX>مملكة رون-ميدغارد<INFO>4004</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
