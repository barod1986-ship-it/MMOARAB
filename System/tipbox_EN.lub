	[64] = {
		Title = "المخزون: العناصر#الحقيبة",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip00064",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"يمكنك الاحتفاظ بالعناصر التي تحصل عليها في مخزونك. ويمكنك عرض تفاصيل محتويات المخزون بالضغط على ALT+E.\nيمكنك الاحتفاظ بما يصل إلى 100 عنصر في الوقت نفسه ضمن حد الوزن.\n?<TIPBOX>العنصر<INFO>17</INFO></TIPBOX>\n?<TIPBOX>الشخصية: الوزن<INFO>13</INFO></TIPBOX>\n?<TIPBOX>المخزون: التوسعة<INFO>65</INFO></TIPBOX>\n?<TIPBOX>المخزون: تبويب المفضلة<INFO>195</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[65] = {
		Title = "المخزون: التوسعة",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip00065",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"توسعة المخزون هي ميزة تزيد الحد الأقصى لعدد العناصر التي يمكن للشخصية الاحتفاظ بها.\n\يمكنك زيادة الحد الأقصى لعدد العناصر بالنقر على أيقونة الحقيبة أسفل يسار نافذة المخزون أثناء حمل عنصر قسيمة توسعة المخزون.\n\تزيد السعة بمقدار 10 عناصر في كل استخدام، ويمكن استخدامها 10 مرات إجمالا.\n?<TIPBOX>المخزون: العناصر<INFO>64</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		},
		PageEX = {
			{ EffectNum = 3, Twinkle = 1, StartX = 30, StartY = 200, DistX = 0, DistY = 0, MoveTime = 0 }
		}
	},
	[66] = {
		Title = "العناصر: مقارنة العناصر#نافذة المقارنة",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip00066",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"إذا نقرت بزر الفأرة الأيمن على عنصر من المعدات، فيمكنك مقارنة العنصر المجهز حاليا بالعنصر الذي نقرت عليه.\nعند المقارنة، ^3b488cلا تعرض معا إلا العناصر من النوع نفسه^000000، وذلك فقط عند ^3b488cتجهيز عنصر من نوع المعدات المحدد^000000.\nيمكن تشغيل هذه الميزة أو إيقافها ^3b488cON/OFF^000000 بالنقر على ^3b488cأيقونة العدسة المكبرة أسفل المخزون^000000.n?<TIPBOX>إعدادات التحكم<INFO>152</INFO></TIPBOX>\n?<TIPBOX>نافذة خيارات اللعبة<INFO>32</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[68] = {
		Title = "النقابة: الشعار",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip00068",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"يمكنك تعيين شعار مميز لكل نقابة من نافذة معلومات النقابة.\nلتسجيل شعار للنقابة، يجب إنشاء ^ff0000مجلد باسم emblem^000000 داخل المجلد المثبتة فيه ^ff0000راجناروك^000000، ثم وضع ^ff0000ملف صورة بامتداد bmp أو gif وبأبعاد 24X24 بكسل^000000 داخله. بعد ذلك، انقر على زر التعديل الموجود على يمين نافذة معلومات النقابة وحدد الصورة لتسجيلها.\nلإضافة جزء شفاف إلى صورة الشعار، املأ الجزء المطلوب جعله شفافا باللون الوردي ذي القيمة ^ff0000RGB 255, 0, 255^000000.\nتظهر قيم الألوان 255 و0 و255 باللون الوردي، لكنها تعرض داخل اللعبة على هيئة شفافية.\n\n^ff0000- تحذير: إذا استخدمت طبقة شفافة لإظهار الشفافية، فقد لا تعرض الصورة بصورة صحيحة. احرص على استخدام القيم 255, 0, 255 للشفافية.^000000\n\n?<TIPBOX>نظام النقابة<INFO>30</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[69] = {
		Title = "إعدادات المؤثرات: اسم الخريطة#الانتقال بين المناطق،إعدادات اللعبة",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip00069",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"يمكنك ضبط اسم الخريطة ليظهر على الشاشة أثناء تنقلك في الخريطة الرئيسية.\n(^ff0000حتى إذا كان خيار عرض اسم الخريطة مفعلا، فقد لا يظهر الاسم في بعض الخرائط.^000000)\nيمكن تشغيل عرض اسم الخريطة أو إيقافه من ^ff0000تشغيل/إيقاف^000000 داخل ^ff0000نافذة خيارات اللعبة (ESC) > إعدادات اللعبة > إعدادات المؤثرات^000000.\n\n?<TIPBOX>إعدادات المؤثرات<INFO>143</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
