		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip00026",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"عند إدخال /notalkmsg في نافذة الدردشة، لن يظهر محتوى المحادثات في النافذة، ويمكن تشغيل هذا الخيار أو إيقافه حسب رغبتك.\\nإذا أدخلت /notalkmsg2، فلن يظهر محتوى المحادثات، بما في ذلك محادثات النقابة، ويمكن أيضا تشغيل هذا الخيار أو إيقافه حسب رغبتك.\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
