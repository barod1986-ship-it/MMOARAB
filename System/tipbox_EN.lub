		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04012",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"قرية قبلية صغيرة تقع في الغابة شمال كومودو. تسكنها قبائل تعيش بعيدا عن الحضارة وتتمسك بأسلوب الحياة القديم. وتروى فيها قصة عن جذور إغدراسيل، شجرة العالم. لا يعرف سكانها اللغة الرسمية للقارة، لذا كن حذرا.\n?<NAVI>[منزل الزعيم]<INFO>umbala,68,251,0,101,0</INFO></NAVI>\n?<NAVI>[منزل الشامان]<INFO>umbala,219,188,0,101,0</INFO></NAVI>\n?<NAVI>[القفز بالحبل]<INFO>umbala,138,198,0,101,0</INFO></NAVI>\n?<NAVI>[نافورة هفيرغيلمير]<INFO>umbala,107,284,0,101,0</INFO></NAVI>\n\n?<TIPBOX>مملكة رون-ميدغارد<INFO>4004</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
