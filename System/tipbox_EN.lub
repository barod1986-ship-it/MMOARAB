		Page = {
			"يمكنك تعديل قائمة الماكرو باستخدام ALT+M. يرتبط كل ماكرو بمفتاح من ALT+1 إلى ALT+0.\n?<TIPBOX>خيارات اللعبة: BM/الاختصارات<INFO>41</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[43] = {
		Title = "مفتاح الاختصار: شريط المهارات",
		Search = 1,
		Image = "",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"بتسجيل المهارات أو العناصر كثيرة الاستخدام في شريط المهارات (F12)، يمكنك استخدامها بسهولة بالنقر المزدوج على الخانة بالفأرة أو بالضغط على مفتاح الاختصار.\\nيتوافق شريط المهارات الأول أساسا مع المفاتيح F1~F9، ويمكنك تغيير مفاتيح الاختصار المقابلة من إعدادات مفاتيح الاختصار في خيارات اللعبة. ولا يمكن استخدام مفاتيح اختصار أشرطة المهارات 2~4 إلا في وضع القتال.\\nيمكنك تحديد مهارة أو عنصر بالفأرة وسحبه إلى خانة في شريط المهارات.\n?<TIPBOX>خيارات اللعبة: مفاتيح الاختصار<INFO>41</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[44] = {
		Title = "مفتاح الاختصار: وضع القتال",
		Search = 1,
		Image = "",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"يقفل وضع القتال ميزة الدردشة لكي تتمكن من استخدام مفاتيح الاختصار المسجلة في شريط المهارات من لوحة المفاتيح. ويمكن تشغيله أو إيقافه باستخدام /bm.\\n^ff0000 في وضع القتال، تكون الدردشة مقفلة افتراضيا، لكن يمكنك الضغط على مفتاح Enter لتفعيل نافذة الدردشة.^000000\n?<TIPBOX>خيارات اللعبة: BM/الاختصارات<INFO>41</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[45] = {
		Title = "مفتاح الاختصار: F1~F12",
		Search = 1,
		Image = "",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"F1 ~ F9: يمكنك استخدام المهارات المسجلة في شريط المهارات.\\nF10: يمكنك ضبط حجم نافذة الدردشة.\\nF11: يغلق جميع النوافذ باستثناء نافذة المعلومات الأساسية ونافذة المحادثة.\\nF12: يمكنك فتح شريط المهارات وإغلاقه.\n?<TIPBOX>خيارات اللعبة: BM/الاختصارات<INFO>41</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[48] = {
		Title = "الحيوان الأليف: الترويض#الحيوانات الأليفة",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip00048",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"لترويض وحش، يجب تجهيز عنصر ترويض مناسب له.\nبعد جمع المعلومات وتجهيز عنصر الترويض الخاص بالوحش الذي تريد ترويضه، انقر نقرا مزدوجا على عنصر الترويض ثم حدد الوحش المستهدف.\nعند تحديد الوحش، تظهر آلة دوارة في منتصف الشاشة، ويمكنك النقر عليها لمعرفة نجاح الترويض أو فشله.\n\nعند نجاح الترويض، تظهر رسالة الحصول على بيضة الوحش مع عبارة النجاح، ويمكنك العثور على البيضة في نافذة المخزون.\n\n?<TIPBOX>نظام الحيوانات الأليفة<INFO>47</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[50] = {
		Title = "الحيوان الأليف: التفاعل#التفقيس،الإطعام،الاستعراض،الألفة،الجوع،الهروب،الحيوانات الأليفة",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip00050",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"إذا نقرت ^3b488cبزر الفأرة الأيمن^000000 على حيوانك الأليف بعد تفقيسه، فستظهر قائمة الحيوان الأليف.\n\nعرض حالة الحيوان الأليف: يمكنك التحقق من حالة حيوانك الأليف ومعلوماته.\nالإطعام: أطعم حيوانك الأليف.\nالاستعراض: ينفذ الحيوان الأليف استعراضه المميز.\nإزالة الزينة: يزيل عنصر الزينة الذي يرتديه الحيوان الأليف.\nإعادته إلى البيضة: يعيد الحيوان الأليف إلى حالته قبل التفقيس.\n\n?يمكن تغيير اسم الحيوانات الأليفة التي تم ترويضها بنجاح.\n?يؤدي إطعام الحيوان الأليف إلى تحسين ألفته معك.\nعندما ترتفع علاقة الألفة مع الحيوان الأليف، يمكن إضافة قدرات أخرى إلى جانب قدراته الأساسية.\nلكن إذا أفرطت في إطعام الحيوان الأليف أو تركته جائعا دون إطعام،\nأو إذا أصبح صاحبه عاجزا عن القتال، فسوف ^3b488cتنخفض الألفة. وإذا استمرت في الانخفاض، فقد يختفي الحيوان الأليف^000000، لذا اعتن دائما بحيوانك الأليف باهتمام ومودة.\n?يمكن إعادة الحيوان الأليف إلى حالة البيضة قبل التفقيس في أي وقت، ويمكن تفقيسه مجددا باستخدام عنصر \'حاضنة البيض المحمولة\'.\n\n?<TIPBOX>نظام الحيوانات الأليفة<INFO>47</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[52] = {
