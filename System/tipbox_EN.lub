		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"عثر في مكتبة رون-ميدغارد على كتاب قديم يحتوي على خريطة للطريق المؤدي إلى برازيليس. إنها أرض تضم غابة حارة كالصحراء وكثيفة كغابات بايون. ما رأيك في الانضمام إلينا في الرحلة إلى برازيليس؟ لقد أعيد فتح الطريق البحري إليها.\n\nيمكنك الانتقال إلى هناك من ألبرتا.\n?<NAVI>[إلى برازيليس]<INFO>alberta,246,82,0,101,0</INFO></NAVI>\n?<NAVI>[تلفريك الغابة]<INFO>brasilis,308,335,0,101,0</INFO></NAVI>\n?<NAVI>[متحف الفنون]<INFO>brasilis,137,167,0,101,0</INFO></NAVI>\n?<NAVI>[نصب فيراس]<INFO>brasilis,195,222,0,101,0</INFO></NAVI>\n\n?<TIPBOX>المناطق البعيدة<INFO>4003</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4024] = {
		Title = "المنطقة: أيوثايا",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04024",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"أيوثايا أرض يسكنها أناس يعيشون بانسجام مع الطبيعة ويتمسكون بمعتقدات عميقة تميز منطقتهم.\nوزينت جميع أنحاء أيوثايا بعناية بالذهب والزمرد وكأنها تعبر عن تقوى شعبها.\nمرحبا بك في أيوثايا، حيث المعابد والبيوت الخلابة المشيدة فوق الماء، وسوق الأسماك الذي تباع فيه البضائع على متن القوارب،\nوالمأكولات الشهية.\n\nيمكنك الانتقال إلى هناك من ألبرتا.\n?<NAVI>[إلى أيوثايا]<INFO>alberta,246,29,0,101,0</INFO></NAVI>\n?<NAVI>[المعبد]<INFO>ayothaya,208,280,0,101,0</INFO></NAVI>\n?<NAVI>[منطقة الصيد]<INFO>ayothaya,255,99,0,101,0</INFO></NAVI>\n?<NAVI>[الحانة]<INFO>ayothaya,229,72,0,101,0</INFO></NAVI>\n\n?<TIPBOX>المناطق البعيدة<INFO>4003</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4025] = {
		Title = "المنطقة: موسكوفيا",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04025",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"موسكوفيا أرض يمكنك أن تشعر فيها بأجواء غريبة ومختلفة.\nإن كنت مهتما بقصة الساحرة والتنين الشرير وأغنية الحوت، فاركب القارب المتجه إلى موسكوفيا الآن!\n\nيمكنك الانتقال إلى هناك من ألبرتا.\n?<NAVI>[إلى موسكوفيا]<INFO>alberta,246,51,0,101,0</INFO></NAVI>\n?<NAVI>[القصر الملكي]<INFO>moscovia,255,140,0,101,0</INFO></NAVI>\n?<NAVI>[المصلى]<INFO>moscovia,253,179,0,101,0</INFO></NAVI>\n\n?<TIPBOX>المناطق البعيدة<INFO>4003</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4026] = {
		Title = "المنطقة: ديواتا",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04026",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"\'ديواتا\'، جزيرة ذات شاطئ جميل متلألئ.\nيتبع سكان ديواتا وقبيلة جاتي ثقافتين متعارضتين، إحداهما حضارية والأخرى بعيدة عن الحضارة،\nلكنهم يعبدون الإله بارونغ ويحافظون على البيئة الطبيعية الجميلة بطريقتهم الخاصة.\n\nيمكنك الانتقال إلى هناك من ألبرتا.\n?<NAVI>[إلى ديواتا]<INFO>alberta,212,202,0,101,0</INFO></NAVI>\n?<NAVI>[بركان كراكاتوا]<INFO>dewata,235,56,0,101,0</INFO></NAVI>\n?<NAVI>[المطعم]<INFO>dewata,146,109,0,101,0</INFO></NAVI>\n\n?<TIPBOX>المناطق البعيدة<INFO>4003</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4027] = {
		Title = "المنطقة: لويانغ",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04027",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"حافظت لويانغ، ذات التاريخ العريق، على السلام مدة طويلة بفضل تعاون العشائر والمسؤولين تحت قيادة القائد الأعلى بايلونغ، الذي تصدى لغزو الوحوش العظيم. وخلال تلك الفترة، ساد رفض شديد للأجانب حفاظا على ثقافتهم، لكنهم بدأوا مؤخرا ولسبب ما في استقبال المغامرين الأجانب بصورة غير رسمية.\n\nتوجد منصات مراقبة داخل القرية وخارجها للاستمتاع بالمنظر الرائع لحصن لويانغ، كما يمكنك زيارة المقابر الملكية التي يرقد فيها الملوك.\n\nيمكنك الانتقال إلى هناك من ألبرتا.\n?<NAVI>[إلى لويانغ]<INFO>alberta,246,40,0,101,0</INFO></NAVI>\n?<NAVI>[ولي العهد]<INFO>louyang,217,244,0,101,0</INFO></NAVI>\n?<NAVI>[المقبرة الملكية]<INFO>louyang,42,276,0,101,0</INFO></NAVI>\n?<NAVI>[المستشفى]<INFO>louyang,258,94,0,101,0</INFO></NAVI>\n?<NAVI>[المرصد]<INFO>louyang,138,243,0,101,0</INFO></NAVI>\n\n?<TIPBOX>المناطق البعيدة<INFO>4003</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO> 1000</INFO></TIPBOX>"
		}
	},
	[4028] = {
		Title = "المنطقة: أماتسو",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04028",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"بعد أن اكتشفت قرية أماتسو الهادئة المليئة بأزهار الكرز وجود رون ميدغارد مصادفة، فتحت أخيرا طريقها البحري بعد خمس سنوات من الاستعداد الدقيق.\nيمكن رؤية السقف الأزرق الجميل لبرج قلعة هيميجي في الجانب الشرقي من البحيرة من أي مكان في البلدة المليئة بالفنون والثقافة وعبير أزهار الكرز.\nوقد تقودك زيارة أماتسو، البلدة الغامضة التي تتعايش فيها الآلهة والبشر، وتل شجرة الكرز الضخمة المرتبط بأساطير كثيرة، والمزار الواقع خارج البلدة والمكرس لمختلف الآلهة، إلى علاقة غامضة لا يعرفها أحد.\n\nيمكنك الانتقال إلى هناك من ألبرتا.\n?<NAVI>[إلى أماتسو]<INFO>alberta,246,74,0,101,0</INFO></NAVI>\n?<NAVI>[قلعة هيميجي]<INFO>amatsu,85,235,0,101,0</INFO></NAVI>\n?<NAVI>[تل أزهار الكرز]<INFO>amatsu,264,197,0,101,0</INFO></NAVI>\n?<NAVI>[المعبد]<INFO>ama_fild01,174,330,0,101,0</INFO></NAVI>\n\n?<TIPBOX>المناطق البعيدة<INFO>4003</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4029] = {
		Title = "المنطقة: كونلون",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04029",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"تمكن التجار في ألبرتا بعد جهد كبير من الوصول عبر الطريق البحري المكتشف إلى كونلون، جزيرة الآلهة.\nلم يرحب حكماء كونلون، الذين عاشوا معا في هدوء وتدربوا على قوى سحرية مجهولة، بتوافد الأجانب إلى الجزيرة، لكنهم لم يتمكنوا من منع المغامرين والتجار من ركوب السفن المتجهة إلى كونلون سعيا وراء المغامرات الجديدة والمال.\n\nيمكنك الانتقال إلى هناك من ألبرتا.\n?<NAVI>[إلى كونلون]<INFO>alberta,246,62,0,101,0</INFO></NAVI>\n?<NAVI>[مجسم برونتيرا]<INFO>gon_fild01,240,228,0,101,0</INFO></NAVI>\n?<NAVI>[مجسم كومودو]<INFO>gon_fild01,119,246,0,101,0</INFO></NAVI>\n?<NAVI>[مجسم غلاست هايم]<INFO>gon_fild01,175,339,0,101,0</INFO></NAVI>\n?<NAVI>[معبد الملكة الغربية]<INFO>gon_dun01,153,48,0,101,0</INFO></NAVI>\n\n?<TIPBOX>المناطق البعيدة<INFO>4003</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4030] = {
		Title = "المنطقة: روك ريدج",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04030",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"قرية أسسها أشخاص اجتمعوا لاستخراج \'الخام الأرجواني\' المكتشف في العالم الجديد. ويقيم الباحثون عن الثراء علاقة تعاونية مع سكان الكاكتوس الأصليين، لكن عصابة تعرف باسم اللصوص الصغار تهاجمهم باستمرار. هل يوجد مغامرون مستعدون لمساعدة الشريف في حل هذه المشكلة؟\n\nيمكنك الانتقال إلى هناك من ألبرتا.\n?<NAVI>[إلى روك ريدج]<INFO>alberta,240,103,0,101,0</INFO></NAVI>\n?<NAVI>[مكتب الشريف]<INFO>harboro1,241,218,0,000,0</INFO></NAVI>\n?<NAVI>[المتجر]<INFO>harboro1,312,193,0,000,0</INFO></NAVI>\n?<NAVI>[النزل]<INFO>harboro1,156,215,0,000,0</INFO></NAVI>\n\n?<TIPBOX>المناطق البعيدة<INFO>4003</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4031] = {
		Title = "جزيرة القطط الخالدة، مالانغدو",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04031",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"سميت الجزيرة مالانغدو لأن سطحها لين. كانت في الأصل جزيرة غير مأهولة، لكن سفينة قائد عملاء مخلب القط جنحت إليها أثناء ضياعها في البحر، فاستقر أفرادها في الجزيرة وأطلقوا عليها اسم مالانغدو.\nتعرف على المنتجات والخدمات المميزة لمالانغدو!\n\nيمكنك الانتقال إلى هناك من إزلود وألبرتا.\nإزلود\n?<NAVI>[إلى مالانغدو]<INFO>izlude,182,218,0,101,0</INFO></NAVI>\nألبرتا\n?<NAVI>[إلى مالانغدو] <INFO>alberta,200,151,0,101,0</INFO></NAVI>\n?<NAVI>[مكتب القبطان]<INFO>mal_in02,27,60,0,101,0</INFO></NAVI>\n?<NAVI>[غرفة الاجتماعات]<INFO>mal_in02,170,62,0,101,0</INFO></NAVI>\n\n?<TIPBOX>قارة ميدغارد<INFO>4001</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4040] = {
		Title = "جمهورية شفارتزفالد",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04040",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"دولة تقع شمال جبال ميولنير وعاصمتها يونو، مدينة الحكماء. تتبع نظاما جمهوريا يضم رئيسا وبرلمانا، وهي دولة ذات صناعة متطورة بفضل شركة ريكنبر الضخمة.\n\n?<TIPBOX>مدينة الحكماء، يونو<INFO>4041</INFO></TIPBOX>\n?<TIPBOX>بلدة المنتجعات، هويغل<INFO>4042</INFO></TIPBOX>\n?<TIPBOX>المدينة الصناعية، إينبروك<INFO>4043</INFO></TIPBOX>\n?<TIPBOX>قرية مناجم الفحم، إينبيك<INFO>4044</INFO></TIPBOX>\n?<TIPBOX>مدينة الشركات، لايت هالزن<INFO>4045</INFO></TIPBOX>\n\n?<TIPBOX>قارة ميدغارد<INFO>4001</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4041] = {
		Title = "مدينة الحكماء، يونو",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04041",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"هي عاصمة شفارتزفالد، وتعرف أيضا بمدينة الحكماء لوجود قلعة الحكماء وأكاديمية شويخربيل فيها. وتتكون من أربع جزر عائمة وتجذب كثيرا من الباحثين عن المعرفة.\n?<NAVI>[تاجر الأدوات]<INFO>yuno,194,140,0,000,0</INFO></NAVI>\n?<NAVI>[الحداد]<INFO>yuno,120,137,0,000,0</INFO></NAVI>\n?<NAVI>[منصة المنطاد]<INFO>yuno,53,210,0,000,0</INFO></NAVI>\n?<NAVI>[المبنى الحكومي]<INFO>yuno,157,317,0,000,0</INFO></NAVI>\n?<NAVI>[قلعة الحكماء]<INFO>yuno,90,318,0,000,0</INFO></NAVI>\n?<NAVI>[مكتبة يونو]<INFO>yuno,338,203,0,000,0</INFO></NAVI>\n?<NAVI>[أكاديمية شويخربيل للسحر]<INFO>yuno,323,280,0,000,0</INFO></NAVI>\n?<NAVI>[ورشة الظل]<INFO>yuno,275,67,0,101,0</INFO></NAVI>\n\n?<TIPBOX>جمهورية شفارتزفالد<INFO>4040</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4042] = {
		Title = "بلدة المنتجعات، هويغل#بحيرة الهاوية، معبد أودين",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04042",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"هويغل بلدة ريفية صغيرة وهادئة تقع في الجزء الشمالي من شفارتزفالد. ومع افتتاح الطريق الجوي الجديد، بدأ كثير من الناس يتوافدون إليها بحثا عن المغامرة والاسترخاء.\nاستمتع بتحديات المغامرة وهدوء الريف في هوغل، ذلك المكان الغامض الذي يضم أطلال معبد أودين القديمة وبحيرة الهاوية التي تنام فيها التنانين.\n?<NAVI>[نقابة الصيادين]<INFO>hugel,209,224,0,101,0</INFO></NAVI>\n?<NAVI>[تاجر الأسلحة]<INFO>hugel,88,167,0,101,0</INFO></NAVI>\n?<NAVI>[تاجر الأدوات]<INFO>hugel,92,163,0,101,0</INFO></NAVI>\n?<NAVI>[النزل]<INFO>hugel,101,77,0,101,0</INFO></NAVI>\n?<NAVI>[منصة المنطاد]<INFO>hugel,178,146,0,101,0</INFO></NAVI>\n?<NAVI>[قاعة القرية]<INFO>hugel,58,206,0,101,0</INFO></NAVI>\n?<NAVI>[الكنيسة]<INFO>hugel,159,113,0,101,0</INFO></NAVI>\n?<NAVI>[الحانة]<INFO>hugel,126,65,0,101,0</INFO></NAVI>\n?<NAVI>[مستلزمات المهرجان]<INFO>hugel,95,103,0,101,0</INFO></NAVI>\n\n?<TIPBOX>سباق وحوش هويغل<INFO>137</INFO></TIPBOX>\n\n?<TIPBOX>جمهورية شفارتزفالد<INFO>4040</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4043] = {
		Title = "المدينة الصناعية، إينبروك",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04043",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"مدينة صناعية تصطف فيها مصانع الآلات التي تعمل دون توقف، وربما لهذا السبب يملأها السخام الكثيف المنبعث من المصانع. وهي مدينة صناعية مخططة أنشئت لتشغيل المصانع عبر تكرير المعادن المستخرجة من إينبيك مباشرة.\n?<NAVI>[المطار]<INFO>einbroch,64,204,0,000,0</INFO></NAVI>\n?<NAVI>[المصنع]<INFO>einbroch,129,79,0,000,0</INFO></NAVI>\n?<NAVI>[الساحة]<INFO>einbroch,254,199,0,000,0</INFO></NAVI>\n?<NAVI>[فندق آينز إيسن]<INFO>einbroch,254,199,0,000,0</INFO></NAVI>\n?<NAVI>[محطة القطار]<INFO>einbroch,232,272,0,000,0</INFO></NAVI>\n?<NAVI>[تاجر الأسلحة]<INFO>einbroch,216,211,0,000,0</INFO></NAVI>\n?<NAVI>[المختبر]<INFO>einbroch,55,52,0,000,0</INFO></NAVI>\n?<NAVI>[البرج التذكاري]<INFO>einbroch,178,173,0,000,0</INFO></NAVI>\n\n?<TIPBOX>جمهورية شفارتزفالد<INFO>4040</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4044] = {
