	[4000] = {
		Title = "عالم راجناروك",
		Search = 1,
		Image = "",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"تدور المغامرات في عالم راجناروك أساسا في قارة ميدغارد، وهي أرض تتمحور حول البشر،\nوفي أرض تقع خلف الأبعاد وتعيش فيها الجنيات والعمالقة، وفي مناطق مجهولة اكتشفها المستكشفون.\n\n?<TIPBOX>قارة ميدغارد<INFO>4001</INFO></TIPBOX>\n?<TIPBOX>الأرض خلف الأبعاد<INFO>4002</INFO></TIPBOX>\n?<TIPBOX>المناطق البعيدة<INFO>4003</INFO></TIPBOX>\n\n?<TIPBOX>خريطة العالم<INFO>900</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4001] = {
		Title = "قارة ميدغارد",
		Search = 1,
		Image = "",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"ميدغارد هي مركز الحياة والقارة الرئيسية للبشر الذين نجوا\nبعد الحرب المقدسة التي قاتلت فيها الآلهة والشياطين والبشر من أجل معتقداتهم.\nتوجد ثلاث دول تشكل المحور الرئيسي على امتداد الساحل الجنوبي الشرقي لقارة ميدغارد.\n\n?<TIPBOX>مملكة رون-ميدغارد<INFO>4004</INFO></TIPBOX>\n?<TIPBOX>جمهورية شفارتزفالد<INFO>4040</INFO></TIPBOX>\n?<TIPBOX>مملكة أرونافيلتز<INFO>4050</INFO></TIPBOX>\n\n?<TIPBOX>مالانغدو<INFO>4031</INFO></TIPBOX>\n?<TIPBOX>لوتي<INFO>4014</INFO></TIPBOX>\n\n?^663399زنزانات منطقة ميدغارد^000000\n?<TIPBOX>الاختصارات<INFO>6151</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4002] = {
		Title = "الأرض خلف الأبعاد",
		Search = 1,
		Image = "",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"أنشأ سيد الشياطين الضعيف موروك صدعا هائلا في الأبعاد ليختبئ فيه. ويصل المغامرون الذين يقفزون داخل الصدع البعدي لتعقب موروك إلى عالم جديد. ويجب على البعثة، التي أطلقت على العالم المجهول اسم \'فراغ الرماد\'، تعقب آثار ملك الشياطين وكشف قصة هذه الأرض الغريبة.\nيمكن لـ ?<NAVI>[عميل مخلب القط]<INFO>moc_para01,44,19,0,101,0</INFO></NAVI> نقلك إليها.\n\n?<TIPBOX>الصدع البعدي<INFO>4021</INFO></TIPBOX>\n?<TIPBOX>معسكر بعثة الممالك الثلاث<INFO>4015</INFO></TIPBOX>\n?<TIPBOX>موقع لافين الأمامي، سبلينديد<INFO>4016</INFO></TIPBOX>\n?<TIPBOX>مدينة التعدين سافا، مانوك<INFO>4017</INFO></TIPBOX>\n?<TIPBOX>عاصمة سافا، إل ديكاستس<INFO>4018</INFO></TIPBOX>\n?<TIPBOX>عاصمة لافين، إكلاج<INFO>4019</INFO></TIPBOX>\n?<TIPBOX>استراحة المسافرين، قرية مورا<INFO>4020</INFO></TIPBOX>\n\n?<TIPBOX>عالم راجناروك<INFO>4000</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4003] = {
		Title = "المناطق البعيدة",
		Search = 1,
		Image = "",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"منطقة مجهولة اكتشفها بحار كان تائها في البحر ذات يوم. وبعد صدمتهم من اختلاف ثقافاتها، انطلق أهل ميدغارد، بمن فيهم أنت وأنا، في رحلة لاستكشافها.\n\n?<TIPBOX>المنطقة: لويانغ<INFO>4027</INFO></TIPBOX>\n?<TIPBOX>المنطقة: أماتسو<INFO>4028</INFO></TIPBOX>\n?<TIPBOX>المنطقة: كونلون<INFO>4029</INFO></TIPBOX>\n?<TIPBOX>المنطقة: ميناء مالايا<INFO>4022</INFO></TIPBOX>\n?<TIPBOX>المنطقة: برازيليس<INFO>4023</INFO></TIPBOX>\n?<TIPBOX>المنطقة: أيوثايا<INFO>4024</INFO></TIPBOX>\n?<TIPBOX>المنطقة: موسكوفيا<INFO>4025</INFO></TIPBOX>\n?<TIPBOX>المنطقة: ديواتا<INFO>4026</INFO></TIPBOX>\n?<TIPBOX>المنطقة: روك ريدج<INFO>4030</INFO></TIPBOX>\n\n?<TIPBOX>عالم راجناروك<INFO>4000</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4004] = {
		Title = "مملكة رون ميدغارد",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04004",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"دولة أسسها الأبطال الذين شاركوا في الحرب المقدسة.\nوهي مملكة تتمحور حول سبع عائلات ترث سلالات الأبطال، وتشمل المنطقة الجنوبية الممتدة من جبال ميولنير.\nواستعدادا لمواجهة الوحوش التي تهدد شعب المملكة، تشجع المملكة تدريب المغامرين وتدعمه.\n\n?<TIPBOX>العاصمة الملكية برونتيرا<INFO>4005</INFO></TIPBOX>\n?<TIPBOX>مدينة السحر غيفن<INFO>4006</INFO></TIPBOX>\n?<TIPBOX>مدينة الصحراء موروك<INFO>4007</INFO></TIPBOX>\n?<TIPBOX>مدينة الجبال بايون<INFO>4008</INFO></TIPBOX>\n?<TIPBOX>مدينة ألبرتا الساحلية<INFO>4009</INFO></TIPBOX>\n?<TIPBOX>مدينة ألديباران الحدودية<INFO>4010</INFO></TIPBOX>\n?<TIPBOX>مدينة المنتجعات كومودو<INFO>4011</INFO></TIPBOX>\n?<TIPBOX>قرية القبائل أومبالا<INFO>4012</INFO></TIPBOX>\n?<TIPBOX>المدينة التابعة إزلود<INFO>4013</INFO></TIPBOX>\n\n?<TIPBOX>قارة ميدغارد<INFO>4001</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4005] = {
