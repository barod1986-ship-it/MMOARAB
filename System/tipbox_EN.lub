		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"يمكنك فتح صندوق النصائح بالنقر على /tip أو Alt+D أو أيقونة صندوق النصائح.\\nيوفر صندوق النصائح معلومات مفيدة للعب.\\nللحصول على مزيد من المعلومات، أدخل كلمة البحث في ^3b488cنافذة البحث^000000.\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[2] = {
		Title = "المساعدة: قائمة الأوامر",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip00002",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"يمكنك عرض الأوامر المفيدة المستخدمة في راجناروك بكتابة /h.\\nيمكن استخدام الأوامر التي تبدأ بعلامة / عن طريق إدخالها في ^3b488cنافذة الدردشة^000000.\n\n?<TIPBOX>قائمة الأوامر<INFO>83</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
