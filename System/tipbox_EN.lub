	[71] = {
		Title = "الهومونكولوس#الجنين،أخلاقيات الأحياء،الإنشاء،ليف،أميستر،فيلير،فانيلميرث",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip00071",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"يمكن لفئات الخيميائي إنشاء هومونكولوس واستدعائه للمساعدة في القتال من خلال مهارة \'أخلاقيات الأحياء\'.\nالمتطلبات: المستوى 60 أو أعلى، وإكمال مهمة أخلاقيات الأحياء\nالتجهيزات: نظارات غريبة الأطوار، لحية الجد، 20x جيلوبي\nموقع بدء المهمة: ?<NAVI>[كيلاسوس]<INFO>lhz_in01,224,140,0,101,0</INFO></NAVI>\n\إذا تعلمت مهارة \'أخلاقيات الأحياء\'، فيمكنك صنع \'جنين\' باستخدام دليل صنع الجرعات ومهارة الصيدلة.\nالمواد: أنبوب زجاجي واحد، ندى إغدراسيل الصباحي واحد، بذرة حياة واحدة، وعاء دواء واحد\nكلما ارتفع مستوى مهارة الصيدلة ومستوى الخالق وخصائصه، زادت فرصة النجاح.\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
