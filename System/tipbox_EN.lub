	[29] = {
		Title = "نظام المجموعة",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip00029",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"يمكنك إنشاء مجموعة باستخدام /organize [اسم المجموعة].\\nويمكنك مغادرة المجموعة باستخدام /leave.",
			"إذا أنشأت مجموعة وأصبحت قائدها، فيمكنك النقر بزر الفأرة الأيمن على الشخصيات الأخرى واختيار قائمة 'دعوة إلى المجموعة'، أو دعوتها باستخدام /invite [اسم الشخصية].\\nإذا أردت طرد عضو من المجموعة، فيجب أن تكون ^000000قائد المجموعة^3b488c ثم تستخدم /expel [اسم الشخصية].\\n^ff0000لن يطلب منك تأكيد (Y/N)، لذا اختر بعناية.^000000\n?<TIPBOX>الدردشة: المجموعة<INFO>22</INFO></TIPBOX>\n?<TIPBOX>وكالة المغامرين<INFO>70</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[30] = {
		Title = "نظام النقابة#الحصار،إمبريوم",
		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip00030",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"يمكنك إنشاء نقابة باستخدام /guild [اسم النقابة]، لكن سيستهلك حجر إمبيريوم واحد.\nيمكنك عرض معلومات النقابة التي تنتمي إليها بالضغط على ALT+G.\n^ff0000يمكن لسيد النقابة حل النقابة. إذا أدخلت /breakguild [اسم النقابة] بعد مغادرة جميع الأعضاء باستثناء سيد النقابة، فسيتم حل النقابة.\n?لن يطلب منك تأكيد (Y/N)، لذا اختر بعناية.\nيمكن الحصول على 'إمبيريوم'، وهو المادة اللازمة لإنشاء النقابة، من الوحوش أو شراؤه من موظف مكتب النقابات.^000000\nإذا أقمت تحالفا مع نقابة أخرى، فيمكنكما القتال معا في WoE واستخدام دردشة التحالف.\n?<TIPBOX>الدردشة: النقابة<INFO>23</INFO></TIPBOX>\n?<TIPBOX>الدردشة: تحالف النقابات<INFO>134</INFO></TIPBOX>\n?<TIPBOX>النقابة: الرتبة<INFO>31</INFO></TIPBOX>\n?<TIPBOX>النقابة: الشعار<INFO>68</INFO></TIPBOX>\n\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[31] = {
