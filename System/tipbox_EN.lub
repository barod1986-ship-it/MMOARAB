		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04017",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"بلدة تعدين يستخرج فيها البراديوم ويكرر، وهو خام مهم لشعب سافا. ولأن التعدين يجري بالقرب من جذور شجرة العالم، يتهم بأنه سبب ضعف الشجرة، ولذلك يراقبه شعب لافين. وتشكل المعادن الملونة المنتشرة في الشوارع عديمة الألوان منظرا غريبا.\n?<NAVI>[عميل مخلب القط]<INFO>man_fild02,132,47,0,101,0</INFO></NAVI>\n?<NAVI>[إدارة العمليات]<INFO>manuk,306,142,0,101,0</INFO></NAVI>\n\n?<TIPBOX>الأرض خلف الأبعاد<INFO>4002</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
