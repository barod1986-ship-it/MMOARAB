		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04014",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"تقع في أقصى شمال جبال ميولنير بلدة صغيرة تصنع الألعاب وسط بيئة قاحلة يغطيها الجليد.\nيبدو أن شيئا ما أصاب مصنع الألعاب الصغير الذي يسعى إلى إسعاد الأطفال. استمع إلى قصص المغامرين الذين قدموا إلى ألديباران طلبا للمساعدة.\n?<NAVI>[مصنع الألعاب]<INFO>xmas,143,312,0,101,0</INFO></NAVI>\n?<NAVI>[منزل سانتا]<INFO>xmas,149,237,0,101,0</INFO></NAVI>\n?<NAVI>[الكنيسة]<INFO>xmas,104,287,0,101,0</INFO></NAVI>\n\n?<TIPBOX>قارة ميدغارد<INFO>4001</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4015] = {
