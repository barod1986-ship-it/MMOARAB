		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04007",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"مدينة صحراوية نشأت حول واحة. ويقال إن المنطقة المحيطة تحولت إلى صحراء بسبب تأثير موروك الذي كان مختوما في الماضي. وإلى جانب الثقافة المميزة للمدينة الصحراوية التي تطورت حول الواحة، توجد مبان غامضة شيدت في العصور القديمة وحصون دفاعية وأوكار للنمل تمثل أخطارا في الصحراء.\n?<NAVI>[نزل السراب - الفرع الأول]<INFO>morocc_in,141,138,0,101,0</INFO></NAVI>\n?<NAVI>[نزل السراب - الفرع الثاني]<INFO>morocc_in,82,94,0,101,0</INFO></NAVI>\n?<NAVI>[الحداد]<INFO>morocc_in,68,35,0,101,0</INFO></NAVI>\n?<NAVI>[نقابة اللصوص]<INFO>moc_prydb1,39,126,0,101,0</INFO></NAVI>\n?<NAVI>[نقابة المغتالين]<INFO>moc_fild16,206,290,0,101,0</INFO></NAVI>\n?<NAVI>[الهرم]<INFO>moc_ruins,64,162,0,101,0</INFO></NAVI>\n?<NAVI>[أبو الهول]<INFO>moc_fild19,105,100,0,101,0</INFO></NAVI>\n?<NAVI>[حصن دارمين]<INFO>cmd_fild08,98,129,0,101,0</INFO></NAVI>\n?<NAVI>[جحيم النمل]<INFO>cmd_fild08,326,351,0,101,0</INFO></NAVI>\n\n?<TIPBOX>مملكة رون-ميدغارد<INFO>4004</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
