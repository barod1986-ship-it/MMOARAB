		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04022",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"ميناء مالايا، حيث تتعايش الأساطير والخرافات مع الحضارة.\nيبدو أن السكان الذين لا يفتحون قلوبهم بسهولة للغرباء يخفون ظروفا لا يستطيعون البوح بها. اكسب ثقة السكان واستمع إلى قصصهم.\n\nيمكنك الانتقال إلى هناك من ألبرتا.\n?<NAVI>[إلى ميناء مالايا]<INFO>alberta,196,202,0,101,0</INFO></NAVI>\n?<NAVI>[المستشفى]<INFO>malaya,50,75,0,101,0</INFO></NAVI>\n?<NAVI>[المنتزه]<INFO>malaya,280,329,0,101,0</INFO></NAVI>\n?<NAVI>[الميناء]<INFO>malaya,276,55,0,101,0</INFO></NAVI>\n?<NAVI>[باريو ماهيواغا]<INFO>ma_fild01,250,213,0,101,0</INFO></NAVI>\n\n?<TIPBOX>المناطق البعيدة<INFO>4003</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
