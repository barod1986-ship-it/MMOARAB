		Search = 1,
		Image = "\192\175\192\250\192\206\197\205\198\228\192\204\189\186\\tipbox\\tip04044",
		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"بلدة صغيرة لتعدين الفحم أسسها أشخاص توافدوا لتطوير المناجم. وتنقل المعادن المستخرجة منها إلى مصانع إينبروك بواسطة قطار الشحن.\n?<NAVI>[الحانة]<INFO>einbech,157,106,0,000,0</INFO></NAVI>\n?<NAVI>[محطة القطار]<INFO>einbech,39,215,0,000,0</INFO></NAVI>\n?<NAVI>[تاجر الأدوات]<INFO>einbech,177,133,0,000,0</INFO></NAVI>\n?<NAVI>[المنجم]<INFO>einbech,137,248,0,000,0</INFO></NAVI>\n\n?<TIPBOX>جمهورية شفارتزفالد<INFO>4040</INFO></TIPBOX>\n?<TIPBOX>عرض قائمة النصائح<INFO>1000</INFO></TIPBOX>"
		}
	},
	[4045] = {
