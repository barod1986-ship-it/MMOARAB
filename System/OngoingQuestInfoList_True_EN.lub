		},
		Summary = ""
	},
	[7628] = {
		Title = "مصدر طاقة جديد",
		Description = {
			"كلفت بجمع الطاقات المكثفة لأبحاث لويد. تحتاج إلى 10 زجاجات فارغة."
		},
		Summary = "10 طاقات مكثفة"
	},
	[7629] = {
		Title = "طاقة الغد في الغد",
		Description = {
			"عد إلى لويد غدا لمواصلة مساعدته في أبحاثه."
		},
		Summary = "انتظار المهمة اليومية",
	},
	[7630] = {
		Title = "وحيد القرن الأزرق الأسطوري",
		Description = {
			"تقول الشائعات إن مهرا أزرق هائجا ظهر في الغابة قرب بايون! ساعد في اكتشاف حقيقة هذا الحيوان!"
