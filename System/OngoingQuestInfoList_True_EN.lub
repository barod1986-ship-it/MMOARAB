	[7100] = {
		Title = "رسالة بيركاسيل",
		Description = {
			"قد لا يكون شيئا مهما، لكننا سنقدم لك معدات كانت تابعة للنقابة. لا تنس استلامها لاحقا... لكنني لا أعرف متى ستكون جاهزة. سأعطيك إياها، فلا تنس."
