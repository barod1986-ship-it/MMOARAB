		},
		Summary = ""
	},
	[16139] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"واجه كيل هاير لمعرفة حقيقة كيهل وعلاقته بشركة ريكنبر."
		},
		Summary = ""
	},
	[16140] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"أعطاك كيل هاير جهاز طاقة سيضعف كيهل. تحدث مع كيل هاير عندما تصبح مستعدا للانتقال إلى غرفة كيهل."
