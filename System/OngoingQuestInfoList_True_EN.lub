	[14118] = {
		Title = "قلق وهاري",
		Description = {
			"يشعر وهاري بالقلق على شقيقه الموجود في السجن. اعثر على طريقة لدخول السجن وسلم رسالة وهاري الصادقة إلى شقيقه المسجون."
		},
		Summary = ""
	},
	[14119] = {
		Title = "اختبار الصبر",
		Description = {
			"لا يستجيب السجين عند التحدث إليه. يبدو أنه يختبر صبري."
		},
		Summary = "التحدث مع السجين"
	},
	[14120] = {
		Title = "اختبار الصبر 2",
		Description = {
			"ما زال السجين لا يستجيب رغم التحدث إليه مرات عديدة. حاول مجددا."
		},
		Summary = "التحدث مع السجين"
	},
	[14121] = {
		Title = "اختبار الصبر 3",
		Description = {
			"يبدو أن هذا الرجل مصمم على التزام الصمت مهما حدث. هل توجد طريقة أخرى؟"
		},
		Summary = "التحدث مع السجين"
	},
	[14122] = {
		Title = "وقت خاص بين شقيقين",
		Description = {
			"سلمت رسالة وهاري إلى وهورو. طلب بعض الوقت لقراءتها، فلا تزعجه أثناء ذلك."
		},
		Summary = "امنحه وقتا لقراءة الرسالة"
	},
	[14123] = {
		Title = "طلب وهورو",
		Description = {
			"بعد قراءة رسالة شقيقه، بدأ وهورو يروي قصته بالتفصيل وطلب منك نقل تحياته إلى شقيقه. عد إلى وهاري وأبلغه بتحيات وهورو."
		},
		Summary = "نقل تحيات وهورو إلى وهاري"
	},
	[14124] = {
		Title = "الطلب الأول",
		Description = {
			"سرق حيوان جايد الليلة الماضية. حقق في الأمر وأبلغ بما حدث."
		},
		Summary = "منزل جايد"
	},
	[14125] = {
		Title = "التحقيق في المنطقة",
		Description = {
			"يبحث وهاري عن طريقة لاستعادة جسد وهورو، لكنه لا يعرف كيف. ربما يعرف سكان المناطق المجاورة شيئا. حقق في المنطقة المحيطة."
		},
		Summary = "تحدث مع سكان البلدة"
	},
	[14126] = {
		Title = "البحث عن السيدة غوتي",
		Description = {
			"قال السيد ماسيوني إنه لا يعرف الكثير، لكنه أشار إلى السيدة غوتي التي تتمتع بحدس أقوى في هذه الأمور..."
		},
		Summary = "ابحث عن السيدة غوتي"
	},
	[14127] = {
		Title = "البحث عن زوج السيدة غوتي",
		Description = {
			"قالت السيدة غوتي إن وهورو كان سعيدا جدا وهو يلوح بورقة في الهواء. وعندما سألتها عنها، قالت إن زوجها قد يعرف المزيد."
		},
		Summary = "ابحث عن زوج السيدة غوتي"
	},
	[14128] = {
		Title = "الحصول على تقرير البحث",
		Description = {
			"كان السيد سفيري المقرب دائما من وهورو يعرف شيئا إضافيا. كان تقرير البحث داخل الرسالة التي تركها وهورو قبل اقتياده إلى السجن. خذه إلى وهاري."
		},
		Summary = "تسليم التقرير"
	},
	[14131] = {
		Title = "وقت التحليل",
		Description = {
			"تسلم وهاري التقرير، لكنه قال إن تحليله سيستغرق بعض الوقت. تحدث معه لاحقا، ولا تزعج شخصا أثناء دراسته."
		},
		Summary = "وقت التحليل"
	},
	[14132] = {
		Title = "بحثنا",
		Description = {
			"بعد العثور على الحيوان، علينا أولا التحقيق فيما يحدث."
		},
		Summary = "بحثنا"
	},
	[14133] = {
		Title = "طلب آخر",
		Description = {
			"حلل وهاري تقرير البحث، لكنه لا يزال غير متأكد من طريقة استعادة جسد شقيقه. ابحث عن فرد لافين الذي طلب في الأصل مشاركة وهورو في البحث واسأله."
		},
		Summary = "الحصول على الدليل"
	},
	[14134] = {
		Title = "السيدة غوتي الحادة الذكاء",
		Description = {
			"زرت السيد سفيري للحصول على مزيد من المعلومات، لكنه قال إنه لا يعرف شيئا عن فرد لافين رفيع المستوى. واقترح زيارة زوجته التي تتمتع بحدس قوي في هذه الأمور."
