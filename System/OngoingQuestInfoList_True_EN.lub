	},
	[7185] = {
		Title = "المفتش دوها",
		Description = {
			"قبل المغادرة إلى العاصمة، طلب منك القبطان هيبا أجيب مقابلة المفتش دوها. لا تعرف سبب ذلك، لكن عليك مقابلته قبل التوجه إلى مانوك. يوجد دوها في الغرفة المجاورة لغرفة فيهانوس."
		},
		Summary = "قابل المفتش دوها"
	},
	[7186] = {
		Title = "أمر دوها السري - التحقيق",
		Description = {
			"يقول دوها إنه يبحث عن المشتبه به في قضية سرقة التقرير. أمرك سرا بجمع المعلومات أثناء وجودك في إل ديكاستس، وشرح لك مظهر المشتبه به. إنه رجل ذو أذني حيوان."
