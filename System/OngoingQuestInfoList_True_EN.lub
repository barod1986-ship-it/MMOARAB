	[5727] = {
		Title = "تكليف مفاجئ",
		Description = {
			"ظهر <NAVI>برونو<INFO>rebel_in,82,68,0,101,0</INFO></NAVI> فجأة ويريد العمل معك. قال إنه سيكون مستعدا بالكامل بعد الساعة 4:00 من صباح الغد، لذا قابله بعد ذلك الوقت."
		},
		Summary = ""
	},
	[5728] = {
		Title = "صداع",
		Description = {
			"أصيب فيرو بصداع لأنه لم يستخدم عقله منذ مدة. لنأخذ استراحة أولا."
		},
		Summary = ""
	},
	[5729] = {
		Title = "إلى إينبيخ",
		Description = {
			"اذهب إلى <NAVI>نهاية قطار الشحن<INFO>einbech,212,212,0,101,0</INFO></NAVI> واحصل على ^C33120عنصر يحمل خاصية النار^000000."
		},
		Summary = ""
	},
	[5730] = {
		Title = "أشياء يمكنها تدمير الجهاز",
		Description = {
			"يبدو أننا نحتاج إلى عناصر قوية بخاصية الماء لتدمير الجهاز. لا أظن أن عنصرا أو عنصرين سيكفيان، ربما نحتاج إلى 3؟"
		},
		Summary = ""
	},
	[5731] = {
		Title = "كلاناا نامييري",
		Description = {
			"تم تدمير الجهاز الموجود في إينبيخ. عد إلى <NAVI>كلاناا نامييري<INFO>einbech,215,81,0,101,0</INFO></NAVI>."
		},
		Summary = ""
	},
	[5732] = {
		Title = "إلى لايت هالزن",
		Description = {
			"وفقا للمعلومات التي حصلنا عليها من المخبر، علينا جمع 3 من الصقيع الغامض و3 من الريح الهوجاء، ثم الذهاب إلى <NAVI>المكان المحاط بالماء<INFO>lighthalzen,137,231,0,101,0</INFO></NAVI> قرب قصر لايت هالزن لإعدادها."
		},
		Summary = ""
	},
	[5733] = {
		Title = "كلاناا نامييري",
		Description = {
