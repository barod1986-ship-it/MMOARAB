		Summary = "الاستماع إلى قصة السيد بومبي"
	},
	[14136] = {
		Title = "مشهد مروع في الحقل",
		Description = {
			"يخشى السيد بومبي الخروج إلى الحقل. قال إن جثة ضخمة ملقاة هناك منذ أن مات أحد أفراد لافين رفيعي المستوى ميتة مروعة. حقق في الحقل."
