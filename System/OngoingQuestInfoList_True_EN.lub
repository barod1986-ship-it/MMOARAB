		IconName = "ico_ep.bmp",
		Description = {
			"في موقع لافين المسمى \"سبلينديد\"، قابلت لافين يدعى \"آرك\" وطلب منك العثور على صديقته \"تيرا\". يقول إن تيرا تترك آثارا عادة بربط النباتات على شكل عقد."
		},
		Summary = "اعثر على آثار تيرا"
	},
	[7057] = {
		Title = "الرسول - طلب آرك",
		IconName = "ico_ep.bmp",
		Description = {
