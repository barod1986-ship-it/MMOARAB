	},
	[8244] = {
		Title = "الجنيات وعمالقة الأشجار",
		Description = {
			"اعثر على عينات من اللغات التي تتحدث بها الجنيات وعمالقة الأشجار، ثم أخبر عالم اللغات بما يقولونه بالضبط."
