		Summary = "قابل بويا واحصل على البراديوم المنقى"
	},
	[11174] = {
		Title = "نقص المؤن",
		Description = {
			"يستغرق تنقية قطعة براديوم كبيرة وقتا طويلا، لكن تنقية القطع الصغيرة أسرع. يمكنك جمع قطع البراديوم بسهولة من الوحوش القريبة. تكفي نحو 30 قطعة لتوزيعها على 6 أشخاص."
		},
		Summary = "لا يوجد براديوم كاف. اجمع 30 قطعة براديوم صغيرة"
	},
	[11175] = {
		Title = "نقص المؤن",
		Description = {
