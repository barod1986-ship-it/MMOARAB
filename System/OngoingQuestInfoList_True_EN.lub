	[11057] = {
		Title = "الدواء العشبي - مساعدة الطبيبة",
		Description = {
			"اجمع... ^3355FFمخلبي فهد^000000 و^3355FF‏10 حبات خوخ صلبة^000000 و^3355FF‏5 جلود ضفدع سام^000000 و^3355FF‏20 جذرا بنيا^000000 و^3355FF‏10 براعم^000000 و^3355FF‏5 أوعية عسل^000000."
