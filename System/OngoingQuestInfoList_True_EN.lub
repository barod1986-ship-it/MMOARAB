		Description = {
			"للحصول على كتل روث الجمل، عليك أولا إطعام الجمل علفا يحفز شهيته. احصل على الطعام المنشط للشهية!"
		},
		Summary = "5 علف وحوش وتفاحة غير ناضجة واحدة وجرعة صفراء واحدة وزجاجة فارغة واحدة"
	},
	[3068] = {
