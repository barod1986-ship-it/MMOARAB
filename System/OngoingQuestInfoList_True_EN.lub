		Summary = "تحدث مع جاك"
	},
	[11522] = {
		Title = "رياح تهب من التل الأسود",
		IconName = "ico_ev.bmp",
		Description = {
			"قال جاك إنه سيواصل انتظار نياونغي الخاصة به، وطلب منك رعاية القطط الجديدة. اجمع ^ff000010 سيقان بيضاء جافة^000000 وساعد سكاتليتون في وادي غيول."
		},
		Summary = "إلى وادي غيول"
	},
	[11523] = {
