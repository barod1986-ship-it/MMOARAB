		Summary = "انتظار المهمة اليومية",
	},
	[7615] = {
		Title = "جمع النوى",
		IconName = "ico_dq.bmp",
		Description = {
			"اجمع 20 جهاز تحكم بالطاقة من الروبوتات. قد تكون مفتاح فهم هذه الحضارة المتقدمة للغاية."
