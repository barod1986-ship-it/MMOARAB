	[12141] = {
		Title = "حزمة خاصة",
		Description = {
			"لدي طلب شخصي. سمعت عن مصنوعات يدوية مستديرة وشفافة في ميدغارد.",
			"أظن أنها تسمى الخرز الزجاجي. لدينا منتجات مشابهة هنا، لكنها لا تقارن بدقة تلك الكرات. أحضر لي 10 منها.",
