	},
	[12001] = {
		Title = "ديغوتز، صديق ماكو القديم",
		Description = {
			"تحدثت مع ديغوتز، صديق ماكو منذ الطفولة. عد إلى ماكو وتحدث معه."
		},
		Summary = "ماكو"
	},
	[12002] = {
		Title = "رسول الصداقة",
		Description = {
			"كن رسولا بين ماكو وديغوتز للمساعدة في استعادة صداقتهما القديمة."
		},
		Summary = "تنقل بينهما لتسليم الرسائل"
	},
	[12003] = {
		Title = "رسالة ديغوتز",
		Description = {
			"أوصل رسالة ديغوتز إلى ماكو \"- أيها الوغد عديم الأمل! - ما زلت أحمق عنيدا! - أنت مدين لي بثلاث وجبات غداء على الأقل! - ناهيك عن اعتذار! - ومن يهتم بما تظنه؟! - أنا سعيد جدا من دونك!\""
		},
		Summary = "ماكو"
	},
	[12004] = {
		Title = "صديق ماكو الآخر",
		Description = {
			"بعد أن هدأ، قال ماكو إن صديقه بنكايستين كان يحرص دائما على إبعاده عن الشجارات. ربما يعرف ديغوتز هذا الشخص أيضا..."
