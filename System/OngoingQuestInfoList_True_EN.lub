		Summary = "راجع مينوئيل بعد مرور بعض الوقت"
	},
	[7430] = {
		Title = "ساعي البريد العابر للفضاء",
		Description = {
			"سلمت رسائل سبلينديد نيابة عن روي، الذي ما زال يواجه مشكلة عند أطراف بيفروست."
