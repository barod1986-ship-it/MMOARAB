		Summary = ""
	},
	[7187] = {
		Title = "أمر دوها السري - شاي",
		Description = {
			"شاي هو مدير \"بورمان فلون\"، حانة إل ديكاستس. اقترح عليك جمع معلومات عن \"الرجل ذي أذني الحيوان\" من أفراد سافا الذين يعيشون في العاصمة."
