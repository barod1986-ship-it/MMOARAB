	[3050] = {
		Title = "بعث ساتان موروك - 1",
		Description = {
			"\"بعث ساتان موروك وهرب من قرية موروك، وانتقل الآن إلى صحراء سوغرات. إن كنت تعد نفسك مغامرا شجاعا، فابحث عن القائد بالروغ من حرس القارة في قرية موروك.\""
		},
		Summary = "القائد بالروغ"
	},
	[3051] = {
		Title = "بعث ساتان موروك - 2",
		Description = {
			"\"سمعت أن وحوش دهليز الحمم تحمل نيرانا لا تنطفئ، وقد تحل مشكلة نيران معسكرنا. أريد منك جمع تلك النيران لنا.\" - القائد بالروغ"
		},
		Summary = "30 جمرة حية"
	},
	[3052] = {
		Title = "بعث ساتان موروك - 3",
		Description = {
			"\"تذكرت أن وحوش كهف الجليد في الشمال تحمل قلوبا جليدية. قد تساعد تلك القلوب الجنود على تحمل الحرارة.\" - القائد بالروغ"
		},
		Summary = "50 قلبا جليديا"
	},
	[3053] = {
		Title = "بعث ساتان موروك - 4",
		Description = {
			"\"أعترف بأن مهاراتك وشجاعتك أبهرتاني. مرحبا بك في حرس القارة يا صديقي. هل أنت مستعد للمخاطرة بحياتك من أجل السلام في العالم؟\" - القائد بالروغ"
		},
		Summary = "امنع ساتان موروك من استعادة قوته الحقيقية بالكامل"
	},
	[3054] = {
		Title = "بعث ساتان موروك - 5",
		Description = {
			"طرد ساتان موروك أخيرا من رون ميدغارد واختفى عبر الصدع البعدي. يمكنك رؤية الشظايا تطفو داخل الصدع."
		},
		Summary = ""
	},
	[3055] = {
		Title = "بعث ساتان موروك - 6",
		Description = {
			"مددت يدك والتقطت شظية باهتة. إنها قطعة من جلد ساتان موروك، وستكون الدليل الحاسم على هزيمته."
		},
		Summary = ""
	},
	[3056] = {
		Title = "بعث ساتان موروك - 7",
		Description = {
			"\"تهانينا أيها الجندي. لقد أنقذت العالم وسكانه من الدمار والشر. لدي ثلاثة عناصر، فأيها تريد الحصول عليه؟\""
		},
		Summary = "اختر مكافأتك"
	},
	[3060] = {
		Title = "طفلا فينس - أين الأخت الصغيرة؟",
		Description = {
			"فقد فتى يدعى كارين أخته الصغيرة عندما ذهبا إلى بركان ثور في فينز. عليك مساعدته في العثور على أخته كوردي."
