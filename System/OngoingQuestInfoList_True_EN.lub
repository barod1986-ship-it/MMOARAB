		IconName = "ico_ev.bmp",
		Description = {
			"قيل إن وسط وادي غيول مليء بالقطط. اذهب إلى وسط الوادي وابحث عن نياونغي."
		},
		Summary = "البحث عن نياونغي"
	},
	[11518] = {
		Title = "رياح تهب من التل الأسود",
		IconName = "ico_ev.bmp",
		Description = {
			"وجدت كثيرا من سكاتليتون في وسط وادي غيول، لكن حالتها لا تبدو جيدة. اجمع ^ff00005 قطع من الفرو الأسود^000000 لتدفئتها. يمكنك الحصول عليه من جاك الهارب، ودولاهان، ولولي روري، ولولي روري السريعة، ولود، وبلودي ميردرر، وجيبيت، وهايلوزويست في المنطقة."
		},
		Summary = "5 قطع من الفرو الأسود"
	},
	[11519] = {
		Title = "رياح تهب من التل الأسود",
		IconName = "ico_ev.bmp",
		Description = {
			"أصبح سكاتليتون منفعلا جدا ولا يبدو أنه قادر على مواصلة الحديث. عد إلى جاك."
		},
		Summary = "تحدث مع جاك"
	},
	[11520] = {
		Title = "رياح تهب من التل الأسود",
		IconName = "ico_ev.bmp",
		Description = {
			"يقول جاك إنه يريد نياونغي الخاصة به، لا قطة أخرى. تحدث مجددا مع كاتليتون المعلم."
