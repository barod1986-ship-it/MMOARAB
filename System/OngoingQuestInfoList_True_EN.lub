		Title = "عين هليون",
		Description = {
			"عثرت على كتابة في سقف المعبد تقول: \"هذا الثوب بمقاس واحد يناسب الجميع.\" أخبر غروث بالرسالة."
		},
		Summary = ""
	},
	[19114] = {
		Title = "عين هليون",
		Description = {
			"عثرت على كومة حجارة مكتوب عليها: \"كنت أصلي هنا من أجل أيام يسودها السلام.\" أخبر غروث بالرسالة."
		},
		Summary = ""
	},
	[19115] = {
		Title = "عين هليون",
		Description = {
			"عثرت على سمك مجفف ورسالة تقول: \"الأعشاب الخضراء مفيدة جدا لإزالة رائحة السمك.\" أخبر غروث بالرسالة."
		},
		Summary = ""
	},
	[19116] = {
		Title = "عين هليون",
		Description = {
			"عثرت على وعاء يحمل رسالة: \"ماذا سيكون؟ نبيذا أم عصير عنب؟ لكنني أفضل النبيذ كثيرا.\" أخبر غروث بالرسالة."
		},
		Summary = ""
	},
	[19117] = {
		Title = "عين هليون",
		Description = {
			"عثرت على رسالة من تايوس. عد إلى غروث وأخبره بما وجدته تحت الأرضية الخشبية."
		},
		Summary = ""
	},
	[19118] = {
		Title = "عين هليون",
		Description = {
			"أخبرت غروث بما كان مكتوبا على اللوح تحت الأرضية الخشبية. طلب منك تفقد التمثال الحجري الضخم في قرية الرماة شمالا."
		},
		Summary = ""
	},
	[19119] = {
		Title = "عين هليون",
		Description = {
			"حصلت على لوح بايون من تمثال بوذا. أعده إلى تشيلياس تايوس في موروك."
		},
		Summary = ""
	},
	[19120] = {
		Title = "عين هليون",
		Description = {
			"حصلت على لوح موروك. طلب منك تشيلياس تايوس السفر إلى غيفن والعثور على رجل يدعى ويلشيون."
		},
		Summary = ""
	},
	[19121] = {
		Title = "عين هليون",
		Description = {
			"طلب منك ويلشيون العثور على تلميذه إينوز في برج غيفن. تأكد من أن بحوزته التقرير المسمى \"حياة الوحوش في منطقة غيفن\"."
		},
		Summary = ""
	},
	[19122] = {
		Title = "عين هليون",
		Description = {
			"ربما لم تكن إهانته فكرة جيدة. حاول الاعتذار لويلشيون."
		},
		Summary = ""
	},
	[19123] = {
		Title = "عين هليون",
		Description = {
			"قال ويلشيون إنه عطشان. أحضر له جرعة لترى إن كان بإمكانك إرواء عطشه."
		},
		Summary = ""
	},
	[19124] = {
		Title = "عين هليون",
		Description = {
			"يبدو أن إينوز أضاع كتاب حياة الوحوش. عد إلى ويلشيون وأخبره."
		},
		Summary = ""
	},
	[19125] = {
		Title = "عين هليون",
		Description = {
			"طلب منك ويلشيون توصيل الكتاب إلى إينوز في برج غيفن، وإحضار جوهرة زرقاء واحدة عند عودتك."
		},
		Summary = ""
	},
	[19126] = {
		Title = "عين هليون",
		Description = {
			"عد إلى ويلشيون ولا تنس إحضار جوهرة زرقاء واحدة. إن سألك سؤالا غريبا، فأجبه: \"فالاسكيالف\"."
		},
		Summary = ""
	},
	[19127] = {
		Title = "عين هليون",
		Description = {
			"حصلت على لوح غيفن. أعد جميع الألواح إلى السير تشيلياس تايوس في موروك."
		},
		Summary = ""
	},
	[19128] = {
		Title = "عين هليون",
		Description = {
			"قال تشيلياس تايوس إن ويلشيون هو الشخص الوحيد القادر على دمج قطع اللوح وإعادته إلى شكله الكامل."
		},
		Summary = ""
	},
	[19129] = {
		Title = "عين هليون",
		Description = {
			"أصبح اللوح المكتمل بحوزتك. خذه إلى تشيلياس تايوس ليعرف أن المهمة اكتملت."
		},
		Summary = ""
	},
	[19200] = {
		Title = "حجر وورق ومقص مع تروي",
		Description = {
			"لا يمكنك تحدي تروي إلا بعد انتهاء المؤقت."
		},
		Summary = ""
	},
	[21001] = {
		Title = "الهروب من السفينة المحطمة",
		IconName = "ico_gq.bmp",
		Description = {
			"يجب أن تهرب من السفينة التي تحطمت على جزيرة مهجورة بعد العاصفة. ابحث عن المصابين الذين ما زالوا على متنها."
		},
		Summary = "التحدث مع القبطان"
	},
	[21002] = {
		Title = "المعركة الأولى",
		Description = {
			"اعثر على مواد إصلاح السفينة التي سرقها بورينغ. طلب منك أحد أفراد الطاقم استعادة قطعتين من <ITEM>خشب<INFO>6008</INFO></ITEM>. اهزم بورينغ واستعد الخشب."
		},
		Summary = "تسليم قطعتين من الخشب إلى فرد الطاقم"
	},
	[21003] = {
		Title = "أفضل دواء لدوار البحر",
		Description = {
			"قررت مساعدة رينو، الصديق الذي قابلته أثناء السفر، بالعثور على شيء يخفف دوار البحر لديه. اسأل ^0000FFالمعالج عن الدواء العشبي^000000 في ^0000FFعيادة أكاديمية كرياتورا^000000."
		},
		Summary = "سؤال المعالج عن الدواء العشبي"
	},
	[21004] = {
		Title = "أساسيات طب الأعشاب",
		Description = {
			"طلب منك المعالج العثور على العشبة الحمراء، وهي أحد مكونات الجرعة. اعثر على ^0000FFنبتة حمراء^000000 أمام ^0000FFمدخل أكاديمية كرياتورا^000000."
		},
		Summary = "العثور على نبتة حمراء خارج أكاديمية كرياتورا"
	},
	[21005] = {
		Title = "حفظ الموقع!",
		Description = {
			"من الجيد أنني حصلت عليه."
		},
		Summary = ""
	},
	[21006] = {
		Title = "أخبار جيدة لرينو",
		Description = {
			"سأعطي رينو ما حصلت عليه من المعالج."
		},
		Summary = "التحدث مع رينو"
	},
	[21007] = {
		Title = "صديقي الأول",
		Description = {
			"عثرت على صديق جيد."
		},
		Summary = ""
	},
	[21008] = {
		Title = "المعركة الأولى",
		IconName = "ico_gq.bmp",
		Description = {
			"اعثر على مواد إصلاح السفينة التي سرقها بورينغ. طلب منك أحد أفراد الطاقم استعادة قطعتين من <ITEM>خشب<INFO>6008</INFO></ITEM>. اهزم بورينغ واستعد الخشب."
		},
		Summary = "تسليم قطعتين من الخشب إلى فرد الطاقم"
	},
	[21009] = {
		Title = "نداء سبراكي",
		Description = {
			"وصل نداء من النقابة بشأن مهمة لمجموعة إيدن. قابل <NAVI>سبراكي<INFO>iz_ac01,102,44,0,101,0</INFO></NAVI> في أكاديمية كرياتورا شمال إزلود."
		},
		Summary = "التحدث مع سبراكي"
	},
	[21011] = {
		Title = "شراب الدلو",
		Description = {
			"طلب منك رجل مسن في بايون سحب الشراب الذي تركه داخل البئر. حاول سحب الدلو المملوء بالشراب من البئر المجاورة دفعة واحدة."
		},
		Summary = "سحب الدلو من البئر"
	},
	[21012] = {
		Title = "مكان الحفيد",
		Description = {
			"عليك العثور على حفيد الرجل المسن الذي تسلل خارج قرية الرماة شمال بايون. اسأل الحارس أمام الكهف الموجود في قرية الرماة."
		},
		Summary = "التحدث مع حارس الكهف"
	},
	[21013] = {
		Title = "حين تجد واحدا يختفي الآخر",
		Description = {
			"يقال إن رينو، الذي ذهب للبحث عن الحفيد، ما زال داخل الكهف. بما أنهم طلبوا منك ذلك مباشرة، فلا يمكنك تجاهل الأمر. اعثر على رينو داخل كهف بايون."
		},
		Summary = "التحدث مع رينو داخل الكهف"
	},
	[21014] = {
		Title = "الشبح النتن واللزج",
		Description = {
			"اقض على 5 من الزومبي القريبين من أجل رينو الذي يرتعب منها."
		},
		Summary = "صيد الزومبي من أجل رينو"
	},
	[21015] = {
		Title = "حرب الأموات الأحياء",
		IconName = "ico_dq.bmp",
		Description = {
			"أصبح حارس بايون مشغولا بسبب تزايد أعداد الزومبي والسكيليتون. طلب منك تقليل أعدادها بالقضاء على 10 من الزومبي و20 من السكيليتون. يقال إن السكيليتون تظهر في أعماق الكهف."
		},
		Summary = "القضاء على الأموات الأحياء في كهف بايون"
	},
	[21016] = {
		Title = "حرب الأموات الأحياء (انتظار)",
		IconName = "ico_dq.bmp",
		Description = {
			"يجب الاستمرار في القضاء على الأموات الأحياء التي تظهر بلا توقف."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[21017] = {
		Title = "مراسم تطهير الأرواح",
		IconName = "ico_dq.bmp",
		Description = {
			"تحتاج إلى تعاويذ إعادة الروح لتطهير أرواح الأشباح الحاقدة التي تحمل مظالم القرية المدفونة منذ زمن. اخضع موناك وبونغون واجمع تعاويذ إعادة الروح. يظهر موناك وبونغون في الطابق الثالث من كهف بايون."
		},
		Summary = "15 تعويذة إعادة الروح"
	},
	[21018] = {
		Title = "مراسم تطهير الأرواح (انتظار)",
		IconName = "ico_dq.bmp",
		Description = {
			"يقال إن مراسم التطهير تصبح ضرورية كلما ازدادت قوة الأرواح الشريرة. عد للمساعدة كلما سنحت الفرصة."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[21019] = {
		Title = "تهدئة الحزن بكأس من الشراب",
		IconName = "ico_dq.bmp",
		Description = {
			"طلب منك راهب ذو قوة روحية عالية تهدئة نيران الأشباح بشراب نقي، والحصول على 10 من أنفاس الأرواح. يمكنك الحصول على الشراب النقي من الرجل المسن في بايون، وتظهر نيران الأشباح في قرية المنازل المهجورة بالطابق الرابع من كهف بايون."
		},
		Summary = "10 من أنفاس الأرواح"
	},
	[21020] = {
		Title = "تهدئة الحزن بكأس من الشراب (انتظار)",
		IconName = "ico_dq.bmp",
		Description = {
			"كم عدد الأرواح الحزينة الموجودة في قرية المنازل المهجورة داخل كهف بايون؟ طلب منك الراهب العودة للمساعدة بعد طلوع الفجر."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[21021] = {
		Title = "آثار السحر العظيم",
		IconName = "ico_dq.bmp",
		Description = {
			"لا تعرف لماذا يحتاج البحث عن آثار السحر إلى مناديل الفتيات، لكن الباحث الشاب طلب 3 منها. يمكنك الحصول على مناديل الفتيات من سوهي في قرية المنازل المهجورة داخل كهف بايون."
		},
		Summary = "3 مناديل فتيات"
	},
	[21022] = {
		Title = "آثار السحر العظيم (انتظار)",
		IconName = "ico_dq.bmp",
		Description = {
			"يريد الباحث الشاب المهووس بمناديل الفتيات مساعدتك كل يوم إن أمكن. عد إليه إن كنت مهتما بجمع مناديل الفتيات المستخدمة في البحث."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[21023] = {
		Title = "صيد الثعلب",
		IconName = "ico_dq.bmp",
		Description = {
			"وحش الثعلب مونلايت فلاور هو من يمنع أرواح قرية المنازل المهجورة من الراحة. قرر شيخ بايون القضاء عليه. بعد ^0000FFهزيمة مونلايت فلاور^000000، خذ ^0000FFكرة الثعلب إلى التمثال الموجود في قرية الرماة^000000."
		},
		Summary = "التحدث مع الشيخ أمام التمثال بعد الحصول على الكرة"
	},
	[21024] = {
		Title = "استمرار صيد الثعلب",
		IconName = "ico_dq.bmp",
		Description = {
			"يستخدم مونلايت فلاور في قرية المنازل المهجورة مختلف الحيل والخدع ليقدم حياة مزيفة، ولا يغادر المكان. ربما يكون مونلايت فلاور نفسه كتلة من الأرواح الحاقدة التي ماتت ظلما، مثل بقية الأرواح."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[21025] = {
		Title = "قصة من زمن بعيد",
		Description = {
			"استمعت من الشيخ إلى قصة تأسيس قرية بايون."
		},
		Summary = ""
	},
	[21026] = {
		Title = "انتظار الحطب بقلق",
		Description = {
			"يقال إن الابن الذي خرج لجمع الحطب لم يعد. يبدو أن الابن دونغدونغ ذهب إلى الغابة جنوب بايون لجمع الحطب. اعثر عليه."
		},
		Summary = "التحدث مع دونغدونغ المسترخي"
	},
	[21027] = {
		Title = "ما الصعب في جمع بعض الخشب؟",
		Description = {
			"قال إنه يحتاج إلى صيد ويلو للحصول على قطع الخشب الجافة، لكن المهمة صعبة جدا عليه. اصطد 3 من ويلو بدلا من دونغدونغ، واحصل على قطعتين من الخشب الجاف وسلمهما إليه."
		},
		Summary = "قطعتان من الخشب الجاف"
	},
	[21028] = {
		Title = "عمل كالعسل",
		IconName = "ico_dq.bmp",
		Description = {
			"قررت جمع الحطب بدلا من الابن. اصطد 5 من ويلو في الغابة جنوب بايون، واحصل على 3 قطع خشب جافة، ثم سلمها إلى الرجل في منتصف العمر الذي ينتظر بقلق."
		},
		Summary = "3 قطع خشب جافة"
	},
	[21029] = {
		Title = "عمل كالعسل (انتظار)",
		IconName = "ico_dq.bmp",
		Description = {
			"يبدو أن الرجل في منتصف العمر في بايون ما زال يأمل أن يجمع شخص ما الحطب بدلا من ابنه."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[21030] = {
		Title = "إجراء لحماية الأطفال",
		Description = {
			"اقض على بوا من أجل الفتاة القلقة من إصابة الأطفال بسبب ظهورها في الغابة شرق بايون."
		},
		Summary = "صيد بوا"
	},
	[21031] = {
		Title = "صياد الأفاعي المحترف",
		IconName = "ico_dq.bmp",
		Description = {
			"قررت الاستمرار في صيد بوا في الغابة شرق بايون. اقض اليوم على 5 منها."
		},
		Summary = "صيد بوا"
	},
	[21032] = {
		Title = "صياد الأفاعي المحترف (انتظار)",
		IconName = "ico_dq.bmp",
		Description = {
			"يبدو أن فتاة بايون تريد من شخص الاستمرار في صيد بوا حتى يتمكن الأطفال من اللعب بأمان. عد وساعدها عندما يتوفر لديك الوقت."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[21033] = {
		Title = "البصلة الغريبة",
		Description = {
			"قالت جدة بايون إنها رأت بصلة غريبة الشكل في الغابة. تريد التأكد مما إن كان ذلك المخلوق المسمى وورمتيل بصلة حقيقية، وطلبت منك صيده وإحضار ساق حرشفية واحدة."
		},
		Summary = "ساق حرشفية واحدة"
	},
	[21034] = {
		Title = "إنها بصلة مؤذية",
		IconName = "ico_dq.bmp",
		Description = {
			"بعدما أدركت الجدة أن وورمتيل مخلوق يخدع الناس، طلبت منك القضاء عليه. يمكنك العثور على وورمتيل في الغابة شرق بايون."
		},
		Summary = "صيد وورمتيل"
	},
	[21035] = {
		Title = "إنها بصلة مؤذية (انتظار)",
		IconName = "ico_dq.bmp",
		Description = {
			"يستمر صيد وورمتيل. عد إلى جدة بايون بعد طلوع الفجر."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[21036] = {
		Title = "الفطر الغريب",
		Description = {
			"قال جد بايون إنه رأى فطرا مريبا في الغابة الشرقية. إنه متأكد من أنه مخلوق غريب، وطلب منك القضاء على الفطر المسمى سبور."
		},
		Summary = "صيد سبور"
	},
	[21037] = {
		Title = "قبل أن تغطي الفطريات المكان",
		IconName = "ico_dq.bmp",
		Description = {
			"يبدو أن جد بايون مندهش من سرعة تكاثر سبور. طلب منك القضاء عليها قبل أن تغطي الغابة الشرقية بالكامل. اصطد سبور!"
		},
		Summary = "صيد سبور"
	},
	[21038] = {
		Title = "قبل أن تغطي الفطريات المكان (انتظار)",
		IconName = "ico_dq.bmp",
		Description = {
			"عد إلى جد بايون عندما تصبح مستعدا لاستئصال سبور التي تسبب له القلق."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[21039] = {
		Title = "أعتمد عليك وحدك!",
		Description = {
			"انتهى بك الأمر إلى جمع الحطب بدلا من دونغدونغ. اذهب إلى والده الذي ينتظر الأخبار وأخبره بما حدث."
		},
		Summary = "التحدث مع الرجل القلق في منتصف العمر"
	},
	[21040] = {
		Title = "السجناء الحالمون بالهروب",
		IconName = "ico_dq.bmp",
		Description = {
			"في السجن السفلي لقلعة غلاست هايم، أعادت الطاقة المظلمة السجناء الموتى إلى الحياة كأموات أحياء يتجولون في المكان. طلب الكاهن كارون، الذي أنهكه تدفق الزومبي المستمر، القضاء على سكيليتون بريزونر وزومبي بريزونر."
		},
		Summary = "القضاء على سكيليتون بريزونر وزومبي بريزونر"
	},
	[21041] = {
