	[7760] = {
		Title = "مختبئ بإحكام",
		Description = {
			"يبدو أنك عثرت على جميع الباحثين المتبقين. عد وأبلغ تيس."
		},
		Summary = "تحدث مع تيس"
	},
	[7761] = {
		Title = "أرح الكيميرا بسلام",
		Description = {
			"يواجه الطاقم صعوبة في التعامل مع العينات الهائجة داخل المختبر. اقض على 10 من ^0000FFكيميرا نوع المواد وكيميرا النوع البشري^000000."
		},
		Summary = "اقض على الكيميرا"
	},
	[7762] = {
		Title = "أرح الكيميرا بسلام (انتظار)",
		Description = {
			"هذا طلب يومي يمكن تنفيذه مجددا غدا. انتظر حتى انتهاء المؤقت. سيطلب يوسلان في قاعدة هارت هنتر العسكرية مساعدتك مجددا غدا."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[7763] = {
		Title = "ممتلئ بطاقة الربيع",
		Description = {
			"طلب منك آرل تحرير ^0000FFطاقة شجرة الزهور^000000 الصغيرة قرب شجرة الزهور في برونتيرا، وإحضار 10 من ^0000FFأغصان الزهور^000000."
		},
		Summary = "10 أغصان زهور"
	},
	[7764] = {
		Title = "كلما شاركت أكثر كان أفضل",
		Description = {
			"وزع كعك الأرز اللزج بأزهار الكرز الذي صنعه آرل على الأطفال قرب كاتدرائية برونتيرا: تشيري وبلوسوم ووالنات وسينامون وراسبيري."
		},
		Summary = "توصيل كعك الأرز بأزهار الكرز"
	},
	[7765] = {
		Title = "التوصيل إلى تشيري",
		Description = {
			"أعطيت تشيري كعك الأرز اللزج بأزهار الكرز."
		},
		Summary = ""
	},
	[7766] = {
		Title = "التوصيل إلى بلوسوم",
		Description = {
			"أعطيت بلوسوم كعك الأرز اللزج بأزهار الكرز."
		},
		Summary = ""
	},
	[7767] = {
		Title = "التوصيل إلى والنات",
		Description = {
			"أعطيت والنات كعك الأرز اللزج بأزهار الكرز."
		},
		Summary = ""
	},
	[7768] = {
		Title = "التوصيل إلى سينامون",
		Description = {
			"أعطيت سينامون كعك الأرز اللزج بأزهار الكرز."
		},
		Summary = ""
	},
	[7769] = {
		Title = "التوصيل إلى راسبيري",
		Description = {
			"أعطيت راسبيري كعك الأرز اللزج بأزهار الكرز."
		},
		Summary = ""
	},
	[7770] = {
		Title = "ليلة بلا نوم، صرخات أرواح من وراء البحر",
		Description = {
			"تعاني أكارين من الأرق كل ليلة بسبب صرخات مجهولة. تظن أن بانشي هي السبب."
		},
		Summary = "اهزم بانشي"
	},
	[7771] = {
		Title = "طهر الحرم من فضلك!",
		Description = {
			"قال إيريدانوس، الذي يعمل في المعبد، إن أصواتا غريبة تصدر من أسفل المعبد. لا بد أن المخلوقات الشريرة ^0000FFهودريملين وفانبرك وإيسيلا^000000 هي السبب. اهزمها."
		},
		Summary = "اهزم جميع الوحوش في الحرم"
	},
	[7772] = {
		Title = "إنه شبح بالتأكيد!",
		Description = {
			"سمع ريغل في أكاديمية كيل هاير أصواتا غريبة قادمة من الكاتدرائية المهجورة، وطلب التحقيق فيها. تفقد الكاتدرائية."
		},
		Summary = "مدخل الكاتدرائية المهجورة"
	},
	[7773] = {
		Title = "تحقيق معمق",
		Description = {
			"يتكون داخل الكاتدرائية المهجورة من منشآت معقدة. ادخل الطابق الثاني واهزم إليوت، ثم استعد ^0000FFقطعة محترقة واحدة^000000."
		},
		Summary = "قطعة محترقة واحدة"
	},
	[7774] = {
		Title = "نفق مريب",
		Description = {
			"عثرت آيلا على طريق لدخول المنشأة عبر نفق تحت الأرض."
		},
		Summary = ""
	},
	[7775] = {
		Title = "مهمة تغيير الوظيفة إلى عالم وراثة",
		Description = {
			"قال ديمي كالبرين إن أفضل طريقة لترويض العربة هي التلويح بها نحو شيء ما. يبدو أن القفص ممتلئ بوحوش بويسن سبور..."
		},
		Summary = "100 بويسن سبور داخل القفص"
	},
	[7776] = {
		Title = "علامة مريبة",
		Description = {
			"يشعر شيوخ بايون بالقلق على مويون، متدربة رابط الأرواح التي اختفت أثناء أحد الطقوس. تحدث مع الباحث الشاب عند مدخل كهف بايون."
		},
		Summary = "تحدث مع الباحث الشاب"
	},
	[7777] = {
		Title = "ماذا حدث؟",
		Description = {
			"غادرت مويون إلى القصر المنفصل. يريد الباحث الشاب سؤالها عما حدث."
		},
		Summary = "تحدث مع مويون"
	},
	[7778] = {
		Title = "ما رأته مويون",
		Description = {
			"تشعر مويون بالاضطراب بسبب شيء رأته أثناء طقس التطهير. قالت إن عليك رؤيته بنفسك."
		},
		Summary = "تحدث مع مويون"
	},
	[7779] = {
		Title = "طقس مؤلم",
		Description = {
			"قالت مويون إنها تستطيع منحك تجربة مباشرة لطقس التطهير. استعد جيدا وتحدث معها."
		},
		Summary = "تحدث مع مويون"
	},
	[7780] = {
		Title = "كابوس القرية المدمرة",
		Description = {
			"فقدت وعيك أثناء الطقس ووصلت إلى القرية المدمرة داخل كهف بايون. هل ترتبط البوابة المتلألئة أمامك بالكابوس الذي أخبرتك عنه مويون؟"
		},
		Summary = "حقق في البوابة المتلألئة"
	},
	[7781] = {
		Title = "كابوس القرية المدمرة",
		Description = {
			"سحبت البوابة المتلألئة الباحث الشاب إلى داخلها في القرية المدمرة داخل كهف بايون."
		},
		Summary = "تحدث مع تشونغهاي على الجانب الآخر من البوابة"
	},
	[7782] = {
		Title = "أوقف الساحر!",
		Description = {
			"يعتقد الباحث تشونغهاي في دهليز كابوس زهرة ضوء القمر أن ^0000FFساحر الحقيقة^000000 مسؤول عن هذا الحادث. طلب منك القضاء عليه."
		},
		Summary = "اهزم ساحر حقيقة واحدا"
	},
	[7783] = {
		Title = "أوقف الساحر! (انتظار)",
		Description = {
			"يمكنك قبول هذه المهمة اليومية مجددا من الباحث تشونغهاي في دهليز كابوس زهرة ضوء القمر بعد انتهاء فترة الانتظار."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[7784] = {
		Title = "لا رحمة للأوهام",
		Description = {
			"طلب منك الجندي جونغهي في دهليز كابوس زهرة ضوء القمر تطهير المنطقة المحيطة به من ^0000FFناين تيل الغاضب^000000."
		},
		Summary = "اهزم ناين تيل الغاضب"
	},
	[7785] = {
		Title = "لا رحمة للأوهام (انتظار)",
		Description = {
			"يمكنك قبول هذه المهمة اليومية مجددا من الجندي جونغهي في دهليز كابوس زهرة ضوء القمر بعد انتهاء فترة الانتظار."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[7786] = {
		Title = "تذكر أسلافي",
		Description = {
			"طلب منك الجندي جونغهي في دهليز كابوس زهرة ضوء القمر إرسال ^0000FFالجنود الحاقدين^000000 إلى السماء."
		},
		Summary = "اهزم الجنود الحاقدين"
	},
	[7787] = {
		Title = "تذكر أسلافي (انتظار)",
		Description = {
			"يمكنك قبول هذه المهمة اليومية مجددا من الجندي جونغهي في دهليز كابوس زهرة ضوء القمر بعد انتهاء فترة الانتظار."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[7788] = {
		Title = "العودة إلى مويون",
		Description = {
			"انقل نتائج تحقيق تشونغهاي إلى ^0000FFمويون^000000 في ^0000FFقصر بايون المنفصل^000000."
		},
		Summary = "تحدث مع مويون في القصر المنفصل"
	},
	[7790] = {
		Title = "روك ريدج، أرض الفرص",
		Description = {
			"أعفاك ^0000FFكارام بوتشي^000000 من أجرة السفينة إلى روك ريدج كخدمة مجانية."
		},
		Summary = ""
	},
	[7791] = {
		Title = "مشكلات روك ريدج",
		Description = {
			"قال ^0000FFكارام بوتشي^000000 إن روك ريدج بحاجة إلى المساعدة. اذهب إليها وتحدث مع ^0000FFالعمدة كوستيلو^000000 عند الرصيف."
		},
		Summary = "تحدث مع كوستيلو",
		NpcSpr = "4_m_costell",
		NpcNavi = "harboro1",
		NpcPosX = 80,
		NpcPosY = 218
	},
	[7792] = {
		Title = "مشكلات روك ريدج 2",
		Description = {
			"قال ^0000FFالعمدة كوستيلو^000000 إن روك ريدج تعاني بسبب قطاع طرق بافالو، وإنه يريد منك حل المشكلة بالتعاون مع الشريف. اذهب إلى مكتب الشريف وقابل وايات وارب."
		},
		Summary = "تحدث مع وايات وارب",
		NpcSpr = "4_m_yattwarp",
		NpcNavi = "har_in01",
		NpcPosX = 20,
		NpcPosY = 30
	},
	[7793] = {
		Title = "أخبار سارة",
		Description = {
			"لا يريد ^0000FFجوني جيمس^000000، زعيم قطاع طرق بافالو، التفاوض إلا مع ^0000FFالعمدة كوستيلو^000000. انقل هذه الأخبار المثيرة إلى ^0000FFكوستيلو^000000 عند الرصيف."
		},
		Summary = "تحدث مع كوستيلو",
		NpcSpr = "4_m_costell",
		NpcNavi = "harboro1",
		NpcPosX = 80,
		NpcPosY = 218
	},
	[7794] = {
		Title = "رد متوقع",
		Description = {
			"طلب منك ^0000FFكوستيلو^000000، الذي يخشى قطاع الطرق كثيرا، الذهاب للتفاوض نيابة عنه. أخبر ^0000FFالشريف وارب^000000."
		},
		Summary = "تحدث مع وايات وارب",
		NpcSpr = "4_m_yattwarp",
		NpcNavi = "har_in01",
		NpcPosX = 20,
		NpcPosY = 30
	},
	[7795] = {
		Title = "مفاوضات على خط السكة الحديدية",
		Description = {
			"سيعقد اجتماع التفاوض قرب ^0000FFقطار الشحن المتوقف^000000. يمكنك العثور عليه بالخروج من البوابة الشرقية للقرية واتباع خط السكة الحديدية."
		},
		Summary = "اعثر على قطار الشحن المتوقف",
		NpcSpr = "4_m_johnnyjames",
	},
	[7796] = {
		Title = "اعتقال غير متوقع",
		Description = {
			"ساعدنا ^0000FFحراس الصبار الأهليون^000000 على القبض على زعيم قطاع طرق بافالو، ^0000FFجوني جيمس^000000. عد إلى مكتب الشريف وتحدث مع ^0000FFالشريفين^000000 عن خطوتنا التالية."
		},
		Summary = "تحدث مع وايات وإيفوكا",
		NpcSpr = "4_m_yattwarp",
		NpcNavi = "har_in01",
		NpcPosX = 20,
		NpcPosY = 30
	},
	[7797] = {
		Title = "استمع إلي 1",
		Description = {
			"كما اقترحت ^0000FFإيفوكا^000000، تحدث مع ^0000FFجوني جيمس^000000 وازرع الشك في ذهنه تجاه ^0000FFألبرت فورد^000000."
		},
		Summary = "تحدث مع جوني جيمس",
		NpcSpr = "4_m_johnnyjames"
	},
	[7798] = {
		Title = "تمهيد مثالي",
		Description = {
			"اقتنع ^0000FFجوني جيمس^000000 بأن ^0000FFألبرت فورد^000000 خانه. طلب منك التخلص من ^0000FFألبرت^000000 وإحضار لبدته دليلا. أبلغ ^0000FFالشريف^000000 أولا."
		},
		Summary = "تحدث مع وايات وارب",
		NpcSpr = "4_m_yattwarp",
		NpcNavi = "har_in01",
		NpcPosX = 20,
		NpcPosY = 30
	},
	[7799] = {
		Title = "سلاح شون مكوردي 1",
		Description = {
			"قال ^0000FFالشريف وارب^000000 إن ^0000FFرئيس العمال مكوردي^000000 يملك ورقة مساومة جيدة. ستجده في الساحة."
		},
		Summary = "تحدث مع شون مكوردي",
		NpcSpr = "4_m_seanmccurdy",
		NpcNavi = "harboro1",
		NpcPosX = 288,
		NpcPosY = 193
	},
	[7800] = {
		Title = "سلاح شون مكوردي 2",
		Description = {
			"تمكنت من الحصول على بعض الخامات البنفسجية التي ظننت أنه لم يعد بالإمكان استخراجها بسبب ^0000FFقطاع طرق بافالو^000000. اعثر على ^0000FFشون مكوردي^000000 جنوب مدخل المنجم."
		},
		Summary = "تحدث مع شون مكوردي",
		NpcSpr = "4_m_seanmccurdy",
		NpcNavi = "rockmi2",
		NpcPosX = 10,
		NpcPosY = 86
	},
	[7801] = {
		Title = "سلاح شون مكوردي 3",
		Description = {
			"تمكنتم من التسلل إلى الطابق الثاني من المنجم. احصل على <ITEM>خام ارجواني<INFO>25247</INFO></ITEM> واحد، ثم تحدث مع شون."
		},
		Summary = "خام بنفسجي واحد"
	},
	[7802] = {
		Title = "استمع إلي 2",
		Description = {
			"عليك ^009900الطرق على صخرة الإشارة 3 مرات^000000، ثم التحدث مع ^0000FFألبرت فورد^000000 عن مستقبل عصابته."
		},
		Summary = "تحدث مع ألبرت فورد",
		NpcSpr = "4_m_albertford",
		NpcNavi = "rockrdg2",
		NpcPosX = 295,
		NpcPosY = 309
	},
	[7803] = {
		Title = "سعيد بانهيار الثقة",
		Description = {
			"اقتنع ^0000FFألبرت فورد^000000 بأن ^0000FFجوني جيمس^000000 خان عصابته، ووافق على عقد صفقة. سلم ^0000FFلبدة ألبرت^000000 إلى ^0000FFجوني جيمس^000000 دليلا."
		},
		Summary = "تحدث مع جوني جيمس",
		NpcSpr = "4_m_johnnyjames"
	},
	[7804] = {
		Title = "موقع الخامات",
		Description = {
			"أخبرك ^0000FFجوني^000000 بمكان إخفائه للخامات: \"^009900تحت المصعد في الطابق الثاني من المنجم^000000\". أبلغ ^0000FFالشريف وارب^000000 بهذه المعلومات."
		},
		Summary = "تحدث مع وايات وارب",
		NpcSpr = "4_m_yattwarp",
		NpcNavi = "har_in01",
		NpcPosX = 20,
		NpcPosY = 30
	},
	[7805] = {
		Title = "موقع الخامات 2",
		Description = {
			"يوجد ^0000FFشون مكوردي^000000 عند ^009900المدخل المؤقت إلى الطابق الثاني من المنجم^000000. أخبره بمكان الخامات واتبعه إلى داخل المنجم."
		},
		Summary = "تحدث مع شون مكوردي",
		NpcSpr = "4_m_seanmccurdy",
		NpcNavi = "rockmi2",
		NpcPosX = 10,
		NpcPosY = 86
	},
	[7806] = {
		Title = "موقع الخامات 3",
		Description = {
			"يقع المصعد المعطل شمال وسط الطابق الثاني. اعثر على <ITEM>صندوق الخام الارجواني<INFO>25248</INFO></ITEM> واحد تحته، وأحضره إلى ^0000FFشون مكوردي^000000."
		},
		Summary = "اعثر على صندوق خامات واحد",
		NpcSpr = "4_m_seanmccurdy",
		NpcNavi = "rockmi2",
		NpcPosX = 10,
		NpcPosY = 86
	},
	[7807] = {
		Title = "ورقتنا الرابحة",
		Description = {
			"تخلص من بعض ^0000FFقطاع طرق بافالو^000000، واجمع 5 من <ITEM>وشاح بني<INFO>25283</INFO></ITEM> و5 من <ITEM>وشاح سارق<INFO>25278</INFO></ITEM> لعرضها على ^0000FFألبرت فورد^000000. سيشتعل غضبا."
		},
		Summary = "5 أوشحة بنية و5 أوشحة قطاع طرق",
		NpcSpr = "4_m_johnnyjames"
	},
	[7808] = {
		Title = "حلت القضية",
		Description = {
