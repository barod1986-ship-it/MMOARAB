	[21900] = {
		Title = "مرحبا!",
		Description = {
			"توجد في إزلود أكاديمية تعمل أيضا كنقابة لدعم المغامرين. اذهب لمقابلة <NAVI>سبراكي<INFO>iz_ac01,102,44,0,101,0</INFO></NAVI> في أكاديمية كرياتورا شمال إزلود."
		},
		Summary = "التحدث مع سبراكي"
	},
	[21901] = {
		Title = "خدمة يجب أن تعرفها",
		Description = {
			"قالت سبراكي إن هناك أمرا لا بد من معرفته قبل بدء المغامرة، وطلبت منك مقابلة <NAVI>موظفة كافرا<INFO>izlude,128,148,0,101,0</INFO></NAVI> في وسط إزلود."
		},
		Summary = "التحدث مع موظفة كافرا"
	},
	[21902] = {
		Title = "هل هذه مهمتك الأولى؟",
		Description = {
			"طلبت منك موظفة كافرا توصيل صندوق إلى <NAVI>موريس<INFO>izlude_in,69,116,0,101,0</INFO></NAVI>. يوجد موريس داخل متجر الأدوات في إزلود."
		},
		Summary = "توصيل الصندوق إلى موريس"
	},
	[21903] = {
		Title = "هل رأى أحد رينو؟",
		Description = {
			"طلب موريس في متجر الأدوات البحث عن السياف ذي الشعر الأحمر رينو، الذي ذهب لتفقد الأعشاب. اجمع معلومات عن رينو من <NAVI>الحقل غرب إزلود<INFO>prt_fild08,320,230,0,101,0</INFO></NAVI>."
		},
		Summary = "التحدث مع أور"
	},
	[21904] = {
		Title = "مصير متعقب الأعشاب",
		Description = {
			"قررت تفقد حقل الأعشاب بدلا من رينو المنهمك في التدريب. ويقال إن أحد أصدقائه ذهب بالفعل لتفقده نيابة عنه..."
		},
		Summary = "التحدث مع الطفل"
	},
	[21905] = {
		Title = "رهان مع متعقب الأعشاب",
		Description = {
			"دخلت في رهان للقضاء على لوناتيك والحصول على برسيم. كان الرهان من طرف واحد، لكن لوناتيك كثيرة في المنطقة، لذا اقض عليها بسرعة."
		},
		Summary = "إهداء برسيم واحد للطفل"
	},
	[21906] = {
		Title = "نصيحة متعقب الأعشاب",
		Description = {
			"أخبرك لومين بوجود أعشاب قرب الطفل. خذ الأعشاب التي جمعتها وعد إلى <NAVI>رينو وأور<INFO>prt_fild08,320,230,0,101,0</INFO></NAVI> اللذين يتدربان."
		},
		Summary = "التحدث مع أور"
	},
	[21907] = {
		Title = "المحطة الأخيرة للأعشاب",
		Description = {
			"استمعت من أور إلى شرح عن السياف. خذ الأعشاب التي حصلت عليها بعد كل هذه المتاعب إلى <NAVI>موريس<INFO>izlude_in,69,116,0,101,0</INFO></NAVI>."
		},
		Summary = "التحدث مع موريس"
	},
	[21908] = {
		Title = "استعدادا للحظات الطارئة",
		Description = {
			"أعطاك موريس في متجر الأدوات عدة تركيب، وطلب منك مقابلة <NAVI>المعالج<INFO>iz_ac01,60,43,0,101,0</INFO></NAVI> في عيادة أكاديمية كرياتورا لتعلم طريقة استخدامها."
		},
		Summary = "التحدث مع المعالج"
	},
	[21909] = {
		Title = "ما يمكن فعله بجيلوبي",
		Description = {
			"طلب منك الرامي <NAVI>مالبورن<INFO>izlude,115,103,0,101,0</INFO></NAVI>، الذي قابلته في إزلود، إحضار 3 من جيلوبي لاستخدامها في مهارة صناعة الأسهم. يمكنك الحصول على جيلوبي من بورينغ."
		},
		Summary = "تسليم 3 من جيلوبي إلى مالبورن"
	},
	[21910] = {
		Title = "إلى برونتيرا!",
		Description = {
			"بعدما أصبحت عضوا فخورا في مجموعة إيدن، قررت المساعدة في حل مشكلة تواجه كاتدرائية برونتيرا. قابل <NAVI>رفيقك<INFO>prt_fild08,182,359,0,101,0</INFO></NAVI> خارج البوابة الجنوبية لبرونتيرا وانضم إليه."
		},
		Summary = "التحدث مع رينو"
	},
	[21911] = {
		Title = "ثلاث منشورات",
		Description = {
			"قررت تعليق المنشورات على الجدار الداخلي شمال برونتيرا. إن تابعت السير شمالا عبر الطريق الرئيسي، فقد ترى المواضع التي حددها بران على الجدار..."
		},
		Summary = "تعليق المنشور"
	},
	[21912] = {
		Title = "محتوى المنشور",
		Description = {
			"عندما علقت المنشور في المكان المحدد، قال لومين شيئا مثيرا للقلق ثم اختفى. ابحث عن موقع المنشور الثاني."
		},
		Summary = "تعليق المنشور"
	},
	[21913] = {
		Title = "إلى برونتيرا مجددا!",
		Description = {
			"لحل مشكلة كاتدرائية برونتيرا التي تأجلت بسبب حادثة المنشورات، قررت مقابلة <NAVI>الكاهن روام<INFO>prt_church,107,99,0,101,0</INFO></NAVI> داخل الكاتدرائية."
		},
		Summary = "التحدث مع الكاهن روام"
	},
	[21914] = {
		Title = "من أجل سلامة الأطفال",
		Description = {
			"طلب منك الكاهن روام في كاتدرائية برونتيرا تنظيف الحقل شرق برونتيرا من الوحوش. اقض على لوناتيك وفابر حتى يتمكن الأطفال من اللعب بأمان."
		},
		Summary = "القضاء على لوناتيك وفابر"
	},
	[21915] = {
		Title = "حبات التوت المتفرقة",
		Description = {
			"طلب منك الكاهن روام في كاتدرائية برونتيرا العثور على الأطفال الذين لم يعودوا. ابحث في أنحاء برونتيرا عن راسبيري وبلوبيري وكرانبيري."
		},
		Summary = "العثور على الأطفال والتحدث مع روام"
	},
	[21916] = {
		Title = "عثرت على راسبيري!",
		Description = {
			"عثرت على راسبيري أمام ورشة الحدادة. توجد <NAVI>بلوبيري<INFO>prontera,78,104,0,101,0</INFO></NAVI> قرب المكتب الإداري، بينما توجد <NAVI>كرانبيري<INFO>prontera,162,324,0,101,0</INFO></NAVI> أمام القصر."
		},
		Summary = ""
	},
	[21917] = {
		Title = "عثرت على بلوبيري!",
		Description = {
			"عثرت على بلوبيري أمام المكتب الإداري. توجد <NAVI>راسبيري<INFO>prontera,170,183,0,101,0</INFO></NAVI> قرب ورشة الحدادة، بينما توجد <NAVI>كرانبيري<INFO>prontera,162,324,0,101,0</INFO></NAVI> أمام القصر."
		},
		Summary = ""
	},
	[21918] = {
		Title = "عثرت على كرانبيري!",
		Description = {
			"عثرت على كرانبيري أمام القصر. توجد <NAVI>بلوبيري<INFO>prontera,78,104,0,101,0</INFO></NAVI> قرب المكتب الإداري، بينما توجد <NAVI>راسبيري<INFO>prontera,170,183,0,101,0</INFO></NAVI> قرب ورشة الحدادة."
		},
		Summary = ""
	},
	[21919] = {
		Title = "البحث عن أتباع الإلهة 1",
		Description = {
			"طلب منك الفارس ميريك المساعدة في العثور على بران، الذي تسبب في توزيع المنشورات المريبة. اعثر على <NAVI>رينو<INFO>prt_fild05,335,225,0,101,0</INFO></NAVI> الذي يبحث في الحقل غرب برونتيرا."
		},
		Summary = "فحص آثار القتال"
	},
	[21920] = {
		Title = "البحث عن أتباع الإلهة 2",
		Description = {
			"قال رينو إن آثار الحركة المريبة تمتد نحو الجنوب. اتبعها فورا."
		},
		Summary = "فحص الشجيرات المبعثرة"
	},
	[21921] = {
		Title = "البحث عن أتباع الإلهة 3",
		Description = {
			"يقال إن روكر قريبا التقط الدليل الذي عثر عليه رينو وفر هاربا. اصطد بعضا من روكر."
		},
		Summary = "القضاء على روكر"
	},
	[21922] = {
		Title = "البحث عن أتباع الإلهة 4",
		Description = {
			"قال رينو إن آثار الحركة المريبة تمتد نحو الشرق. اتبعها فورا."
		},
		Summary = "التحدث مع الجندي"
	},
	[21923] = {
		Title = "هذا يكفي الآن",
		Description = {
			"قررت إبلاغ <NAVI>سبراكي<INFO>iz_ac01,102,44,0,101,0</INFO></NAVI> في أكاديمية كرياتورا بإزلود بنتائج البحث حتى الآن."
		},
		Summary = "التحدث مع سبراكي"
	},
	[21924] = {
		Title = "نصيحة للتدريب",
		Description = {
			"قالت سبراكي إنك قد تجد عملا في بايون، واقترحت عليك التوجه إليها. اذهب إلى بايون عبر <NAVI>موظفة كافرا<INFO>izlude,128,148,0,101,0</INFO></NAVI> في ساحة إزلود."
		},
		Summary = "التحدث مع موظفة كافرا"
	},
	[21925] = {
		Title = "استدعاء نقابة المغامرين",
		Description = {
			"تلقيت رسالة عاجلة من أكاديمية كرياتورا في إزلود. اذهب لمقابلة <NAVI>سبراكي<INFO>iz_ac01,102,44,0,101,0</INFO></NAVI>."
		},
		Summary = "التحدث مع سبراكي"
	},
	[21926] = {
		Title = "مطاردة تابع الإلهة",
		Description = {
			"قال الفارس ميريك إنه تلقى في ألبرتا بلاغا عن بران. لمعرفة مكان بران، قابل <NAVI>بيدروانا<INFO>alberta,175,138,0,101,0</INFO></NAVI> في ألبرتا واحصل منه على المعلومات."
		},
		Summary = "التحدث مع بيدروانا"
	},
	[21927] = {
		Title = "حطام السفينة المريب",
		Description = {
			"قال بيدروانا إن بران استعار قاربا واتجه إلى السفينة المحطمة. افحص المنطقة المحيطة بالسفينة المحطمة، ثم ادخل وابحث في داخلها."
		},
		Summary = "إلى جزيرة السفينة المحطمة"
	},
	[21928] = {
		Title = "قرية بورينغ",
		Description = {
			"تلقيت مهمة من مجموعة إيدن للتحقق من حقيقة الشائعات المنتشرة عن قرية بورينغ قرب برونتيرا. اجمع المعلومات من المنطقة غرب برونتيرا."
		},
		Summary = ""
	},
	[21929] = {
		Title = "إلى جزيرة السفينة المحطمة",
		Description = {
			"يبدو أن بران مختبئ في جزيرة السفينة المحطمة. انتقل إلى السفينة المحطمة عبر البحار الموجود قرب ميناء ألبرتا وحقق في الأمر."
		},
		Summary = "التحقيق في السفينة المحطمة المريبة"
	},
	[21930] = {
		Title = "خاتم الزهور الذي سيزهر مجددا",
		Description = {
			"يمكن مباركة خاتم الزهور المقدس الذي أعطاك إياه السير ميريك. زر كاتدرائية برونتيرا وسلم الخاتم إلى <NAVI>الكاهن روام<INFO>prt_church,107,99,0,101,0</INFO></NAVI>."
		},
		Summary = "التحدث مع الكاهن روام"
	},
	[40000] = {
		Title = "نشل لايت هالزن",
		Description = {
			"انتظر 5 دقائق على الأقل قبل محاولة التحدث مع الرجل المريب مجددا."
		},
