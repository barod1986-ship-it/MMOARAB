	},
	[21227] = {
		Title = "أشخاص في مأزق -1",
		Description = {
			"يبدو أن طالبا جامعيا جاء إلى جزيرة بايلان لإجراء دراسة ويواجه مشكلة، وقد طلب إرسال شخص لمساعدته. اركب السفينة من ميناء إزلود إلى جزيرة بايلان وقابل الطالب هيلدن."
		},
		Summary = "التحدث مع الطالب هيلدن"
