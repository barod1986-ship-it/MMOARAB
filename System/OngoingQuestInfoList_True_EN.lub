		Summary = "سلم مواد البحث إلى كاردوي"
	},
	[7445] = {
		Title = "من يقف وراء أفانت",
		Description = {
			"حققت في القوة التي تقف وراء أبحاث أفانت المتعلقة بالجرم. المشتبه به الأرجح هو داعم أفانت، رئيس الأركان. اقترب منه لكشف الحقيقة."
		},
		Summary = "تحدث مع رئيس الأركان"
	},
	[7446] = {
		Title = "حديث بلا نتيجة",
		Description = {
			"تحدثت مع رئيس الأركان شنايم، لكنك لم تحصل على شيء. قال إنه ربما خدع من أفانت أيضا. كان رئيس الأركان غاضبا في الحقيقة لأن كاردوي لم يفعل سوى زيادة الدفاعات حول الجرم."
