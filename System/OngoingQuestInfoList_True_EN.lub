	[21201] = {
		Title = "البحث عن التلميذ المفقود",
		Description = {
			"طلب منك الباحث المسن الذي قابلته في موروك العثور على تلميذه، الذي انطلق وحده بحثا عن نقابة القتلة. اذهب إلى الصحراء جنوب شرق موروك حيث تقع نقابة القتلة."
		},
		Summary = "التحدث مع التلميذ"
	},
	[21202] = {
		Title = "من يعرقلون الطريق",
		Description = {
			"قال تلميذ الباحث المسن الذي عثرت عليه في زاوية من الصحراء إنه لا يستطيع مواصلة طريقه بسبب ساندمان، وطلب منك القضاء عليها وجمع ^0000FF5 قطع رمل^000000."
		},
		Summary = "5 قطع رمل"
	},
	[21203] = {
		Title = "مفقود لكنه ليس مفقودا تماما",
		Description = {
			"يتضح من تصرفات الفتى أنه لم يتخل بعد عن تعلقه بالصحراء ونقابة القتلة. عد لزيارته إن كنت قلقا عليه."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[21204] = {
		Title = "ألم الظهر مقابل تسليم الغرض",
		Description = {
			"طلب منك الباحث المسن عند الواحة أمام الهرم خارج موروك العثور على ^0000FFمجرفة ميدانية^000000 أخذها فيريت إلى أعماق الهرم. كما يمكنك القضاء على فيريت وماينوروس أثناء ذلك."
		},
		Summary = "مجرفة ميدانية واحدة"
	},
	[21205] = {
		Title = "لا أستطيع النوم",
		Description = {
			"طلب منك لومين المقيم في نقابة اللصوص المساعدة، إذ يعاني أعضاء النقابة من فيريت وماينوروس اللذين يعيشان في الطوابق السفلية. اقض عليهما."
		},
		Summary = ""
	},
	[21206] = {
		Title = "النوم ليس ليوم واحد فقط",
		Description = {
			"طلب لومين منك تنظيف أعماق الهرم يوميا متى استطعت. عد إليه مجددا إن أردت المساعدة."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[21207] = {
		Title = "مصير الأصدقاء خلف المتاهة -1",
		Description = {
			"قال إرنست إنه افترق عن أصدقائه الذين جاؤوا معه لتنفيذ المهمة، وطلب منك العثور عليهم داخل الهرم وإبلاغهم بأنه بخير. اصعد الهرم ببطء."
		},
		Summary = "التحدث مع قائد المجموعة ماكسيم"
	},
	[21208] = {
		Title = "الصندوق الأزرق القديم والحلم الجميل",
		Description = {
			"يؤمن أصدقاء إرنست بأن متاع الموتى قد يحتوي على صندوق أزرق قديم. طلبوا منك صيد المومياء والحصول على أحد متعلقات الموتى للتحقق من ذلك..."
