	},
	[8004] = {
		Title = "تغيير الوظيفة إلى مغتال",
		Description = {
			"سيتم اختبار قدرتك على الاختباء. اعبر الغرفة والوصول إلى الطرف الآخر دون هزيمة أي وحش."
