	},
	[5425] = {
		Title = "إلى رفيقي العزيز",
		Description = {
			"ماذا لو سمعت صوتا مألوفا داخل سجن مظلم؟ قد تشعر ببعض الخوف، لكنه سيوقظ فيك الحنين أيضا. ابحث عن مصدر الصوت."
		},
		Summary = ""
	},
	[5426] = {
		Title = "إلى رفيقي العزيز (انتظار)",
		Description = {
			"أوصلت أخبار الصديق القديم. امنحه بعض الوقت ليستغرق في ذكرياته القديمة."
		},
		Summary = "وقت إعادة التعيين 4:00 صباحا"
	},
	[5427] = {
		Title = "إلى رفيقي العزيز (متكررة)",
		Description = {
			"يساعد تبادل الرسائل بانتظام على الحفاظ على صحة السجناء النفسية. احصل على الرسالة من الصديق الموجود في مكان ما داخل السجن تحت الأرض."
		},
		Summary = ""
	},
	[5428] = {
		Title = "معايير متدنية",
		Description = {
			"طلب منك السجين الذي يجمع العيون الجميلة إحضار 20 عينا حمراء من الوحش ذي أجنحة الخفاش. هل يعاني مشكلة في ثقته بنفسه؟"
		},
		Summary = ""
	},
	[5429] = {
		Title = "معايير متدنية (انتظار)",
		Description = {
			"أصبح السجين مفتونا بالعيون الحمراء. أحضر له المزيد لاحقا لتهدئته مجددا."
		},
		Summary = "وقت إعادة التعيين 4:00 صباحا"
	},
	[5430] = {
		Title = "معايير متدنية (متكررة)",
		Description = {
			"طلب منك السجين الحصول على المزيد. أحضر 20 عينا حمراء لتهدئته."
		},
		Summary = ""
	},
	[5431] = {
		Title = "حياة نظيفة",
		Description = {
			"عليك تنظيف السجن المتسخ تحت الأرض. نظفه بقلب مفعم بالبهجة."
		},
		Summary = ""
	},
	[5432] = {
		Title = "اكتمل التنظيف",
		Description = {
			"أنهيت تنظيف السجن تحت الأرض. عد ليتم تفقد عملك."
		},
		Summary = ""
	},
	[5433] = {
		Title = "حياة نظيفة (انتظار)",
		Description = {
			"هل تعلم؟ حان وقت انتظار الفوضى التالية بعد الاستمتاع ببهجة التنظيف."
		},
		Summary = "وقت إعادة التعيين 4:00 صباحا"
	},
	[5434] = {
		Title = "حياة نظيفة (متكررة)",
		Description = {
			"حان الوقت للاستمتاع ببهجة التنظيف. نظف السجن تحت الأرض بقلب مفعم بالبهجة."
		},
		Summary = ""
	},
	[5435] = {
		Title = "اكتمل التنظيف (متكررة)",
		Description = {
			"أنهيت تنظيف السجن تحت الأرض. عد ليتم تفقد عملك."
		},
		Summary = ""
	},
	[5436] = {
		Title = "البحث عن الضوء",
		Description = {
			"يبدو أن هذا السجين يكره الظلام. أحضر له ضوءا ساطعا من الشعلة الضخمة الموجودة في السجن."
		},
		Summary = ""
	},
	[5437] = {
		Title = "البحث عن الضوء (انتظار)",
		Description = {
			"يبدو راضيا عن الضوء الساطع. أحضر له المزيد عندما يبدأ الضوء بالخبو."
		},
		Summary = "وقت إعادة التعيين 4:00 صباحا"
	},
	[5438] = {
		Title = "البحث عن الضوء (متكررة)",
		Description = {
			"أحضر ضوءا ساطعا مجددا من الشعلة الضخمة الموجودة في السجن."
		},
		Summary = ""
	},
	[5439] = {
		Title = "حياة منعشة في السجن",
		Description = {
			"يبدو أن السجين منزعج من رطوبة السجن. أحضر 20 مزيلا للرطوبة لتوفير حياة مريحة له."
		},
		Summary = ""
	},
	[5440] = {
		Title = "حياة منعشة في السجن (انتظار)",
		Description = {
			"بما أن السجن مكان رطب، فستنتهي مزيلات الرطوبة عاجلا أم آجلا. أحضر المزيد عندما تنفد."
		},
		Summary = "وقت إعادة التعيين 4:00 صباحا"
	},
	[5441] = {
		Title = "حياة منعشة في السجن (متكررة)",
		Description = {
			"كما توقعت، لم تدم مزيلات الرطوبة طويلا. أحضر 20 مزيلا للرطوبة مجددا."
		},
		Summary = ""
	},
	[5442] = {
		Title = "تهدئة الظلام",
		Description = {
			"لا تضيء الزهور الظلام فحسب، بل تمنح العقل السكينة أيضا. أحضر زهرة."
		},
		Summary = ""
	},
	[5443] = {
		Title = "تهدئة الظلام (انتظار)",
		Description = {
			"هدأ الظلام، لكنه قد يثور مجددا. قد أضطر إلى إحضار زهرة أخرى عندما يحين الوقت."
		},
		Summary = "وقت إعادة التعيين 4:00 صباحا"
	},
	[5444] = {
		Title = "تهدئة الظلام (متكررة)",
		Description = {
			"يثور الظلام مجددا. أحضر زهرة. أي زهرة ينبغي أن أحضر هذه المرة؟"
		},
		Summary = ""
	},
	[5445] = {
		Title = "شيء صغير مزعج",
		Description = {
			"نتوء صغير على القرن... لا أستطيع فهم الأمر لأنني لا أملك قرنا، لكنه يبدو مزعجا. اصطد تافي واجمع 20 قطعة من ورق الصنفرة."
		},
		Summary = ""
	},
	[5446] = {
		Title = "شيء صغير مزعج (انتظار)",
		Description = {
			"يبدو أن هذا السجين يظن حقا أنني موظف استقبال في فندق السجن، وقد يستدعيني بانتظام."
		},
		Summary = "وقت إعادة التعيين 4:00 صباحا"
	},
	[5447] = {
		Title = "شيء صغير مزعج (متكررة)",
		Description = {
			"لماذا يحتاج إلى المزيد من ورق الصنفرة؟ بما أنه طلب ذلك، اصطد تافي وأحضر 20 قطعة من ورق الصنفرة."
		},
		Summary = ""
	},
	[5448] = {
		Title = "طلب قائد الحرس",
		Description = {
			"طلب منك قائد حرس برونتيرا شبيغل مساعدة <NAVI>القروي<INFO>prt_q,221,193,0,101,0</INFO></NAVI> الذي يواجه مشكلة في الموقع المحدد على الخريطة."
		},
		Summary = ""
	},
	[5449] = {
		Title = "طلب قائد الحرس",
		Description = {
			"طلب منك قائد حرس برونتيرا شبيغل مساعدة <NAVI>القروي<INFO>prt_q,276,242,0,101,0</INFO></NAVI> الذي يواجه مشكلة في الموقع المحدد على الخريطة."
		},
		Summary = ""
	},
	[5450] = {
		Title = "طلب قائد الحرس",
		Description = {
			"طلب منك قائد حرس برونتيرا شبيغل مساعدة <NAVI>القروي<INFO>prt_q,140,304,0,101,0</INFO></NAVI> الذي يواجه مشكلة في الموقع المحدد على الخريطة."
		},
		Summary = ""
	},
	[5451] = {
		Title = "طلب قائد الحرس",
		Description = {
			"طلب منك قائد حرس برونتيرا شبيغل مساعدة <NAVI>القروي<INFO>prt_q,38,261,0,101,0</INFO></NAVI> الذي يواجه مشكلة في الموقع المحدد على الخريطة."
		},
		Summary = ""
	},
	[5452] = {
		Title = "طلب قائد الحرس (انتظار)",
		Description = {
			"ساعدت أحد سكان برونتيرا. عليك التجول في المدينة لبعض الوقت والمساعدة في القضاء على الموتى الأحياء."
		},
		Summary = ""
	},
	[5453] = {
		Title = "ناكر الجميل (1)",
		Description = {
			"قابلت فتى من القرية يرتجف خوفا. اصطحبه أولا إلى <NAVI>مكتب القرية<INFO>prt_q,79,96,0,101,0</INFO></NAVI>، فهو أقرب ملجأ."
		},
		Summary = ""
	},
	[5454] = {
		Title = "ناكر الجميل (2)",
		Description = {
			"بعد أن أوصلت فتى القرية إلى الملجأ القريب، طلب منك العثور على حقيبة أدوات فقدها قرب <NAVI>المصهر<INFO>prt_q,178,185,0,101,0</INFO></NAVI>."
		},
		Summary = ""
	},
	[5455] = {
		Title = "ناكر الجميل (3)",
		Description = {
			"عثرت على حقيبة أدوات <NAVI>فتى القرية<INFO>prt_q,77,98,0,101,0</INFO></NAVI> المفقودة أمام مصهر برونتيرا."
		},
		Summary = ""
	},
	[5456] = {
		Title = "ناكر الجميل (4)",
		Description = {
			"سلمت حقيبة أدوات فتى القرية بأمان. لا تشعر بالرضا تجاه الأمر، لكنك فعلت عملا صالحا، لذا تابع طريقك."
		},
		Summary = ""
	},
	[5457] = {
		Title = "اعثر على أختي (1)",
		Description = {
			"اصطحب الفتاة التي كانت تبكي بعد فقدان أختها إلى <NAVI>الكاتدرائية<INFO>prt_q,232,318,0,101,0</INFO></NAVI>، فهي أقرب ملجأ."
		},
		Summary = ""
	},
	[5458] = {
		Title = "اعثر على أختي (2)",
		Description = {
			"اصطحب الفتاة إلى أختها في <NAVI>مبنى الفرسان<INFO>prt_q,52,340,0,101,0</INFO></NAVI>، وهو ملجأ آخر."
		},
		Summary = ""
	},
	[5459] = {
		Title = "اعثر على أختي (3)",
		Description = {
			"ساعدت الفتاة التي كانت تبكي بعد انفصالها عن أختها على الاجتماع بها."
		},
		Summary = ""
	},
	[5460] = {
		Title = "تبجح مفضوح (1)",
		Description = {
			"اصطحب الجندي إلى <NAVI>مبنى الفرسان<INFO>prt_q,79,96,0,101,0</INFO></NAVI>، فهو أقرب ملجأ."
		},
		Summary = ""
	},
	[5461] = {
		Title = "تبجح مفضوح (2)",
		Description = {
			"كان بإمكانه البقاء في مبنى الفرسان، لكنه أصر على الانتقال إلى مكان آخر لتقديم الدعم. اصطحبه إلى <NAVI>مكتب القرية<INFO>prt_q,79,96,0,101,0</INFO></NAVI> كما يريد."
		},
		Summary = ""
	},
	[5462] = {
		Title = "تبجح مفضوح (3)",
		Description = {
			"لماذا يوجد هذا الجندي المتبجح القادم من غيفن في برونتيرا؟ على الأقل تمكنت من مساعدته."
		},
		Summary = ""
	},
	[5463] = {
		Title = "حب جنوني للزوجة (1)",
