	[11000] = {
		Title = "تفقد ضريح أودين",
		Description = {
			"إن كنت ترغب في مساعدتنا، فتجول في المعبد وانظر إن كنت تريد العمل معنا. تحدث مع الملاح للسفر إلى المعبد، حسنا؟"
		},
		Summary = "تحدث مع أليكس مجددا بعد استكشاف المعبد"
	},
	[11001] = {
		Title = "تفقد ضريح أودين",
		Description = {
			"مهمتك الأولى هي إحضار ^3355FF‏5 من رون الظلام^000000 من المعبد. لا تقلق، فسأحرص على مكافأتك على جهودك."
		},
		Summary = "أحضر 5 من رون الظلام إلى أليكس"
	},
	[11002] = {
		Title = "تفقد ضريح أودين",
		Description = {
			"يتمتم أليكس بشأن المرأة ذات الشعر الرمادي أثناء استلامها رون الظلام."
		},
		Summary = "هل ينبغي أن أتحدث معها؟"
	},
	[11003] = {
		Title = "تفقد ضريح أودين",
		Description = {
			"عليك أولا الذهاب إلى المعبد واستكشاف المنطقة لمصلحتك. تحدث مع الملاح، وسينقلك إلى هناك، حسنا؟"
		},
		Summary = "تحدث مع لورا بعد الاستكشاف"
	},
	[11004] = {
		Title = "تفقد ضريح أودين",
		Description = {
			"حسنا، أحضر لي ^3355FF‏5 من رون الظلام^000000 من ضريح أودين."
		},
		Summary = "أحضر 5 من رون الظلام إلى لورا"
	},
	[11005] = {
		Title = "تفقد معبد أودين",
		Description = {
			"اكتملت مهمتك الأولى. هل يوجد شيء آخر يمكنك المساعدة فيه؟"
		},
		Summary = ""
	},
	[11006] = {
		Title = "تفقد ضريح أودين",
		Description = {
			"تتساءل لورا عما يفعله أولئك الأشخاص في الغرفة الأخرى."
		},
		Summary = "تسلل واستمع إلى حديث أليكس، ثم عد إلى لورا"
	},
	[11007] = {
		Title = "تفقد ضريح أودين",
		Description = {
			"أريد منك تفقد الجزيرة الداخلية ومعرفة ما يمكنك العثور عليه."
		},
		Summary = "حقق في الجزيرة الداخلية لضريح أودين المبني على جزيرتين متصلتين"
	},
	[11008] = {
		Title = "تفقد ضريح أودين",
		Description = {
			"لدي خدمة خاصة أطلبها منك. هل لك أن تأخذ هذا الملف إلى موروك؟"
		},
		Summary = "خذ الملف إلى رفيق آش عند البوابة الجنوبية لموروك"
	},
	[11009] = {
		Title = "طلب موريفين",
		Description = {
			"يسعل موريفين دما، وحالته خطيرة للغاية. اذهب إلى منزله في هويغل واحصل على الدواء من زوجته سيريا."
		},
		Summary = "سيريا في هويغل"
	},
	[11010] = {
		Title = "إحضار الدواء",
		Description = {
			"نفد الدواء للتو. اذهب إلى لايت هالزن واحصل عليه من دونو، صديق موريفين."
		},
		Summary = "دونو في لايت هالزن"
	},
	[11011] = {
		Title = "دواء لشخصين",
		Description = {
			"عليك العثور على ^3355FF‏5 فحم و5 بريغان و5 سايفر وتفاحة غير ناضجة واحدة و3 ديتريمينديكستا و20 صدفة وواحدة من كل من الأعشاب الحمراء والزرقاء والخضراء والبيضاء والصفراء.^000000"
		},
		Summary = "أحضر هذه المواد إلى دونو"
	},
	[11012] = {
		Title = "اعثر على ماكي",
		Description = {
			"هناك شيء مفقود، ولا يمكن صنع الدواء. اعثر على ماكي داخل الحانة المقابلة واحصل على ^ff0000مسحوق ساق النبتة الحمراء^000000."
		},
		Summary = "ماكي"
	},
	[11013] = {
		Title = "مسحوق ساق النبتة الحمراء",
		Description = {
			"اكتشفت أن موريفين ودونو كانا يعملان سابقا في ريكنبر. أحضر أولا مسحوق ساق النبتة الحمراء إلى دونو."
		},
		Summary = "دونو"
	},
	[11014] = {
