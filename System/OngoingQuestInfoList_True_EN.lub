		Summary = "أكشاك الشارع عند الطرف الشرقي من غيفن، بالقرب من الراكون \"بين\""
	},
	[1197] = {
		Title = "انظر من النافذة، هيا نشجع فريق الراكون هوراي!",
		Description = {
			"عثرت على الهدية، وهي جوارب مخططة. عد إلى كاستانيا."
