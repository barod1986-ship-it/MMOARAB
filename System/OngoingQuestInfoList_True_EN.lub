	[17015] = {
		Title = "مذكرة البحث",
		IconName = "ico_ep.bmp",
		Description = {
			"عثرت على يوميات ملطخة بالدماء الحمراء. يصعب قراءة ما كتب فيها، لكن أحد المقاطع يذكر أن الكاتب تعلم استدعاء مخلوق. واصل التحقيق."
