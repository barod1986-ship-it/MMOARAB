	[17000] = {
		Title = "مقابلة الأب بامف",
		IconName = "ico_ep.bmp",
		Description = {
			"أخبرك عميل على المنطاد الدولي بأن الأب بامف ينتظر وصولك إلى كاتدرائية برونتيرا. اذهب لمقابلته هناك."
		},
		Summary = "التحدث مع الأب بامف"
	},
	[17001] = {
		Title = "مقابلة لارجيس",
		IconName = "ico_ep.bmp",
		Description = {
			"أخبرك الأب بامف بأن مسؤولا رفيع المستوى اختفى فجأة منذ فترة، وأن آخر ظهور له كان في كومودو. اعثر على لارجيس ليساعدك في البحث عن المسؤول المفقود."
		},
		Summary = "التحدث مع لارجيس"
	},
	[17002] = {
		Title = "إبلاغ الأب بامف",
		IconName = "ico_ep.bmp",
		Description = {
			"أخبرك لارجيس بأن المسؤول اختطفته منظمة من أرونافلتز. أبلغ الأب بامف بذلك."
		},
		Summary = "التحدث مع الأب بامف",
		RewardEXP = "300000",
		RewardJEXP = "300000"
	},
	[17003] = {
		Title = "السفر إلى راشيل",
		IconName = "ico_ep.bmp",
		Description = {
			"طلب منك الأب بامف الذهاب نيابة عنه إلى راشيل لمواصلة التحقيق في اختفاء المسؤول."
		},
		Summary = "منطاد إزلود المتجه إلى راشيل"
	},
	[17004] = {
		Title = "السفر إلى فينز",
		IconName = "ico_ep.bmp",
		Description = {
			"بعد التنصت على الحديث الدائر بجوار طاولتك، قررت الذهاب إلى فينز لمعرفة ما إن كان بإمكانك العثور على المزيد من سمك الشوكي المخطط من فينز."
		},
		Summary = "فينز"
	},
	[17005] = {
		Title = "القاضي المحبط",
		IconName = "ico_ep.bmp",
		Description = {
			"أخبرك القاضي الحماد بأنه لا يشعر بالارتياح للحديث عن مشكلاته مع غرباء تماما... اعثر على شخص قد يعرف شيئا عن الوضع."
		},
		Summary = "",
		RewardEXP = "300000",
		RewardJEXP = "300000"
	},
	[17006] = {
		Title = "استجواب المهربين",
		IconName = "ico_ep.bmp",
		Description = {
			"اسأل القاضي عما إن كان قد تمكن من استجواب المهربين قبل اقتيادهم بعيدا."
		},
		Summary = "القاضي الحماد"
	},
	[17007] = {
		Title = "الأوامر المكتوبة",
		IconName = "ico_ep.bmp",
		Description = {
			"إن كنت مصرا على معرفة المزيد عن المهربين، فعليك إحضار أمر مكتوب من مسؤول رفيع المستوى إلى الحماد."
		},
		Summary = ""
	},
	[17008] = {
		Title = "التحقيق",
		IconName = "ico_ep.bmp",
		Description = {
			"قال الكاهن المتقدم زيد إنه منشغل جدا بأمور أخرى، لكن الكاهنة المتقدمة نيرين قد تعرف شيئا عن مهربي فينز."
		},
		Summary = "الكاهنة المتقدمة نيرين"
	},
	[17009] = {
		Title = "مزيد من التحقيق",
		IconName = "ico_ep.bmp",
		Description = {
			"طلبت منك الكاهنة المتقدمة نيرين معرفة ما إن كان المسؤول رفيع المستوى من رون ميدغارد لا يزال حيا. اذهب إلى القاضي الحماد، وسيقدم لك معلومات مفيدة لرحلتك."
		},
		Summary = "القاضي الحماد"
	},
	[17010] = {
		Title = "مواصلة التحقيق",
		IconName = "ico_ep.bmp",
		Description = {
			"شرح القاضي الحماد مزيدا من التفاصيل عن تعاملهم مع المهربين والمسؤول رفيع المستوى من رون ميدغارد. سافر إلى فينز واعرف إن كان أحد يعرف شيئا عن اختفائهم."
		},
		Summary = ""
	},
	[17011] = {
		Title = "والد كوردي",
		IconName = "ico_ep.bmp",
		Description = {
			"ذكر السكير شيئا عن شبح في عرض البحر. اسأل والد كوردي عن الأمر، فهو صياد وقد يعرف شيئا."
		},
		Summary = "والد كوردي"
	},
	[17012] = {
		Title = "قارب كارين",
		IconName = "ico_ep.bmp",
		Description = {
			"لا يسمح لوالد كارين بالإبحار حاليا، لكن كارين قالت إن بإمكانك استعارة القارب. إنه القارب الوحيد على الشاطئ الجنوبي، لذا لن يصعب العثور عليه."
		},
		Summary = ""
	},
	[17013] = {
		Title = "إلى الجزيرة",
		IconName = "ico_ep.bmp",
		Description = {
			"كشف لارجيس أنه كان يتعقبك، وعرض مساعدتك على الإبحار إلى الدير. حقق في الجزيرة بعد الوصول إليها."
