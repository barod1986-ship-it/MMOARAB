		Summary = "أحضر 100 بيضة إلى الملك فروغي السابع"
	},
	[5001] = {
		Title = "انتقام الملك فروغي السابع",
		Description = {
			"طلب منك الملك فروغي السابع الانتقام من سايد ويندر التي تواصل هزيمة إخوته الضفادع. اهزم 50 سايد ويندر ثم عد إليه."
