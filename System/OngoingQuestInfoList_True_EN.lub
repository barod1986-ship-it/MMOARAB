		},
		Summary = "فيتر"
	},
	[18023] = {
		Title = "فيتر الجاسوس",
		Description = {
			"اقتادت المخابرات فيتر بتهمة التجسس. عد إلى لاسدا وأخبره بما حدث لفيتر."
		},
		Summary = "لاسدا ميدار"
	},
	[18030] = {
		Title = "لعنة عائلة غيوبورغ",
		Description = {
			"شكرا جزيلا لك! لا تدرك مدى خوفي من تلك المناطيد. هل يمكنك الآن توصيل هذه الكتب إلى ^ff0000السيد كارلوموف^000000 قرب مكتبة يونو؟"
		},
		Summary = "السيد كارلوموف"
	},
	[18031] = {
		Title = "لعنة عائلة غيوبورغ",
		Description = {
			"ستساعدني كثيرا إن سلمت هذا التقرير إليها فورا. اسمها رودافريان، وأنا متأكد من أنك ستعثر عليها في مكان ما داخل تلك المدينة الصحراوية."
		},
		Summary = "رودافريان"
	},
	[18032] = {
		Title = "لعنة عائلة غيوبورغ",
		Description = {
			"اعثر على موندو في جبل ميولنير. أخبره بروايتك للقصة: ابتلعت الأفعى العظيمة البحر. وابتلع نسر قوس قزح الأفعى. ثم بنى النسر عشه، عشا فوق البحر المبتلع."
		},
		Summary = "موندو"
	},
	[18033] = {
		Title = "لعنة عائلة غيوبورغ",
		Description = {
			"إن أردت معرفة المزيد، فحاول العثور على الطفل الذي كان يغني الأغنية. قد يكون قرب ^3131ddالنهر الموجود هنا^000000. آمل ألا يصعب العثور عليه."
		},
		Summary = "فتى شارد الذهن"
	},
	[18034] = {
		Title = "لعنة عائلة غيوبورغ",
		Description = {
			"سلم الأعشاب التي أعطتك إياها المرأة المنهكة إلى الأب بامف في كاتدرائية برونتيرا."
		},
		Summary = "الأب بامف"
	},
	[18035] = {
		Title = "لعنة عائلة غيوبورغ",
		Description = {
			"زر بوني إمبوليا في جبل ميولنير، وحاول معرفة المزيد عن تلك الأغنية أو عما حدث بعد محاولة طرد لعنة يورمونغاند."
		},
		Summary = "بوني إمبوليا"
	},
	[18036] = {
		Title = "لعنة عائلة غيوبورغ",
		Description = {
			"عد إلى كاتدرائية برونتيرا وأخبر الأب بامف بما عرفته من بوني إمبوليا."
		},
		Summary = "الأب بامف"
	},
	[18037] = {
		Title = "لعنة عائلة غيوبورغ",
		Description = {
			"رافقني أيها المغامر إلى موقع المراسم السري للعائلة المالكة. استخدم المفتاح المخفي داخل رف الكتب، وسأقابلك هناك."
		},
		Summary = "المفتاح المخفي"
	},
	[18038] = {
		Title = "لعنة عائلة غيوبورغ",
		Description = {
			"فحصت جثة الابن الأول للملك، ولي العهد. افحص الآن جثة الأمير الثاني."
		},
		Summary = "الأمير الثاني"
	},
	[18039] = {
		Title = "لعنة عائلة غيوبورغ",
		Description = {
			"فحصت جثة الابن الثاني للملك. افحص الآن جثة الأمير الثالث."
		},
		Summary = "الأمير الثالث"
	},
	[18040] = {
		Title = "لعنة عائلة غيوبورغ",
		Description = {
			"أيها المغامر الشجاع، زر نقابة المغتالين في موروك وحاول معرفة طريقة التحقق مما إذا كان السم قد استعمل لقتل الأمراء."
