		Summary = ""
	},
	[8162] = {
		Title = "طلب بابا ياغا",
		Description = {
			"اشتريت الكتب السحرية وأعطيتها إلى بابا ياغا. تحدث معها مجددا لمعرفة إن كانت قد انتهت من صنع المفتاح الذهبي."
		},
		Summary = ""
	},
	[8163] = {
		Title = "طلب بابا ياغا",
		Description = {
			"طلبت منك بابا ياغا إيجاد طريقة لإسكات شبح المنزل الذي يعيش في جرة قرب كوخها، مقابل أن تصنع لك المفتاح الذهبي."
