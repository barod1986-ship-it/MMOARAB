		Summary = "ضمادة متعفنة واحدة"
	},
	[21211] = {
		Title = "عمال أبو الهول",
		Description = {
			"ازدادت طلبات إرنست بعدما بدأ البحث مع العالم المسن. يريد هذه المرة معرفة العلاقة بين الهرم وأبو الهول، لذا طلب منك معاينة ^0000FFزيروم وريكويم^000000 بنفسك وإبلاغه."
