	[8165] = {
		Title = "طلب بابا ياغا",
		Description = {
			"طلبت منك بابا ياغا الذهاب إلى جدة المكانس في بايون وشراء مكنسة لها، مقابل أن تصنع لك المفتاح الذهبي."
		},
		Summary = ""
	},
	[8166] = {
		Title = "طلب بابا ياغا",
		Description = {
			"بعد لعب النرد مع الشجرة الشبحية، حصلت أخيرا على المكنسة التي طلبتها بابا ياغا. عد إليها وأخبرها بأنك نفذت طلبها."
		},
		Summary = ""
	},
	[8167] = {
		Title = "المفتاح الذهبي",
		Description = {
			"حصلت أخيرا على المفتاح الذهبي من بابا ياغا. حان الوقت لتحرير ماريا موريفنا من سجنها داخل ذلك الجدار."
		},
		Summary = ""
	},
	[8168] = {
		Title = "كوشي الخالد",
		Description = {
			"سيعتني الذئب الرمادي بجروح ماريا. عليك فعل كل ما تستطيع لإخضاع كوشي."
		},
		Summary = ""
	},
	[8169] = {
		Title = "ماء الحياة وماء الموت",
		Description = {
			"قال الذئب الرمادي إن بإمكانك إنقاذ ماريا إن حصلت على \"ماء الحياة\" و\"ماء الموت\" من بابا ياغا."
		},
		Summary = ""
	},
	[8170] = {
		Title = "ماء الحياة وماء الموت",
		Description = {
			"لصنع \"ماء الحياة\"، عليك إحضار ماء مقدس واحد وورقتين من إغدراسيل. ولصنع \"ماء الموت\"، عليك إحضار ماء ملعونا واحدا و10 أوراق هينالي."
		},
		Summary = ""
	},
	[8171] = {
		Title = "ماء الحياة وماء الموت",
		Description = {
			"أعطتك بابا ياغا \"ماء الحياة\" و\"ماء الموت\". اذهب إلى ماريا بسرعة. اسكب أولا \"ماء الموت\" لإزالة الجروح واللعنات، ثم اسكب \"ماء الحياة\" لإعادة روحها."
		},
		Summary = ""
	},
	[8172] = {
		Title = "مهمة بابا ياغا",
		Description = {
			"لن أؤذي الناس بعد الآن، وسأعيش بصورة صالحة! سأصبح الروح الحارسة لهذا المنزل! لن أنسى أبدا طيبة قلبك لأنك رافقت مجرد شبح منزل. شكرا لك مرة أخرى من أعماق قلبي."
		},
		Summary = "عد إلى بابا ياغا"
	},
	[8173] = {
		Title = "مهمة بابا ياغا",
		Description = {
			"اشتر لي مكنسة من جدة المكانس في بايون. مكانس بايون هي الأفضل للتنظيف، لكنني لم أجد الوقت للذهاب. هيا! تحرك بسرعة! إن تباطأت فسأعاقبك! إيهيهيهيهيهيهي."
		},
		Summary = "اشتر مكنسة من بايون"
	},
	[8174] = {
		Title = "مهمة بابا ياغا",
		Description = {
			"منذ مدة، سرق دوكيبي جميع المكانس التي صنعتها للتو. يسعدني أنها صنعت بإتقان حتى أعجبته، لكن سرقتها أمر مزعج... ذهب ابني مرات عدة لاستعادتها، إلا أن دوكيبي كان يختبئ داخل الأشجار ويمارس المقالب، فعاد خالي الوفاض."
		},
		Summary = ""
	},
	[8175] = {
		Title = "مهمة بابا ياغا",
		Description = {
			"آه، لقد خسرت. لكنها كانت لعبة ممتعة. بما أننا استمتعنا، فسأعطيك المكنسة كما وعدت. أنت إنسان مسل حقا. العب معي مجددا إن سنحت الفرصة. خذ هذه."
		},
		Summary = "عد إلى بابا ياغا"
	},
	[8176] = {
		Title = "المفتاح الذهبي",
		Description = {
			"لقد وصلت في الوقت المناسب. انتهيت أنا أيضا من صنع \"المفتاح الذهبي\"! خذه واستخدمه لمساعدة ماريا موريفنا. واحذر كوشي. كيهيهيهيهيهيهي."
		},
		Summary = "حرر ماريا موريفنا"
	},
	[8177] = {
		Title = "كوشي الخالد",
		Description = {
			"أرغ... إن تحركنا الآن، فيمكننا إنقاذ ماريا موريفنا. سأحملها وأهرب بها، لذا تول أنت أمر كوشي!"
		},
		Summary = "اقض على كوشي"
	},
	[8178] = {
		Title = "ماء الحياة وماء الموت",
		Description = {
			"ماريا لم تمت بعد، لكنها ليست حية أيضا. لإنقاذها نحتاج إلى \"ماء الحياة\" و\"ماء الموت\". تستطيع بابا ياغا إنقاذها. سأحميها من الموت، فاذهب واحصل من بابا ياغا على \"ماء الحياة\" و\"ماء الموت\"."
		},
		Summary = "أحضر ماء الحياة وماء الموت"
	},
	[8179] = {
		Title = "ماء الحياة وماء الموت",
		Description = {
			"\"ماء الحياة\"... أتذكر أنني سمعت عنه من قبل. يمكن صنعه باستخدام ^0000ffماء مقدس واحد^000000 و^0000ffورقتين من الشجرة التي يتكون منها هذا العالم^000000. أما \"ماء الموت\"، فيمكن صنعه باستخدام ^0000ffماء ملعون واحد^000000 و^0000ff‏10 أوراق من زهرة هينالي^000000."
		},
		Summary = "خذ المواد إلى بابا ياغا"
	},
	[8180] = {
		Title = "ماء الحياة وماء الموت",
		Description = {
			"خذ هذه الأشياء بسرعة وساعد ماريا موريفنا أيها الإنسان الصغير. كيهيهيه. اسكب \"ماء الموت\" أولا على ماريا موريفنا لإزالة الجروح واللعنة. ثم اسكب عليها \"ماء الحياة\"، وستعود إلى الحياة. إن فهمت، فأسرع إليها! كيهيهيهيهي."
		},
		Summary = "اذهب إلى ماريا موريفنا"
	},
	[8181] = {
		Title = "مفجر الرؤية",
		Description = {
			"تبدو مهارة مفجر الرؤية بسيطة، لكنها ليست سهلة التعلم. الفرسان خبراء في أساليب دفع الأعداء إلى الخلف، لذا اذهب إلى مقر فرسان برونتيرا عند اتجاه الساعة 11 على خريطتك المصغرة، واطلب من أحدهم شرح نظرية الدفع."
		},
		Summary = ""
	},
	[8182] = {
		Title = "نظرية الدفع إلى الخلف",
		Description = {
			"شرحت لك أسلوب الدفع بأفضل ما أستطيع. ركز وتدرب على النظرية بنفسك، ثم عد إلى مياو لتكمل تعلم مفجر الرؤية."
		},
		Summary = "عد إلى مياو"
	},
	[8183] = {
		Title = "مفجر الرؤية",
		Description = {
			"لست محسنا، ولذلك أتوقع أجرا مقابل كل هذا التعليم والجهد! أحضر إلى مياو ^ff0000‏10 كريستال أزرق و10 جرين لايف و10 دم أحمر و10 ريح الخضرة^000000."
		},
		Summary = "أحضر المواد إلى مياو"
	},
	[8184] = {
		Title = "إنشاء محول عنصري",
		Description = {
			"أحضر المواد المطلوبة لنصنع محولا عنصريا أساسيا. تحتاج إلى ^ff0000‏7 من هورن و12 صدفة قوس قزح و10 أصداف حلزون و4 لفافات فارغة و10 ذيول عقرب^000000."
		},
		Summary = "عد إلى ميشونا ومعك المواد"
	},
	[8185] = {
		Title = "تغيير العنصر",
		Description = {
			"أصبحت مستعدا لتعلم المهارة الأخرى، ^ff0000تغيير العنصر^000000. تحتاج ميشونا إلى تجهيز الدرس، فعد إليها لاحقا."
		},
		Summary = ""
	},
	[8186] = {
		Title = "تغيير العنصر (نار)",
		Description = {
			"أحضر ^ff0000‏20 من دم أحمر ومحلول بايون واحدا ومحلول موروك واحدا^000000 لتتعلم ^ff0000تغيير العنصر (نار)^000000."
		},
		Summary = "عد إلى ميشونا ومعك المواد"
	},
	[8187] = {
		Title = "تغيير العنصر (أرض)",
		Description = {
			"أحضر ^ff0000‏20 من جرين لايف ومحلول بايون واحدا ومحلول موروك واحدا^000000 لتتعلم ^ff0000تغيير العنصر (أرض)^000000."
		},
		Summary = "عد إلى ميشونا ومعك المواد"
	},
	[8188] = {
		Title = "تغيير العنصر (رياح)",
		Description = {
			"أحضر ^ff0000‏20 من ريح الخضرة ومحلول بايون واحدا ومحلول موروك واحدا^000000 لتتعلم ^ff0000تغيير العنصر (رياح)^000000."
		},
		Summary = "عد إلى ميشونا ومعك المواد"
	},
	[8189] = {
		Title = "تغيير العنصر (ماء)",
		Description = {
			"أحضر ^ff0000‏20 من كريستال أزرق ومحلول بايون واحدا ومحلول موروك واحدا^000000 لتتعلم ^ff0000تغيير العنصر (ماء)^000000."
		},
		Summary = "عد إلى ميشونا ومعك المواد"
	},
	[8190] = {
		Title = "غمزة ساحرة",
		Description = {
			"عليك إحضار ^FF0000مرآة كريستال واحدة^0000000! هذه الأداة ضرورية للدرس، لذا اعثري عليها وأحضريها إلي بسرعة!"
		},
		Summary = "أحضري مرآة كريستال واحدة إلى كانيل"
	},
	[8191] = {
		Title = "المرشدة الساحرة",
		Description = {
			"بعد أن اكتسبت العقلية الصحيحة تجاه الجمال، حان وقت تعلم تقنية متقدمة في الإغراء. اعثري على أختي في كنيسة برونتيرا، وستوافق على تعليمك."
		},
		Summary = ""
	},
	[8192] = {
		Title = "المرشدة الأنانية",
		Description = {
			"أريد شرابا حقيقيا، ^FF0000كحولا^000000. وأحتاج إلى بعض الوجبات الخفيفة للحفاظ على طاقتي أثناء التعليم! أحضري ^FF0000تفاحة واحدة و3 حبات موز و5 قطع بسكويت مخبوز جيدا^000000 مقدمة على ^FF0000صحن صيني^000000."
		},
		Summary = "عودي إلى آيل ومعك الكحول والوجبات"
	},
	[8193] = {
		Title = "المرشدة الأنانية",
		Description = {
			"أسهل الإيماءات وأكثرها رقة وجاذبية على الإطلاق هي ^FF0000الغمزة^000000. لقد أنقذتني في أوقات الأزمات، وإتقانها سيزيد من سحرك."
		},
		Summary = ""
	},
	[8194] = {
		Title = "المرشدة المخمورة",
		Description = {
			"ا-ابتعدي. تحدثي إلى كانيل، أختي... ززززززززز..."
		},
		Summary = ""
	},
	[8195] = {
		Title = "كانيل الطيبة",
		Description = {
			"ينبغي للراقصة الحقيقية أن تكتشف سر الغمز بنفسها. لكن بما أنني امرأة طيبة جدا، فسأتفضل بشرحه لك. هو هو~"
		},
		Summary = ""
	},
	[8196] = {
		Title = "نزاع الاتحاد الثلاثي",
		Description = {
			"يكثر أولئك الباحثون من الشكوى هذه الأيام. إنهم يعانون ضغطا شديدا، وأظن أن على شخص ما الاستماع إلى مشكلاتهم. وبالأخص، يختلف المسؤولون عن ملفات الوثائق كثيرا. ابدأ بالتحدث معهم."
		},
		Summary = ""
	},
	[8197] = {
		Title = "توصيل الوثائق",
		Description = {
			"سلم الملف إلى هيو وهانسين. يتولى هيو وثائق شفارتزفالد، ويتولى هانسين وثائق أرونافلتز. اذهب أولا إلى هيو في مكتب شفارتزفالد، وإلا فسيواصل التذمر."
		},
		Summary = "سلم الوثائق إلى هيو وهانسين، ثم عد إلى ريوسن"
	},
	[8198] = {
		Title = "التقرير إلى مسؤول الأبحاث المشتركة",
		Description = {
			"لقد وقع الأمر بالفعل، وعلي حضور ذلك الاجتماع سواء أعجبني أم لا. هل تسلم هذا إلى مسؤول الأبحاث المشتركة؟ سأستعد للاجتماع في هذه الأثناء."
		},
		Summary = "سلم الوثائق إلى مسؤول الأبحاث المشتركة"
	},
	[8199] = {
		Title = "طلب مسؤول الأبحاث المشتركة",
		Description = {
			"شارك في الاجتماع وتوسط بينهم إن حدثت أي مشكلة! قابل الأشخاص الثلاثة أولا وتحقق من استعدادهم للاجتماع. آمل ألا يكونوا يجهزون أي أسلحة."
		},
		Summary = ""
	},
	[8200] = {
		Title = "طلب ريوسن للوثائق",
		Description = {
			"طلبت شيئا من مكتب أرونافلتز، لكنني لم أتلقه بعد. هل يمكنك الحصول عليه من هانسين؟ أحتاج إليه للاجتماع، لكنه لا يرسله إلي أبدا. لا بد أنه نسيه مجددا!"
		},
		Summary = ""
	},
	[8201] = {
		Title = "الوثيقة المفقودة",
		Description = {
			"لقد فقدتها. أظن أنني أسقطتها في النهر عندما كنت ألعب لعبة البحث عن الكنوز على الجسر! لكن القطط في الجنوب الغربي تستطيع تعليمنا الصيد. ربما يمكننا اصطياد الوثيقة من النهر!"
		},
		Summary = "عد إلى هانسين ومعك الوثيقة التي اصطدتها"
	},
	[8202] = {
		Title = "ترميم الوثيقة",
		Description = {
			"يملك أهل شفارتزفالد موهبة في ترميم أشياء كهذه... لم لا تطلب من هيو ترميمها؟ قد يصرخ بقوة تكسر النوافذ."
		},
		Summary = ""
	},
	[8203] = {
		Title = "ترميم الوثيقة",
		Description = {
			"إنها مبللة بالكامل... يجب تجفيفها أولا وكي تجاعيدها، ثم ترميم النصوص. أحتاج إلى بعض المواد، وعليك مساعدتي. أحضر ^0000ffمروحة شبح قط قابلة للطي واحدة ومقلاة قديمة واحدة وحجر لهب واحدا وحبر حبار واحدا^000000."
		},
		Summary = "أحضر مروحة شبح قط قابلة للطي ومقلاة قديمة وحجر لهب وحبر حبار"
	},
	[8204] = {
		Title = "ريوسن",
		Description = {
			"كان تجليد الملف رخوا جدا، لذلك أعدت ترتيب صفحاته وتجليده بالكامل. سلمه قبل فوات الأوان."
		},
		Summary = ""
	},
	[8205] = {
		Title = "التقرير إلى مسؤول الأبحاث المشتركة",
		Description = {
			"هل تطلب من المسؤول انتظاري قليلا؟ علي العثور على وثيقة أخرى للاجتماع."
		},
		Summary = ""
	},
	[8206] = {
		Title = "اجتماع الباحثين",
		Description = {
			"شارك في الاجتماع."
		},
		Summary = ""
	},
	[8207] = {
		Title = "هانسين بريء",
		Description = {
			"كل ما أردته هو تقريب أولئك الأشخاص من بعضهم وجعلهم أكثر ودا... لكن المشكلات تظهر في كل مرة. هل يمكنك التفكير في طريقة تساعدهم على الانسجام؟"
		},
		Summary = ""
	},
	[8208] = {
		Title = "طلب هانسين",
		Description = {
			"سيكون بخير قريبا، وسيدرك أن الأمر لم يكن مهما إلى هذا الحد. لكن العلاقة بين ريوسن وهيو لا تبدو جيدة إطلاقا. لم لا تساعدهما على الانسجام؟"
		},
		Summary = ""
	},
	[8209] = {
		Title = "تقرير هيو",
		Description = {
			"هذا تقرير رون ميدغارد الذي أخذته معي عندما عمت الفوضى غرفة الاجتماع. هل تسلمه إلى ريوسين؟"
		},
		Summary = ""
	},
	[8210] = {
		Title = "التقرير إلى مسؤول الأبحاث المشتركة",
		Description = {
			"حسنا، يجب أن أنظم اجتماعا آخر بأسرع وقت. هل يمكنك مقابلة المسؤول نيابة عني وتحديد موعد للاجتماع؟"
		},
		Summary = ""
	},
	[8211] = {
		Title = "محاضرة شورانك",
		Description = {
			"هل تتعلم فن استخدام ضربة قوية؟ أؤمن بأن مهارة ضربة قوية هي جوهر فن السيافة!"
		},
		Summary = "أتقن مهارة ضربة قوية وعد إلى شورانك"
	},
	[8212] = {
		Title = "محاضرة شورانك",
		Description = {
			"أرى أنك تفهم بعض أساسيات مهارة ضربة قوية، لكن ذلك لا يزال غير كاف."
		},
		Summary = "أتقن مهارة ضربة قوية وعد إلى شورانك"
	},
	[8213] = {
		Title = "محاضرة شورانك",
		Description = {
			"أرى أنك اكتسبت بعض الخبرة في مهارة ضربة قوية، لكنها لا تزال غير كافية."
		},
		Summary = "أتقن مهارة ضربة قوية وعد إلى شورانك"
	},
	[8214] = {
		Title = "محاضرة شورانك",
		Description = {
			"تلك الثفنات...! لا يملك مثل هذه اليدين إلا من أتقن مهارة ضربة قوية. عمل رائع أيها السياف، لقد أثرت إعجابي."
		},
		Summary = "استمع إلى محاضرة شورانك"
	},
	[8215] = {
		Title = "محاضرة شورانك",
		Description = {
			"أعتقد أنك تعرف الآن ما يكفي عن مهارة زيادة استعادة HP. في المرة القادمة، سأشرح لك مهارة استفزاز."
		},
		Summary = "استمع إلى محاضرة شورانك"
	},
	[8216] = {
		Title = "أمر شورانك",
		Description = {
			"أريدك أن تجد فارسا يدعى ^5D478Bديكوي^000000 في ^5D478Bغيفن^000000. استمع جيدا، فهذه هي الرسالة: ^0000FFماذا حدث للقاتل؟ ^0000FFهل عرفت من هو؟ إن عرفت، فماذا يفترض بنا أن نفعل الآن؟^000000"
		},
		Summary = "سلم رسالة شورانك إلى ديكوي في غيفن"
	},
	[8217] = {
		Title = "رسالة ديكوي",
		Description = {
			"إذن يسأل شورانك: \"ماذا حدث للقاتل؟ هل عرفت من هو؟ إن عرفت، فماذا يفترض بنا أن نفعل الآن؟\" لم نعرف بعد على وجه اليقين من القاتل. ومع ذلك، لدينا قائمة بالمشتبه بهم وسنكشف الحقيقة قريبا."
		},
		Summary = "سلم رسالة ديكوي إلى شورانك في إزلود"
	},
	[8218] = {
		Title = "محاضرة شورانك",
		Description = {
			"أما زلت لم تتعلم استفزاز؟ أطلب منك الآن أن تتدرب على استخدام مهارة استفزاز."
		},
		Summary = "أتقن مهارة استفزاز وعد إلى شورانك"
	},
	[8219] = {
		Title = "محاضرة شورانك",
		Description = {
			"يبدو أن لديك فهما أساسيا لمهارة استفزاز، لكن سأوضح لك بعض التفاصيل لتتقن استخدامها."
		},
		Summary = "أتقن مهارة استفزاز وعد إلى شورانك"
	},
	[8220] = {
		Title = "محاضرة شورانك",
		Description = {
			"أرى أن لديك فهما جيدا لمهارة استفزاز. في المرة القادمة، سأشرح لك ما أعرفه عن مهارة ^5D478Bتحمل^000000. عد إلي عندما تكون مستعدا للتعلم."
		},
		Summary = "استمع إلى محاضرة شورانك"
	},
	[8221] = {
		Title = "محاضرة شورانك",
		Description = {
			"تتيح لك مهارة تحمل مقاومة أثر الهجمات. ستتلقى الضرر، لكن هجمات العدو لن تعيق حركتك كثيرا، مما يسمح لك بالرد أو الهرب عند الحاجة. أريدك الآن أن تتدرب على استخدامها، فهي من المهارات الأساسية لكل سياف."
		},
		Summary = "أتقن مهارة تحمل وعد إلى شورانك"
	},
	[8222] = {
		Title = "أمر شورانك",
		Description = {
			"لدي مرة أخرى مهمة أخرى لك. زر ديكوي في غيفن، إذ يبدو أن لديه أمرا يريد منك تنفيذه. أسرع إليه، ثم عد إلى شورانك بعد تنفيذ ما يطلبه منك."
		},
		Summary = "اذهب إلى ديكوي"
	},
	[8223] = {
		Title = "أمر ديكوي",
		Description = {
			"اذهب إلى موروك واستجوب أربعة مشتبه بهم: ^5D478Bمويترو^000000 و^5D478Bغايل^000000 و^5D478Bهانس^000000 و^5D478Bبانكلي^000000. لن يكون الأمر صعبا. بعد أن تتحدث إليهم جميعا، عد إلى ديكوي وأبلغه بما عرفت."
		},
		Summary = "عد إلى ديكوي بعد العثور على الأدلة في موروك"
	},
	[8224] = {
		Title = "الدليل",
		Description = {
			"TheisWesomeof... حسنا، رائع. كل ما علينا الآن هو معرفة ما تعنيه هذه الرموز. سيكون الأمر صعبا، لكن علينا حلها لأنها الدليل الوحيد الذي نملكه..."
		},
		Summary = ""
	},
	[8225] = {
		Title = "استنتاج ديكوي",
		Description = {
			"حسنا! يبدو أن بانكلي هو القاتل! لا يمكننا الوثوق بالنتيجة بنسبة 100%، لكن الدليل يبدو حاسما. أسرع إلى موروك وراقب بانكلي تحسبا لأي تصرف يائس، وأبلغني فورا إن حدث شيء!"
		},
		Summary = "راقب بانكلي عن كثب في موروك"
	},
	[8226] = {
		Title = "موت بانكلي",
		Description = {
			"-إنه ميت! ارتسمت على وجه بانكلي ملامح حزينة تدعو للشفقة. وما دام اللون باقيا في وجنتيه، فلا بد أنه مات قبل وقت قصير. في صدره جرح طويل وعميق، وتقبض يده اليمنى على سكين مغطى بالدماء.-"
		},
		Summary = "أبلغ ديكوي بموت بانكلي"
	},
	[8227] = {
		Title = "عد إلى شورانك",
		Description = {
			"انتحار...؟ هناك أمر مريب! أما المشتبه بهم الثلاثة الآخرون، فسأكلف أعضاء جمعية السيافين بمراقبتهم. يبدو أن القضية أغلقت حاليا. شكرا مجددا على مساعدتك. عد الآن إلى شورانك، فلا بد أنه ما زال يريد تعليمك فن السيافة."
		},
		Summary = "عد إلى شورانك"
	},
	[8228] = {
		Title = "محاضرة شورانك",
		Description = {
			"ستكون هذه محاضرتي الأخيرة لك. استمع جيدا بينما أحدثك بالتفصيل عن مهارة كسر ماغنوم."
		},
		Summary = "استمع إلى محاضرة شورانك"
	},
	[8229] = {
		Title = "محاضرة غوارنيين",
		Description = {
			"لا تكتمل مهنة التاجر من دون القدرة على حمل البضائع. ارفع مهارة زيادة حد الوزن إلى المستوى 4، ثم عد لمتابعة التدريب."
