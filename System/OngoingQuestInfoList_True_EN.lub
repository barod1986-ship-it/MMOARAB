	[7827] = {
		Title = "طلب خاص لمشاركة الحلاوة 1",
		Description = {
			"تريد <NAVI>تشيري<INFO>prontera,225,346,0,101,0</INFO></NAVI> في كاتدرائية برونتيرا تناول حلوى تشبه باقة الزهور. أعددنا لها كريب حلوا."
