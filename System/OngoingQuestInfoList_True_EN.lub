		Summary = "انتظار العملية"
	},
	[12456] = {
		Title = "آثار إزالة آثار إنقاذ العالم",
		Description = {
			"ما زالت آثار استخدام قوة متجاوزة لإزالة الآثار الناتجة عن إنقاذ العالم باقية عليك."
		},
		Summary = "آثار إزالة آثار إنقاذ العالم"
	},
	[12457] = {
		Title = "لحظة السقوط",
		Description = {
			"اتبع تنين الزمن أوسكار إلى الماضي وشاهد كيف سقطت غلاست هايم، التي كانت يوما أقوى الحصون."
		},
		Summary = "لحظة السقوط"
	},
	[12458] = {
		Title = "ما بعد قصة الجرم",
		Description = {
			"رغم تضحية الملك شميتز، شوهت إنجازاته وانتقلت إلى الأجيال بصورة محرفة."
		},
		Summary = "ذوق التنين"
	},
	[12459] = {
		Title = "امنح أفكار الملك الراحة",
		Description = {
			"ألقى شميتز بنفسه في الجرم لإنقاذ أرواح لا تحصى. لكن قوة الجرم جسدت أفكاره خلال ذلك، وتهدد بترك سجلات مشينة للأجيال اللاحقة. مهمتك هي منح أفكاره الراحة."
		},
		Summary = "اقض على أفكار شميتز"
	},
	[12460] = {
		Title = "آثار السقوط",
		Description = {
			"مشاهدة لحظة السقوط تجربة قاسية مهما كانت الظروف. ما دامت هذه الآثار باقية، لن تتمكن من دخول أو إنشاء ^ff0000تطهير غلاست هايم^000000."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[12461] = {
		Title = "آثار الموت القوي",
		Description = {
			"تترافق هذه الآثار مع آثار السقوط. ما دامت باقية، لن تظهر القوائم المتعلقة بـ ^ff0000تطهير غلاست هايم (المتقدم)^000000 ولن تتمكن من استخدامه."
		},
		Summary = "إعادة الضبط بعد 3 أيام عند الساعة 04:00"
	},
	[12462] = {
		Title = "امنح أفكار الملك الراحة (المتقدم)",
		Description = {
			"ألقى شميتز بنفسه في الجرم لإنقاذ أرواح لا تحصى. لكن قوة الجرم جسدت أفكاره خلال ذلك، وتهدد بترك سجلات مشينة للأجيال اللاحقة. مهمتك هي منح أفكاره الراحة."
		},
		Summary = "اقض على أفكار شميتز (المتقدم)"
	},
	[12470] = {
		Title = "انتقام أندريا I",
		Description = {
			"أصيب أندريا إصابة قاتلة ومات على يد مخلوق صغير لا يصل طوله إلا إلى ركبتيه وكان يلوح بمنجل. يريد منح هذا المخلوق الصغير الذي تسبب في موته الراحة الأبدية نفسها.^ff0000\"لا تنخدع بمظهره اللطيف، فهو أسوأ من الشيطان.\"^000000 لكن يبدو أنه عليك التحقق بنفسك مما إن كان لطيفا حقا."
		},
		Summary = "اقض على بافوميت جونيور الفوضوي",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ ItemID = 25271, ItemNum = 1 }
		}
	},
	[12471] = {
		Title = "انتقام أندريا II",
		Description = {
			"بعد إصابة جسده إصابة قاتلة، حاول أندريا علاج نفسه بقوته الروحية، لكن هذا الكيان الفوضوي قمع روحه وأجبره على التخلي عن إحياء نفسه. يتمنى تطهير هذه الكيانات الشريرة.^ff0000\"ربما تكون روح مغامر مات قبلي بزمن طويل. وإن لم تكن، فما المشكلة؟\"^000000 لا يمكن معرفة ما إن كان أندريا كاهنا عدوانيا إلى هذا الحد في حياته أيضا."
		},
		Summary = "اقض على غوسترينغ الفوضوي",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ ItemID = 25271, ItemNum = 1 }
		}
	},
	[12472] = {
		Title = "انتقام أنيس I",
		Description = {
			"وجهت هذه الحشرة السريعة والشريرة الضربة القاتلة إلى أنيس وهي على وشك الموت. تؤمن أنيس بأن جميع الحشرات المجنحة في هذا العالم يجب أن تباد.^ff0099\"لا تستهينوا بها لمجرد أنها تشبه الذباب. ففرائسها تشمل البشر 'الأحياء' أيضا...\"^000000 يبدو أن بينها وبين هذه الحشرة ذكريات سيئة جدا."
		},
		Summary = "اقض على هنتر فلاي الفوضوي",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ ItemID = 25271, ItemNum = 1 }
		}
	},
	[12473] = {
		Title = "انتقام أنيس II",
		Description = {
			"بينما كانت تائهة، هاجمها هذا المفترس الوحشي بعدما اندفع من بين الشجيرات وأصابها إصابة قاتلة. ولسوء الحظ، وقع ذلك في اللحظة التي كانت على وشك تناول أول قضمة من الشطيرة التي أعدتها منذ الفجر لرحلتها.^ff0099\"عندما تعثر على ذلك الوغد، انزع جميع أرجله وألقها في كومة من الوحل.\"^000000 العبث بوقت طعام أي شخص قد يؤدي إلى عواقب وخيمة."
		},
		Summary = "اقض على كيلر مانتيس الفوضوي",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ ItemID = 25271, ItemNum = 1 }
		}
	},
	[12474] = {
		Title = "انتقام سيلفانو I",
		Description = {
			"يتذكر سيلفانو بوضوح الكائن الذي هاجمه وتركه على شفا الموت. كان عدوه يشبه الوحش الذي هاجم أنيس، لكنه امتلك خصائص مختلفة بوضوح.^ff0077\"ماذا أرادت الأخت أنيس؟ آه، كانت تريد إبادتهم جميعا أيضا. إذن أود أن أطلب الشيء نفسه.\"^000000"
		},
		Summary = "اقض على مانتيس الفوضوي",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ ItemID = 25781, ItemNum = 1 }
		}
	},
	[12475] = {
		Title = "انتقام سيلفانو II",
		Description = {
			"كان سيلفانو على شفا الموت ولم يملك وقتا لإلقاء تعويذة علاج، فحاول استخدام جرعة، لكن هذا الوحش الهلامي كان قد ابتلع جميع الجرعات الموجودة في حقيبته.^ff0077\"ما فائدة ممتلكاتي القديمة الآن؟ ربما لم يبق منها شيء على أي حال. كل ما أتمناه هو ألا يتعرض مغامر آخر للمصير نفسه.\"^000000 تحقيق أمنيته الصغيرة متروك للمغامر التالي."
		},
		Summary = "اقض على بوبورينغ الفوضوي",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ ItemID = 25782, ItemNum = 1 }
		}
	},
	[12476] = {
		Title = "انتقام سيسيليا I",
		Description = {
			"^0000ff\"احذر تلك الأفعى، فهي أشرس بكثير مما تبدو عليه. ستهاجمك في اللحظة التي تشيح فيها بنظرك.\"^000000 عض هذا الوحش سيسيليا عندما جلست للحظة بعد أن أنهكها التعب. وانتشر السم المشل في جسدها بسرعة، فلم تعد قادرة على الحركة.^0000ff\"لن أمنعك إن أردت الاستراحة في المتاهة، لكنني كنت سأتجنب ذلك لو كنت لا أزال حية...\"^000000"
		},
		Summary = "اقض على سايد وايندر الفوضوي",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ ItemID = 25783, ItemNum = 1 }
		}
	},
	[12477] = {
		Title = "انتقام سيسيليا II",
		Description = {
			"بينما كانت سيسيليا عاجزة عن الحركة بسبب السم المشل، اخترقها هذا الوحش الشائك وأصابها إصابة قاتلة.^0000ff\"هل تعرف شعور أن يتعفن جرح أحدثه وتد في جسدك بينما تعجز عن تحريك يديك أو قدميك؟ لو بقيت مشلولة فقط، لربما نجوت! كل ذلك بسبب ذلك الوحش اللعين ذي الأشواك!!\"^000000 من السهل تفهم غضبها."
		},
		Summary = "اقض على ستيم وورم الفوضوي",
		RewardEXP = "1750000",
		RewardJEXP = "1137500",
		RewardItemList = {
			{ ItemID = 25784, ItemNum = 1 }
		}
	},
	[12478] = {
		Title = "تطهير الأفكار الشريرة",
		Description = {
			"هذه مهمة للقضاء على أفكار أحد الكهنة الأربعة الذين يتجولون في المتاهة. نشأت هذه الأفكار عندما تسرب الحقد والكراهية أثناء تطهير الأرواح وتكثفا، ولذلك فهي كيانات ظهرت دون ارتباط بإرادة أصحابها.^ff0000※ لا يمكن تنفيذ هذه المهمة إلا مرة واحدة أسبوعيا.^000000^ff00cc※ قد يتغير هدف التطهير كل أسبوع.^000000"
