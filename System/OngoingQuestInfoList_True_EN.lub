		},
		Summary = ""
	},
	[12007] = {
		Title = "كازيين",
		Description = {
			"طلب منك رجل مسن في لايت هالزن العثور على رجل يدعى كازيين داخل مبنى الشركة لمعرفة إن كان بإمكانك مساعدته."
		},
		Summary = "اعثر على كازيين"
	},
	[12008] = {
		Title = "الباحث غارينز",
		Description = {
			"زر غارينز في مختبر إينبروخ وتأكد من استلامه الطلب. طلب منك كازيين إبقاء الأمر سرا، لذا تصرف بحذر وانتبه لمن تسأله."
		},
		Summary = "اعثر على غارينز في إينبروخ"
	},
	[12009] = {
		Title = "مهمة فاشلة",
		Description = {
			"فشلت في مهمة كازيين لأنك كشفت معلومات أكثر من اللازم. ربما يمنحك فرصة أخرى إن حاولت..."
		},
		Summary = "كازيين"
	},
	[12010] = {
		Title = "ممنوع الدخول",
		Description = {
			"تواجه صعوبة في تجاوز حارس المختبر. أخبر كازيين بما حدث، وإلا فقد لا تتمكن من إنهاء هذه المهمة أبدا."
		},
		Summary = "كازيين"
	},
	[12011] = {
		Title = "ليوزين",
		Description = {
			"اعثر على رجل يدعى ليوزين على المنطاد المخصص للرحلات الدولية. وكما سبق، حافظ على السرية ولا تخبر أحدا عن المهمة."
		},
		Summary = "ليوزين"
	},
	[12012] = {
		Title = "قابل السيد أحمان",
		Description = {
