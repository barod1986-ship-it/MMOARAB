			"يريد شخص من إكلاج مقابلتك. اطلب الاتجاهات من الحارس قرب المخرج الشرقي لساحة إكلاج."
		},
		Summary = "تحدث مع الحارس عند المخرج الشرقي لإكلاج"
	},
	[7415] = {
		Title = "رئيس أركان لافين",
		Description = {
			"قررت مقابلة شخص وفقا لتعليمات حارس إكلاج. إن ضللت الطريق، فاطلب الاتجاهات من الحارس مجددا."
		},
		Summary = "تحدث مع رئيس الأركان"
	},
	[7416] = {
		Title = "انتظار المقابلة",
		Description = {
			"بعد التحدث مع رئيس الأركان، طلبت مقابلة ملك لافين، العمدة جون. بعد انتهاء الانتظار، اطلب المزيد من الاتجاهات من حارس إكلاج."
		},
		Summary = "اطلب الاتجاهات بعد الانتظار"
	},
	[7417] = {
		Title = "طلب كاردوي",
		Description = {
			"لم يستمع العمدة جون إلى حديثك الصادق، بل قال إنه سيستمع إلى المزيد إن قدمت مساهمة أكبر لإكلاج. ساعد أفراد لافين المحتاجين في إكلاج."
		},
		Summary = "اعمل من أجل إكلاج"
	},
	[7418] = {
		Title = "من أجل إكلاج 1",
		Description = {
			"احصل على مواد لتزيين منزل ياي لحارس إكلاج المشغول. يكفي إحضار 5 من كل من قرون هيلسريون والقرون الغامضة وحوافر الخيول."
		},
		Summary = "5 قرون هيلسريون و5 قرون غامضة و5 حوافر خيول"
	},
	[7419] = {
		Title = "من أجل إكلاج 2",
		Description = {
			"قررت توصيل رسائل ضابط اتصال سبلينديد نيابة عن الرسول روي، الذي يواجه مشكلة عند أطراف بيفروست بسبب انقطاع الاتصالات."
		},
		Summary = "ضابط اتصال سبلينديد وصندوق البريد"
	},
	[7420] = {
		Title = "من أجل إكلاج 3",
		Description = {
			"أحضر إلى ليو المحب للحلويات فواكه بينغويكولا المخللة ومربى عسل لوسيولا المصنوعين في سبلينديد. يمكن الحصول عليهما باستخدام العملات في القاعدة المتقدمة."
		},
		Summary = "3 فواكه بينغويكولا مخللة و3 مربى عسل لوسيولا"
	},
	[7421] = {
		Title = "هذا يكفي",
		Description = {
			"أثناء تنفيذ الأعمال المختلفة، وصلتك رسالة من كاردوي. اذهب لمقابلته. يقع مكتبه في الطابق العلوي عند اتباع الطريق الحلزوني."
		},
		Summary = "تحدث مع كاردوي"
	},
	[7422] = {
		Title = "هدية كاردوي",
		Description = {
			"قال كاردوي إنه أعد لك هدية يمكنك استلامها من رئيس الأركان شنايم. ترى ما هي..."
		},
		Summary = "استلم الهدية من شنايم"
	},
	[7423] = {
		Title = "شائعة عن الملك 1",
		Description = {
			"أخبرك ليو أثناء الحديث بأمور مقلقة عن كاردوي. لم يخض في التفاصيل، لكن الأمر يثير القلق."
		},
		Summary = ""
	},
	[7424] = {
		Title = "شائعة عن الملك 2",
		Description = {
			"شارك فوم معلومة غير متوقعة، وهي أن أفراد لافين لا يحبون كاردوي سرا. يشبه ذلك ما بدا أن ليو يخفيه سابقا."
		},
		Summary = ""
	},
	[7425] = {
		Title = "شائعة عن الملك 3",
		Description = {
			"من خلال الحديث مع أفراد لافين، ظهر ارتباط بين استبداد سينيس وكاردوي. الأمر ليس خطيرا جدا، لكن من المؤكد أن الملك الحالي كاردوي ينظر إليه بطريقة مشابهة لسينيس."
		},
		Summary = ""
	},
	[7426] = {
		Title = "شائعة عن الملك 4",
		Description = {
			"يبدو أن كاردوي أصبح مؤخرا العمدة جون وسط الكارثة التي تواجه جنس لافين بأكمله. لا يبدو أنهم يعارضون سياساته تماما، لكنهم لا يوافقون عليها أيضا."
		},
		Summary = ""
	},
	[7427] = {
		Title = "في مثل هذه الأوقات، واجه الأمر مباشرة!",
		Description = {
			"لم يعد من الممكن تفسير حقيقة قلق لافين وخوفهم من كاردوي. ألا ينبغي إبلاغ الشخص المعني بذلك على الأقل؟ ربما يمكنك سماع السبب الحقيقي منه..."
		},
		Summary = "تحدث مع كاردوي"
	},
	[7428] = {
		Title = "منزل ياي البري",
		Description = {
			"احصل على مواد لمنزل ياي الخاص بحارس إكلاج مينوئيل، الذي يقف في موقعه ليلا ونهارا."
