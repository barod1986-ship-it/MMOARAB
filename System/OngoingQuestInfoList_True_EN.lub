	[7103] = {
		Title = "تغيير الوظيفة إلى غيلوتين كروس",
		Description = {
			"مهمتك الأولى هي العثور على شخص غريب في فينز. اسأل داورا في الحانة إن كانت تملك معلومات عنه."
