		Summary = "10 كرات غبار و10 علامات كتب من الأوراق"
	},
	[7438] = {
		Title = "الدعم السري",
		Description = {
			"لم يكشف شنايم شيئا عن عالم السحر الذي يدعمه، وطلب منك نسيان الأمر والتوقف عن البحث. هل يعرف أحد شيئا عنه؟"
		},
		Summary = "ابحث عن معلومات"
	},
	[7439] = {
		Title = "عالم السحر الذي يدعمه شنايم",
		Description = {
