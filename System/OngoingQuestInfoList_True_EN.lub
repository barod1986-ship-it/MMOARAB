		Summary = ""
	},
	[7643] = {
		Title = "قطعة غامضة",
		Description = {
			"عثرت على مكون مجهول في مرافق الأبحاث. أبلغ إيان أتناد."
		},
		Summary = "أبلغ إيان"
	},
	[7644] = {
		Title = "مشغل التسجيلات",
		Description = {
			"تحتاج إلى مشغل تسجيلات لمعرفة محتويات سجل الذاكرة. تعرف القائدة آركوين من فرقة الجنة مكان مشغل التسجيلات."
		},
		Summary = "تحدث مع آركوين"
	},
	[7645] = {
		Title = "قطعة من سجل الذاكرة",
		Description = {
			"تحتاج إلى 5 قطع على الأقل لتشغيل سجل الذاكرة كاملا. اجمع بقية سجلات الذاكرة في مرافق الأبحاث وخذها إلى القائدة آركوين التي وصلت إلى موقع تنقيب فيروس."
		},
		Summary = "5 سجلات ذاكرة"
	},
	[7646] = {
		Title = "تشغيل سجل الذاكرة",
		Description = {
