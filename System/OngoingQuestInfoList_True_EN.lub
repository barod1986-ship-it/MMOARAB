		Summary = "متاع ميت واحد"
	},
	[21220] = {
		Title = "حلم لا ينكسر",
		Description = {
			"ما زال قائد المجموعة ماكسيم ورفاقه يؤمنون بشدة بأنهم سيعثرون على صندوق أزرق قديم بين متعلقات الموتى. طلبوا منك العودة غدا."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[21221] = {
		Title = "كل هذا جزء من الخبرة -1",
		Description = {
			"لتعتاد قبول طلبات الآخرين، تسلمت مهمة للقضاء على ^0000FFبيكو بيكو^000000 و^0000FFموكا^000000 في ^0000FFالحقل جنوب غرب إزلود^000000. يقول المدرب فونتيس إن تبادل المساعدة هو الطريق لتصبح مغامرا حقيقيا."
		},
		Summary = "القضاء على بيكو بيكو وموكا"
	},
	[21222] = {
		Title = "المخلوقات المزعجة",
		Description = {
			"قررت البدء بقبول طلبات سكان المنطقة. أولها مهمة القضاء على بيكو بيكو وموكا التي تدربت عليها سابقا. تكثر الشكاوى منهما في الحقل جنوب غرب إزلود، والجميع يقول إنهما مزعجان."
		},
		Summary = "القضاء على بيكو بيكو وموكا"
	},
	[21223] = {
		Title = "المخلوقات المزعجة (انتظار)",
		Description = {
			"هذه مهمة يومية، ويمكن قبولها وتنفيذها مجددا بعد انتهاء وقت الانتظار. يمكنك قبولها من لوحة مجموعة إيدن أو من المدرب فونتيس في إزلود."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
	[21224] = {
		Title = "كل هذا جزء من الخبرة -2",
		Description = {
			"أحضر المدرب فونتيس هذه المهمة للتدريب. اخرج من إزلود واتجه جنوب غرب أو إلى الجنوب البعيد للقضاء على إغيرا وميتالر. إن سبق لك صيد موكا وبيكو بيكو، فستعرف أن الحقل قريب منهما."
		},
		Summary = "القضاء على إغيرا وميتالر"
	},
	[21225] = {
		Title = "البيضة والجرادة",
		Description = {
			"أحضر المدرب فونتيس هذه المهمة للتدريب. اخرج من إزلود واتجه جنوب غرب أو إلى الجنوب البعيد للقضاء على إغيرا وميتالر. إن سبق لك صيد موكا وبيكو بيكو، فستعرف أن الحقل قريب منهما."
