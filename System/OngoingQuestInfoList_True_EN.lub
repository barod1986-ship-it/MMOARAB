		Summary = ""
	},
	[8164] = {
		Title = "طلب بابا ياغا",
		Description = {
			"بعد لعب الورق مع شبح المنزل، وعدك بأنه سيلتزم الهدوء من الآن. عد إلى بابا ياغا وأخبرها بأنك نفذت طلبها."
		},
		Summary = ""
