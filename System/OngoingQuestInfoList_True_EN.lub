		Summary = ""
	},
	[16141] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"كتب أسفل المزهرية: \"يراقب الأرنب الباب باستمرار. افتح الباب.\""
		},
		Summary = ""
	},
	[16142] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"أصدر الباب الكبير في نهاية الغرفة رنينا، وانفتح الصندوق كاشفا عن مفتاح لعبة. ابحث عن كيهل داخل الزنزانة."
