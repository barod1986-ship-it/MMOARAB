	},
	[7012] = {
		Title = "مطاردة رايان مور",
		Description = {
			"كانت محادثتك مع إكيناسيا من طرف واحد تقريبا. تم تعيينك مساعدا للسيد كيد، لذا اذهب وتحدث معه."
