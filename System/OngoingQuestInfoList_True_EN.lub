		Summary = "تحدث مع كاردوي"
	},
	[7443] = {
		Title = "عرقل البحث!",
		Description = {
			"انتقام صغير. يريد كاردوي وهيسي معرفة ما يبحث فيه أفانت وعرقلة أبحاثه. هل يكون هذا انتقاما بسيطا من الأخوين؟"
		},
		Summary = "عرقل أبحاث أفانت"
	},
	[7444] = {
		Title = "ما الذي كان أفانت يبحث فيه؟",
		Description = {
			"كان أفانت يبحث عن طرق لاستخراج القوة السحرية من الجرم. بما أن هذه معلومات خطيرة، فأعد مواد البحث إلى كاردوي فورا."
