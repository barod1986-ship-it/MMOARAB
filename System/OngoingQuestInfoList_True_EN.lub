	[11025] = {
		Title = "مساعدة السيد زابارو - 3",
		Description = {
			"أعطاك أسبار آلية مشبك لمسي قابل للتمديد والتحرير، أو أيا كان اسمها. خذها إلى العجوز زابارو."
