	[14292] = {
		Title = "آثار مريبة",
		Description = {
			"تعرض مكاننا للتخريب على يد شخص. تظهر آثار أقدام بشرية غير مألوفة بين آثار الحيوانات المبعثرة على الأرض. اتبعها."
		},
		Summary = "التحقيق في الآثار المريبة"
	},
	[14293] = {
		Title = "آثار مريبة",
		Description = {
			"لحسن الحظ، تمتد الآثار المريبة بثبات نحو الشمال الشرقي. تابع السير وراءها."
		},
		Summary = "التحقيق في الآثار المريبة"
	},
	[14294] = {
		Title = "آثار مريبة",
		Description = {
			"تظهر آثار الأقدام بوضوح في الوحل. واصل تعقبها."
		},
		Summary = "التحقيق في الآثار المريبة"
	},
	[14295] = {
		Title = "إلى ألديباران",
		Description = {
			"عثرت مع آثار الأقدام المريبة على إيصال صادر من ألديباران. ربما تجد هناك دليلا يقود إلى الجاني."
		},
		Summary = "إلى ألديباران"
	},
	[14296] = {
		Title = "فرانك هناك",
		Description = {
			"لا بد أن فرانك هو من ترك كل هذه الآثار الطينية! تسأل أين هو؟ لعله يصلح قاربه عند الرصيف الشرقي هناك. أخبره أنني أنتظره."
		},
		Summary = "العثور على فرانك"
	},
	[14297] = {
		Title = "إنه في النزل",
		Description = {
			"أين يمكن لشخص غريب وصل إلى هذه المدينة لأول مرة أن يذهب في منتصف الليل غير النزل؟ اذهب إلى هناك."
		},
		Summary = "إلى النزل"
	},
	[14298] = {
		Title = "يد المساعدة",
		Description = {
			"كان صاحب النزل حازما للغاية، ويبدو أن الحصول على معلومات منه سيكون صعبا. ابحث عن شخص آخر قد يساعدك."
		},
		Summary = "تفقد المنطقة"
	},
	[14299] = {
		Title = "مهمة مفاجئة",
		Description = {
			"إن أردت معرفة مكان الشخص المريب، فأحضر بدلا مني مواد غسول وجه يقال إنه مفيد للتجاعيد: وحدة كحول واحدة، و22 مخلب هاربي، و33 ساقا قصيرة، و44 مرجانا، و55 قرن ماعز. يجب أن تكون الكميات دقيقة!"
		},
		Summary = "مهمة"
	},
	[14300] = {
		Title = "كان قريبا طوال الوقت!",
		Description = {
			"الشخص الذي تبحث عنه موجود في الطابق الثاني. يفترض أنه استيقظ قبل قليل، فاذهب إليه."
		},
		Summary = "اذهب إلى الطابق الثاني"
	},
	[14301] = {
		Title = "وسيلة النقل",
		Description = {
			"وجدت الجاني أخيرا، لكن حالته سيئة جدا. يقول إنه لا يستطيع التحرك خطوة واحدة قبل وصول عربة النقل، لذا عد إلى قائد العشيرة وأبلغه."
		},
		Summary = "إبلاغ القائد"
	},
	[14302] = {
		Title = "إعادة التفتيش",
		Description = {
			"يبدو أن السيد جايد مريب. عد إلى منزله وفتشه سرا مرة أخرى."
		},
		Summary = "إعادة تفتيش منزل السيد جايد"
	},
	[14303] = {
		Title = "تفتيش المنطقة",
		Description = {
			"ينشغل السيد جايد بإعداد الوثائق. استغل الفرصة وفتش المكان. وفقا لما قاله الرجل المريب في ألديباران، فقد وضع شيئا غريبا في العلف. ابحث أولا عن معلف الحيوانات."
		},
		Summary = "تفتيش المنطقة"
	},
	[14304] = {
		Title = "إبلاغ القائد",
		Description = {
			"عثرت على وثيقة مريبة في المعلف القريب. ودع السيد جايد ثم أسرع لإبلاغ قائد العشيرة."
		},
		Summary = "إبلاغ القائد"
	},
	[14305] = {
		Title = "فك رموز الوثيقة",
		Description = {
			"يبدو أن هذه الوثيقة تشرح طريقة صنع العقار المخلوط بالعلف... توجد خبيرة في يونو، فاعرضها عليها. اسمها آيديا، وسمعت أنها في إحدى المدارس."
		},
		Summary = "إلى يونو"
	},
	[14306] = {
		Title = "مواد التجربة",
		Description = {
			"نحتاج إلى عينة لمعرفة طبيعة العلف الذي قدم للحيوانات. تنقصني مواد إعداد العينة، لذا أحضر المذكور في الوثيقة: 20 نابا ساما، و20 مسحوق سم، و80 فطرا خيطيا، و3 منث، وعشبة شديدة المرارة واحدة."
		},
		Summary = "مواد التجربة"
	},
	[14307] = {
		Title = "مواد التجربة",
		Description = {
			"نحتاج إلى عينة لمعرفة طبيعة العلف الذي قدم للحيوانات. تنقصني مواد إعداد العينة، لذا أحضر المذكور في الوثيقة: 20 نابا ساما، و20 مسحوق سم، و50 ورقة حادة، و80 فطرا خيطيا، و3 منث، وعشبة شديدة المرارة واحدة، ورونة ظلام واحدة."
		},
		Summary = "مواد التجربة"
	},
	[14308] = {
		Title = "إبلاغ القائد",
		Description = {
			"كان العقار المخلوط بالعلف مادة تجعل الحيوانات تتصرف بصورة غريبة. أبلغ قائد العشيرة."
		},
		Summary = "إبلاغ القائد"
	},
	[14309] = {
		Title = "تسليم أمر الاستدعاء",
		Description = {
			"علينا معرفة سبب إطعام السيد جايد الحيوانات علفا مخلوطا بهذا العقار. سلم إليه أمر الاستدعاء."
		},
		Summary = "تسليم أمر الاستدعاء"
	},
	[14310] = {
		Title = "العودة إلى ألديباران",
		Description = {
			"بعد تسليم أمر الاستدعاء إلى السيد جايد، عد إلى ألديباران وأحضر اللص."
		},
		Summary = "إلى ألديباران"
	},
	[14311] = {
		Title = "اختفاء الجاني",
		Description = {
			"اختفى الجاني بينما كنت بعيدا لوقت قصير. أبلغ القائد."
		},
		Summary = "إبلاغ القائد"
	},
	[14312] = {
		Title = "إلى إزلود",
		Description = {
			"اقض على بقايا \"جبهة تحرير رون ميدغارد\" المختبئين في إزلود وأحبط خطتهم!!"
		},
		Summary = "القضاء على البقايا"
	},
	[14313] = {
		Title = "إبلاغ القائد",
		Description = {
			"قضيت على جميع بقايا \"جبهة تحرير رون ميدغارد\". عد إلى قائد عشيرة السيف وأبلغه."
		},
		Summary = "إبلاغ القائد"
	},
	[14314] = {
		Title = "من أجل البحث",
		Description = {
			"يحتاج علماء الحيوان إلى نوفوس لأبحاث اللقاح. اقبض على نحو 70 منها. واقض أيضا على 30 من أناكونداك الغاضب و100 من غاليون."
		},
		Summary = "القبض على نوفوس"
	},
	[14315] = {
		Title = "من أجل البحث",
		Description = {
			"يحتاج علماء الحيوان إلى تاتاتشو لأبحاث اللقاح. اقبض على نحو 70 منها، واقض أيضا على 150 من بينغويكولا الظلام المصابة."
		},
		Summary = "القبض على تاتاتشو"
	},
	[14316] = {
		Title = "استراحة لمدة أسبوع",
		Description = {
			"أشعر بإرهاق شديد بعد إنهاء الطلب. ينبغي أن أستريح نحو أسبوع."
		},
		Summary = "استراحة لمدة أسبوع"
	},
	[14317] = {
		Title = "توصيل بسيط جدا",
		Description = {
			"سلم الصندوق الصغير جدا إلى السيد أوتو في نزل هوغل، والصندوق الخفيف إلى السيد سليدر في المبنى خلف فندق إينبروخ، والوثيقة إلى السيد بوكيت B في وادي الهاوية. ابدأ بوادي الهاوية لأنه الأقرب. بالتوفيق!"
		},
		Summary = "توصيل بسيط"
	},
	[14318] = {
		Title = "مهمة",
		Description = {
			"اعتبرها طلبا وأحضر ما أقوله: 35 أنبوبا، و77 برغيا صدئا، و20 مخلب هاربي، وقطعة فولاذ واحدة. أسرع، أنا مستعجل. قلت إنني مستعجل."
		},
		Summary = "مهمة بسيطة"
	},
	[14319] = {
		Title = "توصيل إضافي",
		Description = {
			"سلم هذا الصندوق إلى بوكيت A في إينبروخ. تعامل مع الصندوق بحذر."
		},
		Summary = "توصيل إضافي"
	},
	[14320] = {
		Title = "القطع الناقصة",
		Description = {
			"تسلمت الصندوقين اللذين أوصلتهما، لكن بعض القطع لا تزال ناقصة. أحضر طحلبا واحدا مبللا بندى الصباح، و3 سوائل فلورية، و35 غازا ساما، و20 برغيا صدئا. يمكنك الحصول عليها، صحيح؟"
		},
		Summary = "القطع الناقصة"
	},
	[14321] = {
		Title = "إلى لايت هالزن",
		Description = {
			"سلم هذا الصندوق إلى السيد لينك في لايت هالزن. قال إنه يعمل في مكان مليء بالعقاقير. احذر من هز الصندوق."
		},
		Summary = "إلى لايت هالزن"
	},
	[14322] = {
		Title = "قطع لإعادة التجميع",
		Description = {
			"يبدو أن الشخص الذي جمعه في البداية كان مستعجلا جدا. توجد قطع كثيرة ناقصة. أحضر 99 فطرا خيطيا، وحبة واحدة من رمل نجوم الساحرة، ومطرقتين من أوريدكون."
		},
		Summary = "القطع الناقصة"
	},
	[14323] = {
		Title = "قطع لإعادة التجميع",
		Description = {
			"توجد قطع كثيرة ناقصة. أحضر 99 فطرا خيطيا، وحبة واحدة من رمل نجوم الساحرة، ومطرقتين من أوريدكون، و33 صفيحة حديدية قديمة. الكمية كبيرة قليلا، أليس كذلك؟"
		},
		Summary = "القطع الناقصة"
	},
	[14324] = {
		Title = "سلم الصندوق",
		Description = {
			"هل يمكنك إيصال هذا الصندوق إلى السيد أوتو في هوغل؟ أود الذهاب بنفسي، لكنهم قالوا إنه يقيم في النزل هذه الأيام."
		},
		Summary = "إلى هوغل"
