	[3010] = {
		Title = "تغيير الوظيفة إلى فارس صليبي",
		Description = {
			"التحمل - \"التحمل والصبر من أهم صفات الفارس الصليبي. سر عبر الممر حتى نهايته، ولا تهزم أي وحش مهما هاجمك.\""
