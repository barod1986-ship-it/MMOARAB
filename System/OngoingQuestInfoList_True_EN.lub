		Summary = "إلى السيدة غوتي"
	},
	[14135] = {
		Title = "البحث عن السيد بومبي",
		Description = {
			"لم تعرف السيدة غوتي الكثير عن مكان فرد لافين رفيع المستوى، لكن جارها السيد بومبي قال إنه رأى فردا من لافين في الحقل ثم اختفى. اسأل السيد بومبي عن التفاصيل."
