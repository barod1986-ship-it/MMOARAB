		Summary = ""
	},
	[7437] = {
		Title = "طلب شنايم",
		Description = {
			"لم تحصل على معلومات عن أفانت، لكنك تلقيت بدلا منها طلبا غريبا من شنايم. طلب جمع مواد تجارب لعالم السحر الذي يدعمه: 10 كرات غبار و10 علامات كتب من الأوراق."
