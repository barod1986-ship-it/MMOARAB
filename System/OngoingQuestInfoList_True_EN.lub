		Summary = "احصل على المواد التي طلبتها هوا تو"
	},
	[11058] = {
		Title = "الصبي الجبان ميخائيل",
		Description = {
			"كسر صغيرنا ميخائيل دمية الماتريوشكا التي كنت أعتز بها أثناء غيابي عن المنزل. ثم هرب خوفا من العقاب، ولم يعد حتى الآن."
		},
		Summary = "ابحث عن ميخائيل. يقال إنه لم يغادر القرية"
	},
	[11059] = {
		Title = "الصبي الجبان ميخائيل",
		Description = {
			"هيه هيه. ذلك الصبي أحمق ولا يملك أصدقاء. لكن إن سألت عن أحد سكان القرية، فإن ^0000FFصاحبة نزل شجرة التفاح^000000 كانت تدلل ميخائيل وتصفه باللطيف."
		},
		Summary = "اذهب إلى نزل شجرة التفاح، فهو الدليل الوحيد"
	},
	[11060] = {
		Title = "الصبي الجبان ميخائيل",
		Description = {
			"لو كنت نزيلا لكان الأمر مختلفا، لكن تقديم المساعدة الخيرية لمسافر عابر يجعلني أشعر بالخسارة. إن وعدتني بقضاء ليلة في نزلنا، فسأخبرك بالمعلومات التي تريدها. ما رأيك؟"
		},
		Summary = "اقض ليلة في النزل واسأل صاحبته عن ميخائيل"
	},
	[11061] = {
		Title = "الصبي الجبان ميخائيل",
		Description = {
			"بدا وجهه شاحبا وكأنه كسر شيئا ثمينا، وقال إنه يحتاج إلى مادة لاصقة قوية. أخبرته بأن الحانة مليئة بالرجال، ونصحته بالذهاب إليها."
		},
		Summary = "يبدو أن ميخائيل ذهب إلى الحانة. اذهب إليها وابحث عنه"
	},
	[11062] = {
		Title = "الصبي الجبان ميخائيل",
		Description = {
			"لا أعرف الكثير عن المواد اللاصقة. لكنني أعرف شخصا خبيرا بها، ولذلك عرفته به. إنه الرجل الموجود في زاوية الحانة، فيكتور."
		},
		Summary = "يبدو أن ميخائيل ليس في الحانة. اسأل فيكتور الذي أرشدك إليه صاحب الحانة"
	},
	[11063] = {
		Title = "الصبي الجبان ميخائيل",
		Description = {
			"تفضل، وصل مشروبك. أتمنى لك وقتا ممتعا."
		},
		Summary = "اشرب المشروب وحاول الاقتراب من فيكتور"
	},
	[11064] = {
		Title = "الصبي الجبان ميخائيل",
		Description = {
			"يمكن الحصول على مواد صنع اللاصق القوي من مستنقع في منطقة نائية لا تصل إليها إلا بعد رحلة طويلة بالسفينة. هل تظن أن ذلك الطفل المرتعب لمجرد كسره دمية ماتريوشكا يملك الشجاعة لدخول ذلك المكان المخيف؟"
		},
		Summary = "إلى أين ذهب ميخائيل؟ ربما ينبغي تفقد ذلك المستنقع احتياطا"
	},
	[11065] = {
		Title = "الصبي الجبان ميخائيل",
		Description = {
			"ترى مستنقعا ضخما يجعلك تشعر باللزوجة بمجرد النظر إليه. تتصاعد منه فقاعات داكنة، وتبدو أجواؤه مرعبة للغاية."
		},
		Summary = "لا توجد آثار تدل على مجيء أحد. عد إلى منزل ميخائيل"
	},
	[11066] = {
		Title = "الصبي الجبان ميخائيل",
		Description = {
			"بعد تفتيش المنزل مجددا، عثرت على ميخائيل مختبئا داخل الموقد. أحضر اللاصق وساعده على إصلاح دمية الماتريوشكا."
		},
		Summary = "اذهب إلى فيكتور في حانة الجدول واسأله عن مواد اللاصق الدقيقة"
	},
	[11067] = {
		Title = "الصبي الجبان ميخائيل",
		Description = {
			"توجد جزيرة كبيرة قرب موسكوفيا. توغل داخل غابتها حتى تصل إلى مستنقع، واجمع منه ^0000FF‏10 أعشاب لاصقة^000000. ولا تنس إحضار ^0000FFوعاء دواء واحد^000000."
		},
		Summary = "اجمع 10 أعشاب لاصقة وعد إلى فيكتور. لا تنس إحضار وعاء الدواء!"
	},
	[11068] = {
		Title = "الصبي الجبان ميخائيل",
		Description = {
			"حسنا، انتهيت! لقد أعطيتك اللاصق، لذا ستتوقف عن إزعاجي الآن، صحيح؟ اذهب بسرعة!"
		},
		Summary = "حصلت على اللاصق. عد إلى ميخائيل وسلمه إليه"
	},
	[11069] = {
		Title = "الصبي الجبان ميخائيل",
		Description = {
			"حسنا، سأذهب لإعادة دمية الماتريوشكا إلى أمي."
		},
		Summary = "خرج ميخائيل من الموقد. عد إلى غاليا"
	},
	[11070] = {
		Title = "ملك السموم",
		Description = {
			"لماذا تريد التعلم عنه؟ حتى لو أردت تعليمك، فقد كبرت في السن ولم أعد أتذكر كل شيء. اعثر على آخر تلاميذي، ^0000FFسونغ تشي دو^000000، فربما يخبرك بشيء مفيد."
		},
		Summary = "اعثر على سونغ تشي دو في عيادة الطبيب واسأله عن استخدام السم"
	},
	[11071] = {
		Title = "ملك السموم",
		Description = {
			"اذهب وافعل ما كنت ستفعله. أشعر بخيبة أمل فحسب..."
		},
		Summary = "يبدو أن سونغ تشي دو غاضب. ربما يمكنك تحسين مزاجه بإحضار شيء إليه"
	},
	[11072] = {
		Title = "ملك السموم",
		Description = {
			"إن كنت تشعر بالأسف تجاهي حقا، فعليك مساعدتي على الانتقام! أحضر لي ^0000FF‏4 إبر نحل و10 أنياب سامة و10 زجاجات جرعات فارغة و30 جرعة خضراء^000000."
		},
		Summary = "عد إلى سونغ تشي دو ومعك المواد التي طلبها"
	},
	[11073] = {
		Title = "ملك السموم",
		Description = {
			"لم يتبق سوى صنع هذا السم، ثم جعل حاكم لويانغ يشربه..."
		},
		Summary = "تحدث معه مجددا واستمع إلى القصة، ثم نفذ طلب سونغ تشي دو"
	},
	[11074] = {
		Title = "ملك السموم",
		Description = {
			"بعد دفع الرسوم، خذ هذا إلى سونغ تشي دو."
		},
		Summary = "حصلت على المادة. عد إلى سونغ تشي دو"
	},
	[11075] = {
		Title = "ملك السموم",
		Description = {
			"لا!! لقد فشلت مجددا! وقد قضيت وقتا طويلا في تجهيز كل تلك المواد..."
		},
		Summary = "تحتاج إلى المزيد من المواد"
	},
	[11076] = {
		Title = "ملك السموم",
		Description = {
			"تسلل إلى قلعة التنين. أريد منك وضع هذا السم في مكان قد يقيم فيه السيد باي لونغ. على أي حال، أنا واثق بأن معلمي سيسعد عندما يعرف أنني صنعت أخيرا ^0000FFالسم الذي كان يتمنى صنعه^000000!"
		},
		Summary = "ماذا ينبغي أن أفعل؟"
	},
	[11077] = {
		Title = "ملك السموم",
		Description = {
			"عثرت على زجاجة شراب قد تكون ملكا لباي لونغ، حاكم لويانغ. وضعت السم القاتل داخل الزجاجة."
		},
		Summary = "نفذت طلب سونغ تشي دو. عد إليه"
	},
	[11078] = {
		Title = "ملك السموم",
		Description = {
			"أخبرت ناغاش آرسيس بكيفية صنع سونغ تشي دو زجاجة السم القاتل وبخطته للانتقام من حاكم لويانغ."
		},
		Summary = "يبدو أنه يحتاج إلى بعض الوقت بمفرده"
	},
	[11079] = {
		Title = "ملك السموم",
		Description = {
			"أتوسل إليك، لا تسمح له بإيذاء الحاكم. أنا متأكد من أنه يطلب مساعدتك ومساعدة الآخرين أيضا... أوقفه قبل أن ينفذ خطته."
		},
		Summary = "تخلص من زجاجة شراب باي لونغ"
	},
	[11080] = {
		Title = "ملك السموم",
		Description = {
			"أخذت زجاجة الشراب واستبدلتها بزجاجة ممتلئة بالمخاط اللزج. آمل ألا يلاحظ باي لونغ!"
		},
		Summary = "نجح الاستبدال! عد إلى ناغاش آرسيس"
	},
	[11081] = {
		Title = "ملك السموم",
		Description = {
			"هذه مذكرات كتبتها طوال 15 عاما عن شعوري بالذنب وحقيقة ما حدث في الماضي. آمل أن تسلمها إلى الحاكم نيابة عني."
		},
		Summary = "سلم مذكرات ناغاش آرسيس إلى الحاكم"
	},
	[11082] = {
		Title = "ملك السموم",
		Description = {
			"خذ هذا عربون امتنان مني. وأرجو أن تسلم هذه الرسالة إلى ناغاش وسونغ تشي دو."
		},
		Summary = "سلمت المذكرات. سلم الرسالة إلى ناغاش"
	},
	[11083] = {
		Title = "ملك السموم",
		Description = {
			".....أوه~ شكرا لك، شكرا جزيلا!"
		},
		Summary = "يبدو أن ناغاش آرسيس راض. أخبر سونغ تشي دو بالخبر"
	},
	[11084] = {
		Title = "البيئة الجديدة",
		Description = {
			"تعرف على بيئتك الجديدة بالتحدث مع المدرب لوغن. سيساعدك على التأقلم."
		},
		Summary = "قابل المدرب لوغن"
	},
	[11085] = {
		Title = "البيئة الجديدة",
		Description = {
			"عليك التسجيل في فريق الاستطلاع لدى موظفة الاستقبال داخل المبنى الكبير الواقع في وسط المعسكر."
		},
		Summary = "قابل موظفة الاستقبال"
	},
	[11086] = {
		Title = "البيئة الجديدة",
		Description = {
			"لا يمكنك سوى افتراض أن موظفة الاستقبال الغريبة قد سجلتك."
		},
		Summary = "عد إلى المدرب لوغن"
	},
	[11087] = {
		Title = "إصلاح الخيمة",
		Description = {
