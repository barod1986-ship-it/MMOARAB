	[7565] = {
		Title = "عودة رايان مور",
		Description = {
			"عثر على الصدع البعدي اعتمادا على معلومات رايان مور. اكتشف حاله أثناء احتجازه في إكلاج."
		},
		Summary = "تحدث مع رايان مور"
	},
	[7566] = {
		Title = "مسافر الأبعاد",
		Description = {
			"صنعت الأجهزة البعدية خصيصا لدخول الصدع البعدي بين الزمان والمكان."
		},
		Summary = ""
	},
	[7568] = {
		Title = "استكشاف البرج",
		Description = {
			"طلب منك استكشاف برج ثاناتوس عبر الصدع البعدي."
		},
		Summary = ""
	},
	[7569] = {
		Title = "علاج المصابين",
		Description = {
			"عالج الجنود المصابين باستخدام حقائب الإسعافات الأولية."
		},
		Summary = ""
	},
	[7570] = {
		Title = "دمر الشياطين!",
		Description = {
			"تغزو الشياطين المكان من الطابق العلوي. تخلص من الظلال الشريرة المهاجمة، ودمر 7 من كل نوع."
		},
		Summary = "دمر الشياطين"
	},
	[7571] = {
		Title = "بعثة البرج",
		Description = {
			"بنت قبيلة من الشياطين يقودها شخص يدعى ثاناتوس هذا البرج خلال حرب بين الآلهة والشياطين. فعله ساتان موروك في محاولة للعودة إلى رون ميدغارد."
		},
		Summary = ""
	},
	[7572] = {
		Title = "لوسيل...؟",
		Description = {
			"طلبت منك لوسيل، الفتاة الغامضة في برج الشياطين، مساعدتها على استعادة جسدها."
		},
		Summary = "ساعد لوسيل"
	},
	[7573] = {
		Title = "ثاناتوس المبارز السحري",
		Description = {
			"يجب على ثاناتوس المبارز السحري منع أختام الشيطان السحرية من الاقتراب كي يتمكن من ختم ساتان موروك بنجاح."
		},
		Summary = "تخلص من الأختام السحرية"
	},
	[7574] = {
		Title = "برج ثاناتوس",
		Description = {
			"سمي برج ثاناتوس لأن المبارز السحري ختم فيه قوة ساتان موروك منذ مئات السنين."
		},
		Summary = ""
	},
	[7575] = {
		Title = "الأتباع الأشرار",
		Description = {
			"دمر الأتباع الأشرار."
		},
		Summary = ""
	},
	[7576] = {
		Title = "ختم قلعة موروك",
		Description = {
			"بعد سنوات من الآن، سيحاول شخص إيقاظ ساتان موروك في قلعة موروك بعد ختم برج ثاناتوس."
		},
		Summary = ""
	},
	[7577] = {
		Title = "تشوه الزمكان (انتظار)",
		Description = {
			"يتسبب استكشاف الزمان والمكان في اضطراب جسدك. عليك أخذ استراحة وإلا فقدت عقلك."
		},
		Summary = "انتظر انتهاء المؤقت قبل الدخول مجددا"
	},
	[7578] = {
		Title = "الصندوق الهائج",
		Description = {
			"اجتاحت حوض اللهب صناديق متحركة ذات نوايا عدائية. أخضع الصناديق وحدد هويتها."
		},
		Summary = "صندوق براديوم واحد"
	},
	[7579] = {
		Title = "جمع البراديوم",
		IconName = "ico_dq.bmp",
		Description = {
			"تلك الصناديق الهائجة هي صناديق براديوم مسحورة. أخضعها واجمع صناديق البراديوم."
		},
		Summary = "10 صناديق براديوم"
	},
	[7580] = {
		Title = "الجمع كل يوم",
		IconName = "ico_dq.bmp",
		Description = {
			"قررت جمع صناديق البراديوم يوميا لمحاولة إفشال مخطط تشيشاير. عد إلى هاسرانتا غدا."
		},
		Summary = "انتظر يوما واحدا"
	},
	[7581] = {
		Title = "إزالة المخاطر",
		IconName = "ico_dq.bmp",
		Description = {
			"يعد تابع موروك الناري وتابع موروك المشوه وتابع موروك الجليدي أكبر تهديد لعملية الإخضاع. تخلص منهم."
		},
		Summary = ""
	},
	[7582] = {
		Title = "التطهير اليومي",
		IconName = "ico_dq.bmp",
		Description = {
			"اتركهم حاليا لبقية المشاركين في الإخضاع. لقد استحققت الراحة."
		},
		Summary = "انتظر يوما واحدا"
	},
	[7583] = {
		Title = "جمع المانا",
		IconName = "ico_dq.bmp",
		Description = {
			"طلب منك أفانت، عالم سحر لافين، جمع بلورات المانا من الشياطين القوية بصورة غير طبيعية. يمكن تنفيذ هذه المهمة مع مهمة التحالف، إزالة المخاطر."
		},
		Summary = "3 بلورات مانا",
		NpcSpr = "4_M_FAIRYAVANT",
		NpcNavi = "moro_vol",
		NpcPosX = 98,
		NpcPosY = 107,
		RewardEXP = "350000",
		RewardJEXP = "350000"
	},
	[7584] = {
		Title = "معركة لا تنتهي",
		IconName = "ico_dq.bmp",
		Description = {
			"تستنزف الشياطين المانا للحفاظ على قوتها. قررت العودة إلى أفانت يوميا لمساعدته على جمع بلورات المانا."
		},
		Summary = "انتظر يوما واحدا",
		NpcSpr = "4_M_FAIRYAVANT",
		NpcNavi = "moro_vol",
		NpcPosX = 98,
		NpcPosY = 107
	},
	[7585] = {
		Title = "نحتاج إلى الحرير - 1",
		Description = {
			"لا يستطيع دو ريان ومارك إيشا وماغي سكين صنع الهانبوك بسبب نقص القماش. احصل من سيلتاري في متجر الأقمشة على أي قماش أو حرير فائض لديه."
		},
		Summary = "تحدث مع سيلتاري في متجر الأقمشة"
	},
	[7586] = {
		Title = "نحتاج إلى الحرير - 2",
		Description = {
			"قال سيلتاري إنه لا يملك قماشا فائضا يمكنه منحه بعد استثناء البضاعة المخصصة للبيع. أخبر الثلاثة بذلك."
		},
		Summary = "تحدث مع مارك إيشا"
	},
	[7587] = {
		Title = "إليزابيث والحرير",
		Description = {
			"أثناء تجهيز ^0000FFإليزابيث^000000، اذهب إلى وكر الثعبان الحريري الذي اكتشفه دو ريان واحصل على الحرير. يمكن دخول الوكر عبر بركة قرية الرماة."
		},
		Summary = "10 قطع حرير مقرمش"
	},
	[7588] = {
		Title = "الحرير اليوم أيضا!",
		Description = {
			"طلب منك اليوم أيضا جمع الحرير المقرمش من وكر الثعبان الحريري. يقال إن مداخل الوكر توجد عند بركة قرية الرماة وعلى ضفة الماء غرب برونتيرا."
		},
		Summary = "10 قطع حرير مقرمش"
	},
	[7589] = {
		Title = "إليزابيث!",
		Description = {
			"إذا أنت إليزابيث!"
		},
		Summary = ""
	},
	[7590] = {
		Title = "أرجوك نظفي المكان!",
		Description = {
			"يا إليزابيث، تخلصي من الجلود المتساقطة المنتشرة في أنحاء الوكر من أجلي."
		},
		Summary = ""
	},
	[7591] = {
		Title = "التنظيف باستمرار",
		Description = {
			"يا إليزابيث... يجب المواظبة على التنظيف كل يوم. عودي في الوقت نفسه غدا."
		},
		Summary = "استريحي ليوم واحد"
	},
	[7592] = {
		Title = "متانة الحرير",
		Description = {
			"الحرير المقرمش ممتاز للتدريب! لكن الملابس الجميلة ضعيفة جدا وتتلف بسرعة، لذا لنحصل على المزيد من الحرير غدا!"
		},
		Summary = "عد مجددا!"
	},
	[7593] = {
		Title = "إخضاع إله الشياطين",
		Description = {
			"حان وقت إنهاء المهمة: اهزم موروك في معبد إله الشياطين."
		},
		Summary = ""
	},
	[7594] = {
		Title = "عنكبوت الصقيع وذئب النار",
		Description = {
			"اهزم مخلوقات موروك وأتباعه: عنكبوت الصقيع برينارانيا وذئب النار موسبيلسكول."
		},
		Summary = ""
	},
	[7595] = {
		Title = "سحر الجرم المتجول",
		Description = {
			"استعد المانا المسروقة من إغدراسيل والجرم: اضرب مانا البريق ومانا الحياة ومانا الأرض وبددها."
		},
		Summary = "",
		NpcSpr = "4_M_FARIY_HISIE",
		NpcNavi = "moro_vol",
		NpcPosX = 95,
		NpcPosY = 108,
		RewardEXP = "1000000",
		RewardJEXP = "500000",
		RewardItemList = {
			{ ItemID = 22567, ItemNum = 1 }
		}
	},
	[7596] = {
		Title = "شروط دخول الضيوف",
		Description = {
			"تحتاج إلى مفتاح لدخول معبد إله الشياطين. اهزم حارسي البوابة آهات وشنايم، واستخدم روحيهما لفتح مدخل المعبد."
		},
		Summary = "روح آهات واحدة وروح شنايم واحدة"
	},
	[7597] = {
		Title = "سقوط الإله الزائف",
		Description = {
			"هزمت إله الشياطين موروك، الذي أراد إنشاء عالم جديد وتنصيب نفسه إلها. أبلغ القائد هيفا أجيب."
		},
		Summary = "أبلغ القائد",
		NpcSpr = "4_M_REDSWORD",
		NpcNavi = "moro_vol",
		NpcPosX = 108,
		NpcPosY = 88,
		RewardEXP = "1000000",
		RewardJEXP = "500000",
		RewardItemList = {
			{ ItemID = 22567, ItemNum = 1 }
		}
	},
	[7598] = {
		Title = "الإله المسجون",
		Description = {
			"سجن إله الشياطين في عالمه، ولعن بالمعاناة إلى الأبد. عد غدا وخلصه من بؤسه مرة أخرى."
		},
		Summary = "عد غدا"
	},
	[7599] = {
		Title = "صيد لا ينتهي",
		Description = {
			"يستمر الصيد حتى هزيمة جميع الشياطين في معبد إله الشياطين. طلب منك المساعد أبيدال العودة بعد أن تستريح تماما."
		},
		Summary = "عد غدا"
	},
	[7600] = {
		Title = "غد واعد",
		Description = {
			"فقد جرم إكلاج وإغدراسيل كمية كبيرة من المانا، ولذلك ستستمر عملية جمعها حتى استعادة معظمها. استرح وعد إلى هيسي قبل التوجه إلى معبد إله الشياطين."
		},
		Summary = "عد غدا",
		NpcSpr = "4_M_FARIY_HISIE",
		NpcNavi = "moro_vol",
		NpcPosX = 95,
		NpcPosY = 108
	},
	[7601] = {
		Title = "المرحلة الأولى من معبد إله الشياطين",
		Description = {
			"اهزم عنكبوت الصقيع برينارانيا للانتقال إلى المنطقة التالية."
		},
		Summary = ""
	},
	[7602] = {
		Title = "اكتملت المرحلة الأولى من معبد إله الشياطين",
		Description = {
			"هزمت عنكبوت الصقيع برينارانيا."
		},
		Summary = ""
	},
	[7603] = {
		Title = "المرحلة الثانية من معبد إله الشياطين",
		Description = {
			"اهزم ذئب النار موسبيلسكول للانتقال إلى المنطقة التالية."
		},
		Summary = ""
	},
	[7604] = {
		Title = "اكتملت المرحلة الثانية من معبد إله الشياطين",
		Description = {
			"هزمت ذئب النار موسبيلسكول."
		},
		Summary = ""
	},
	[7605] = {
		Title = "بركة الحارس",
		Description = {
			"لم ينته عقدك الأخير مع الحارس بعد. لا يمكنك إبرام عقد جديد حتى ينتهي."
		},
		Summary = ""
	},
	[7606] = {
		Title = "توظيف منقبي فانتازماغوريكا",
		Description = {
			"توسعت أطلال جوبييروس. انضم إلينا لاستكشاف منطقة فانتازماغوريكا المكتشفة حديثا!"
		},
		Summary = ""
	},
	[7607] = {
		Title = "قائدة مجموعة إيدن",
		Description = {
			"ظهرت <NAVI>قائدة مجموعة إيدن<INFO>moc_para01,133,170,0,101,0</INFO></NAVI>. تريد التحدث معك بشأن فانتازماغوريكا. اذهب إلى أبعد غرفة على اليسار في الطابق الثاني."
		},
		Summary = "تحدث مع قائدة مجموعة إيدن",
		NpcSpr = "4_F_EDEN_MASTER",
		NpcNavi = "moc_para01",
		NpcPosX = 133,
		NpcPosY = 170
	},
	[7608] = {
		Title = "فريق تنقيب أتناد - 1",
		Description = {
			"طلبت منك قائدة مجموعة إيدن التحدث مع <NAVI>لايم إيفينور<INFO>moc_para01,38,175,0,101,0</INFO></NAVI> في مكتب الموظفين بشأن الانضمام إلى مشروع التنقيب. يقع مكتب الموظفين في الغرفة المجاورة."
		},
		Summary = "تحدث مع لايم في مكتب الموظفين",
		NpcSpr = "4_F_EDEN_OFFICER",
		NpcNavi = "moc_para01",
		NpcPosX = 38,
		NpcPosY = 175
	},
	[7609] = {
		Title = "فريق تنقيب أتناد - 2",
		Description = {
			"استخدم دهليز جوبييروس للانتقال إلى المنطقة المكتشفة حديثا. لا تنس التسجيل لدى <NAVI>مركز القيادة المركزي<INFO>verus04,182,168,0,101,0</INFO></NAVI> فور وصولك. أخبرها أن اسم فريقك هو ^0000FFأتناد^000000."
		},
		Summary = "سجل عضوا في فريق تنقيب أتناد",
		NpcSpr = "4_F_HUWOMAN",
		NpcNavi = "verus04",
		NpcPosX = 182,
		NpcPosY = 168
	},
	[7610] = {
		Title = "منقب مسجل",
		Description = {
			"أصبحت الآن عضوا رسميا في فريق تنقيب أتناد، ويمكنك المشاركة في مشروع تنقيب فانتازماغوريكا."
		},
		Summary = ""
	},
	[7611] = {
		Title = "تنظيف الممر",
		IconName = "ico_dq.bmp",
		Description = {
			"هل يمكنك مساعدتنا على التخلص من الوحوش الموجودة في النفق والمنطقة المحيطة؟ بعد الانتهاء، أبلغ <NAVI>القائد لويس<INFO>verus04,179,165,0,101,0</INFO></NAVI>."
		},
		Summary = ""
	},
	[7612] = {
		Title = "تنظيف الممر (انتظار)",
		IconName = "ico_dq.bmp",
		Description = {
			"عليك أخذ قسط من الراحة. يستطيع مرتزقتنا التعامل مع وحوش الممر. يمكنك قبول المهمة مجددا من <NAVI>القائد لويس<INFO>verus04,179,165,0,101,0</INFO></NAVI>."
		},
		Summary = "انتظار المهمة اليومية",
	},
	[7613] = {
		Title = "إزالة المخاطر",
		IconName = "ico_dq.bmp",
		Description = {
			"تعرقل الروبوتات الموجودة في <NAVI>موقع التنقيب الرئيسي<INFO>verus03,122,32,0,101,0</INFO></NAVI> عملنا. تخلص منها."
