		Title = "<مراقبة بوبي>",
		Description = {
			"ملاحظات مراقبة ^0000FFبوبي^000000: يتصرف بعدوانية تجاه الغرباء، ومن الغريب أنه بقي هادئا أمام السارق. ربما يكون الجاني أحد معارف العائلة أو شخصا يجيد التعامل مع الحيوانات."
		},
		Summary = ""
	},
	[9253] = {
		Title = "<فحص رف الكتب المبعثر>",
		Description = {
			"ملاحظات فحص ^0000FFرف الكتب المبعثر^000000: عثرت على مذكرات لوين، وقرأت عن قلقها بسبب معارضة والدتها لعلاقتها بحبيبها، ورغبة حبيبها في كسب ثقة والدتها."
		},
		Summary = ""
	},
	[9254] = {
		Title = "<فحص الكتاب التالف>",
		Description = {
			"ملاحظات فحص ^0000FFالكتاب التالف^000000: يبدو أنه أتلف عمدا بهدف افتعال مشهد سرقة."
		},
		Summary = ""
	},
	[9255] = {
		Title = "<فحص حاوية علب المشروبات>",
		Description = {
			"ملاحظات فحص ^0000FFحاوية علب المشروبات^000000: وفقا لإفادة دام، كان يفترض وجود 15 زجاجة كحول، لكن الموجود 13 فقط. من المحتمل أن الجاني يحب الكحول."
		},
		Summary = ""
	},
	[9256] = {
		Title = "<فحص الطاولة المبعثرة>",
		Description = {
			"ملاحظات فحص ^0000FFالطاولة المبعثرة^000000: وفقا لإفادة روزا، يبدو صندوق المجوهرات أغلى من القلادة. ربما كان الجاني يستهدف القلادة وحدها."
		},
		Summary = ""
	},
	[9257] = {
		Title = "<فحص الجسم الغريب>",
		Description = {
			"ملاحظات فحص ^0000FFالجسم الغريب الموجود على الأرض^000000: توصلت إلى اكتشاف بالغ الأهمية يصعب وصفه. عليك رؤية كيفية تطور الأمور، فقد يصل التحقيق إلى نهايته قريبا."
		},
		Summary = ""
	},
	[9258] = {
		Title = "<نتائج فحص موقع الحادث>",
		Description = {
			"الجاني أحد المعارف أو مدرب حيوانات. حبيب لوين لا يحظى بموافقة والدتها. ربما كان مشهد السرقة مفتعلا. قد يكون الجاني محبا للكحول، وربما لم يكن الربح المالي دافعه الأساسي. سيستمر التحقيق اعتمادا على الاكتشاف المهم داخل منزل لوين."
		},
		Summary = ""
	},
	[9259] = {
		Title = "<التحقق من إفادة كرويان>",
		Description = {
			"تحقق من إفادة ^0000FFكرويان^000000. اذهب إلى أرض الزهور المتفتحة واصطد الوحوش لمعرفة إن كان يمكن الحصول منها على جرعة التركيز. اصطد 5 من مينبلات و30 من بيتال."
		},
		Summary = "تحدث مع بالومين قرب مدخل إكلاج بعد إنهاء الصيد"
	},
	[9260] = {
		Title = "<ملاحظات التحقيق الميداني>",
		Description = {
			"لا يمكن الحصول على جرعة التركيز التي ذكرها ^0000FFكرويان^000000 من الوحوش، ولذلك لم تتأكد حجة غيابه. لا يملك ^0000FFبالومين^000000 شهودا، لكن تأكد جزء من حجته. كان ^0000FFالتاجر المتجول^000000 مخمورا، وكان يمنح جرعات التركيز جوائز مزيفة في عمليات القمار الاحتيالية."
