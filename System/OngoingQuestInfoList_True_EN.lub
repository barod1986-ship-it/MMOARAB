	},
	[7642] = {
		Title = "استكشاف مرافق الأبحاث",
		Description = {
			"تجول في منطقة مرافق الأبحاث وابحث عن أشياء ذات قيمة خاصة للتحقيق والبحث. أبلغ إيان أتناد حتى عن الأشياء الصغيرة المهمة."
