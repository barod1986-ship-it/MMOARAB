	[12487] = {
		Title = "البحث عن آثار الكاهن المتدرب",
		Description = {
			"عليك العثور على آثار سيسيليا التي دخلت المتاهة المشوهة.^0000ffتتضمن المعلومات أوصافا لخصائص جسدية يمكن مقارنتها. عندما تعثر على رفاتها، اقترب منها وقارنها بالمعلومات.^000000"
		},
		Summary = "العثور على سيسيليا"
	},
	[12488] = {
		Title = "تقرير النتائج",
		Description = {
			"عثرت على جميع آثار الكهنة المتدربين الأربعة. اذهب إلى <NAVI>إزميرالدا<INFO>prt_maze01.gat,100,27,0,101,0</INFO></NAVI> داخل المتاهة وسلمها ما وجدته."
		},
		Summary = "العثور على إزميرالدا"
	},
	[12489] = {
		Title = "عضو نقابة ضيف",
		Description = {
			"تحدث مع أرواح الكهنة المتدربين قرب المكان الذي كانت فيه <NAVI>إزميرالدا<INFO>prt_maze01.gat,100,27,0,101,0</INFO></NAVI> داخل المتاهة. قابل الكهنة المتدربين الذين عادوا في هيئة أرواح وابدأ العمل عضوا ضيفا في النقابة."
		},
		Summary = "قبول المهمة"
	},
	[12490] = {
		Title = "استلام مهمات اليوم",
		Description = {
			"تحدث مع <NAVI>أعضاء جمعية الكهنة<INFO>prt_maze01.gat,100,27,0,101,0</INFO></NAVI> داخل المتاهة. لقد استلمت جميع المهمات اليومية المتاحة لك بصفتك عضوا ضيفا في جمعية كهنة برونتيرا. يمكنك قبولها مجددا بعد ^ff0000الساعة 04:00 من كل يوم^000000، ولا يمكن قبول المهمة نفسها أكثر من مرة."
		},
		Summary = "إعادة الضبط غدا عند الساعة 04:00"
	},
	[12491] = {
		Title = "استلام مهمات الأسبوع",
		Description = {
			"تحدث مع <NAVI>أعضاء جمعية الكهنة<INFO>prt_maze01.gat,100,27,0,101,0</INFO></NAVI> داخل المتاهة. لقد استلمت جميع المهمات الأسبوعية المتاحة لك بصفتك عضوا ضيفا في جمعية كهنة برونتيرا. يمكنك قبولها مجددا ^ff0000بعد الساعة 04:00 من كل يوم سبت^000000، ولا يمكن قبول المهمة نفسها أكثر من مرة."
