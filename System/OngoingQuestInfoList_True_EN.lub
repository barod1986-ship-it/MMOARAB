		Summary = ""
	},
	[8160] = {
		Title = "طلب بابا ياغا",
		Description = {
			"عثرت على ملعقة بابا ياغا الفضية التي سرقها القراصنة. عد إليها وأخبرها بأنك نفذت طلبها."
		},
		Summary = ""
	},
	[8161] = {
		Title = "طلب بابا ياغا",
		Description = {
			"طلبت منك بابا ياغا شراء كتاب سحري لها من موموتارو في أماتسو. الكتاب محجوز باسمها، وكل ما عليك فعله هو الذهاب إلى هناك وشراؤه."
