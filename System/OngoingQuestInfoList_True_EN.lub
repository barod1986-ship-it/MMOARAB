		Summary = "5 سجلات ذاكرة للمختبرات"
	},
	[7649] = {
		Title = "تقرير محتويات سجل الذاكرة",
		Description = {
			"أبلغ إيان أتناد بالمحتويات التي عرفتها من سجلات ذاكرة المختبرات."
