		Summary = ""
	},
	[12017] = {
		Title = "تمت الموافقة على العضوية",
		Description = {
			"اعثر على غوشار قرب يونو ليخبرك بمهمتك التالية. أره بطاقة العضوية لإثبات أنك تعمل مع غالشتاين."
