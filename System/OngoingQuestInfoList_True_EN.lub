	[7105] = {
		Title = "تغيير الوظيفة إلى غيلوتين كروس",
		Description = {
			"هربت إستلدا، لكنها لا تزال في مكان ما قرب هنا. تأكد من أنك بمفردك وحاول الإمساك بها مجددا بعد 5 دقائق."
