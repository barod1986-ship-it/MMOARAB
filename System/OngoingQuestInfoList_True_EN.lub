	[7243] = {
		Title = "مغامرة نيانغ - بوصلة دورودورو",
		Description = {
			"حصلت على بطاقة المغامرة A من القطط الصغيرة التي تطلق على نفسها \"فريق شجاعة مياو\". يبدو أن البطاقة ضرورية لتشغيل بعض الأجهزة التي صنعتها. أدخل البطاقة في بوصلة البداية لبدء اللعبة."
