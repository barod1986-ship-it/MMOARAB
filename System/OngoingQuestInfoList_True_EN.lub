		},
		Summary = "تغيير الوظيفة إلى مغتال"
	},
	[8009] = {
		Title = "التقديم لتغيير الوظيفة إلى كاهن",
		Description = {
			"اجتز اختبارات الكهنوت الثلاثة لتغيير وظيفتك إلى كاهن."
		},
		Summary = "التقديم لتغيير الوظيفة إلى كاهن"
	},
	[8010] = {
		Title = "تغيير الوظيفة إلى كاهن",
		Description = {
			"أد رحلة حج وفق الترتيب المحدد: زر الأب روبالكابارا عند الأطلال شمال شرق برونتيرا، ثم الأم ماتيلدا قرب موروك جنوب غرب برونتيرا، وأخيرا الأب يوسوكي في حقل شمال غرب برونتيرا."
		},
		Summary = "الاختبار الأول: رحلة الحج"
	},
	[8011] = {
		Title = "تغيير الوظيفة إلى كاهن",
		Description = {
			"توجه إلى قاعة التدريب الروحي وتحدث مع الأب بيتر إس. ألبرتو."
		},
		Summary = "الاختبار الثاني: التدريب الروحي"
	},
	[8012] = {
		Title = "تغيير الوظيفة إلى كاهن",
		Description = {
			"ابدأ التدريب الروحي، واقض على جميع الزومبي في كل قاعة قبل انتهاء الوقت."
		},
		Summary = "الاختبار الثاني: التدريب الروحي"
	},
	[8013] = {
		Title = "تغيير الوظيفة إلى كاهن",
		Description = {
			"أتممت التدريب الروحي. اذهب إلى الأخت سيسيليا لأداء قسم الكهنوت."
		},
		Summary = "الاختبار الثالث: قسم الكهنوت"
	},
	[8014] = {
		Title = "تغيير الوظيفة إلى كاهن",
		Description = {
			"أجب عن أسئلة الأخت سيسيليا وتعهد بتكريس حياتك لخدمة الإله والآخرين."
		},
		Summary = "الاختبار الثالث: الإخلاص للإله"
	},
	[8015] = {
		Title = "تغيير الوظيفة إلى كاهن",
		Description = {
			"أتممت الاختبارات الثلاثة وأديت قسم الكهنوت. عد إلى الأسقف بول لإتمام تغيير الوظيفة."
		},
		Summary = "العودة إلى الأسقف بول"
	},
	[8016] = {
		Title = "تغيير الوظيفة إلى كاهن",
		Description = {
			"أصبحت الآن كاهنا!"
		},
		Summary = "تغيير الوظيفة إلى كاهن"
	},
	[8017] = {
		Title = "فحص المصنع",
		Description = {
			"طلب منك زيلميتو مساعدته في فحص آلات المصنع واحدة تلو الأخرى لمعرفة الآلات التي تحتاج إلى إصلاح. اعثر على لوحة التحكم الثانية ثم أبلغ زيلميتو."
		},
		Summary = ""
	},
	[8018] = {
		Title = "فحص المصنع",
		Description = {
			"عثرت على لوحة التحكم الثانية، وهي معطلة بالكامل. أبلغ زيلميتو بذلك."
		},
		Summary = ""
	},
	[8019] = {
		Title = "فحص المصنع",
		Description = {
			"طلب منك زيلميتو فحص منظمات الضغط الآلية وإبلاغه بأي مشكلة، مهما بدت صغيرة."
		},
		Summary = ""
	},
	[8020] = {
		Title = "فحص المصنع",
		Description = {
			"عثرت على منظمات الضغط الآلية، وبعد فحصها بدقة وجدت أنها تصدر أصوات احتكاك غريبة وأن بعض براغي سطحها مفكوكة. أبلغ زيلميتو بما وجدته."
		},
		Summary = ""
	},
	[8021] = {
		Title = "فحص المصنع",
		Description = {
			"طلب منك زيلميتو الآن فحص لوحة تحكم أخرى. تشبه الأولى، لكنها أكبر حجما وتقع في وسط المصنع. اعثر عليها ثم أبلغ زيلميتو."
		},
		Summary = ""
	},
	[8022] = {
		Title = "فحص المصنع",
		Description = {
			"لا تبدو على لوحة التحكم الرئيسية أي مشكلة، لكنك سمعت صوتا أجوف مقلقا عندما طرقت سطحها. يبدو أنها تفتقد بعض القطع... أبلغ زيلميتو بما وجدته."
		},
		Summary = ""
	},
	[8023] = {
		Title = "فحص المصنع",
		Description = {
			"طلب منك زيلميتو فحص ذراع آلية تنقل الأجسام الصغيرة. اعثر عليها وأبلغه بما وجدته."
		},
		Summary = ""
	},
	[8024] = {
		Title = "فحص المصنع",
		Description = {
			"تبدو حركة الناقل متقطعة وغير متقنة، كما أن الذراع الآلية لا تبدو قوية بما يكفي لحمل حمولتها... أبلغ زيلميتو بما وجدته."
		},
		Summary = ""
	},
	[8025] = {
		Title = "فحص المصنع",
		Description = {
			"عليك الآن فحص أنبوب قرب المراجل الكبيرة الممتلئة بالمعدن المنصهر، ثم إبلاغ زيلميتو بما وجدته."
		},
		Summary = ""
	},
	[8026] = {
		Title = "فحص المصنع",
		Description = {
			"الأنبوب الذي عثرت عليه منتفخ ومتهالك بسبب تعرضه لضغط زائد لفترات طويلة. من المدهش أنه لم ينفجر بعد. أبلغ زيلميتو بما وجدته."
		},
		Summary = ""
	},
	[8027] = {
		Title = "فحص المصنع",
		Description = {
			"آخر ما طلب منك زيلميتو فحصه هو ناقل أكبر وأقوى. اعثر عليه ثم أبلغه بما وجدته."
		},
		Summary = ""
	},
	[8028] = {
		Title = "فحص المصنع",
		Description = {
			"يبدو أن الناقل الأخير يعاني مشكلات مشابهة للناقل الأصغر. حركته غير مستقرة وعشوائية وضعيفة، وجميع براغيه تقريبا صدئة. أبلغ زيلميتو بما وجدته."
		},
		Summary = ""
	},
	[8029] = {
		Title = "فحص المصنع",
		Description = {
			"أخبرك زيلميتو بأنه يحتاج إلى طلب زيادة ميزانية إصلاح المصنع من المشرف لضمان توفر مواد كافية للإصلاح. اعثر على المشرف."
		},
		Summary = ""
	},
	[8030] = {
		Title = "فحص المصنع",
		Description = {
			"رفض المشرف الموافقة على زيادة ميزانية إصلاح المصنع. من الأفضل إبلاغ زيلميتو بهذه الأخبار السيئة."
		},
		Summary = ""
	},
	[8031] = {
		Title = "فحص المصنع",
		Description = {
			"ما زال زيلميتو يريد تنفيذ الإصلاحات، لذلك طلب منك إحضار ^FF000020 أنبوبا مرنا^000000 و^FF000010 براغي صدئة^000000 و^FF000010 صفائح حديد مستعملة^000000 لإجراء الإصلاحات اللازمة."
		},
		Summary = ""
	},
	[8032] = {
		Title = "طلب تارلوك",
		Description = {
			"قال تارلوك إنه لا يمانع في شرح كيفية عمل المنطاد إن أسديت إليه خدمة وسلمت رسالة إلى شقيقه فيرلوك."
		},
		Summary = "سلم رسالة تارلوك إلى شقيقه"
	},
	[8033] = {
		Title = "طلب فيرلوك",
		Description = {
			"طلب منك فيرلوك استعادة أغراضه المسروقة من الوحوش التي تهاجم منطاد تارلوك. أحضر إليه إرادتي ظلام وثمرتين شوكيتين."
		},
		Summary = "استعد الأغراض المسروقة"
	},
	[8034] = {
		Title = "طلب فيرلوك",
		Description = {
			"طلب منك فيرلوك تسليم رده إلى شقيقه تارلوك."
		},
		Summary = "سلم رسالة فيرلوك إلى شقيقه تارلوك"
	},
	[8035] = {
		Title = "كيفية عمل المنطاد",
		Description = {
			"سلمت رسالة فيرلوك إلى تارلوك. قد يكون هذا وقتا مناسبا لسؤاله عن كيفية عمل المنطاد."
		},
		Summary = "واصل التحدث مع تارلوك"
	},
	[8036] = {
		Title = "طلب هالين",
		Description = {
			"طلب منك هالين تسليم رسالة إلى <NAVI>كاسي<INFO>man_fild01,0,101,0</INFO></NAVI> من شخص يدعى السيد ماوونغ، وهو معلمها."
		},
		Summary = "سلم الرسالة إلى كاسي"
	},
	[8037] = {
		Title = "رامية النرد",
		Description = {
			"سلمت رسالة هالين إلى كاسي. ينبغي أن تعرف ما لديها من معلومات..."
		},
		Summary = ""
	},
	[8038] = {
		Title = "رامية النرد",
		Description = {
			"اتضح أن كاسي ابنة عم هالين. بعد الإجابة عن أسئلتك، عادت إلى إدارة ألعابها. من قد يعرف ماضيهما أيضا؟"
		},
		Summary = ""
	},
	[8039] = {
		Title = "سر المناطيد",
		Description = {
			"أخبرك هالين أن مشروعه يهدف إلى معرفة المزيد عن كيفية عمل المناطيد. قد يفيدك سؤال شخص خبير بالمناطيد، ثم إبلاغ هالين بما تكتشفه."
		},
		Summary = ""
	},
	[8040] = {
		Title = "سر المناطيد",
		Description = {
			"\"حقا؟ حجر الرون نسخة تحاكي قطعة من قلب يمير... أين سمعت ذلك من قبل؟ دعني أفكر...\""
		},
		Summary = "واصل التحدث مع هالين"
	},
	[8041] = {
		Title = "سر المناطيد",
		Description = {
			"أخبرتك كاسي عن رجل مخمور يذكر قلب يمير دائما حين يلعب بالنرد مقابل التفاح."
		},
		Summary = ""
	},
	[8042] = {
		Title = "سر المناطيد",
		Description = {
			"اكتشفت أن مدير مختبر إينبروخ يعرف شيئا عن قطعة قلب يمير. يستحق الأمر التحقيق..."
		},
		Summary = ""
	},
	[8043] = {
		Title = "سر المناطيد",
		Description = {
			"من الأفضل أن تخرج من هنا. يتجول الحراس في هذا المكان باستمرار، ومن شبه المؤكد أنهم سيمسكون بك. قابلني لاحقا على المنطاد، حسنا؟ أسرع الآن!"
		},
		Summary = "اذهب لمقابلة فيرلوك"
	},
	[8044] = {
		Title = "خطيب أوسلان",
		Description = {
			"\"هل أنت مستعد حقا للبحث عن تييري من أجلي؟ شكرا جزيلا!",
			"لا تعرف مدى أهمية عرضك الكريم بالنسبة إلي.",
			"ذهب تييري في رحلة على أحد المناطيد للعثور على دواء قال الأطباء إنني أحتاج إليه لعلاج مرضي.\""
		},
		Summary = ""
	},
	[8045] = {
		Title = "نصيحة كاسي",
		Description = {
			"\"فهمت! سأطلب من قبطان المنطاد مساعدتك، فهو يملك قائمة الركاب ووجهاتهم.\""
		},
		Summary = "تحقق من قائمة الركاب لدى القبطان"
	},
	[8046] = {
		Title = "قائمة ركاب فيرلوك",
		Description = {
			"وفقا لهذه القائمة، كانت آخر رحلة له على متن منطاد متجهة إلى هويغل. هذا كل ما هو مكتوب."
		},
		Summary = ""
	},
	[8047] = {
		Title = "طلب أوسلان",
		Description = {
			"\"إن سنحت لك الفرصة، فزر أخي يوكران في هويغل واسأله عن المكان الذي قد يكون فيه تييري.\""
		},
		Summary = ""
	},
	[8048] = {
		Title = "شهادة يوكران",
		Description = {
			"\"مر تييري من هنا قبل نحو شهر، وأخبرني بأنه مضطر إلى زيارة ضريح أودين. لم أكن متأكدا حينها، لكنني أعتقد الآن أنه يحاول مساعدة أختي.\""
		},
		Summary = ""
	},
	[8049] = {
		Title = "طلب تييري",
		Description = {
			"\"لا أستطيع شرح التفاصيل، لكنني أقوم بهذا العمل لإيجاد علاج لمرض أوسلان. لا يستطيع الطب الحديث علاجه...\""
		},
		Summary = ""
	},
	[8050] = {
		Title = "الخطر يقترب من تييري",
		Description = {
			"\"يبدو أن تييري اكتشف ما نخطط له حقا. أعتقد أن هذا سبب إبطائه لأبحاثه. من الأفضل التخلص منه قبل فوات الأوان.\""
		},
		Summary = ""
	},
	[8051] = {
		Title = "دواء أوسلان",
		Description = {
			"\"لا يهم ما يحدث لي، لكن يجب أن أنقذ أوسلان. لا أحتاج سوى 5 من رون الظلام لإكمال الدواء. ساعدني على جمعها أيها المغامر...\""
		},
		Summary = "اجمع 5 من رون الظلام"
	},
	[8052] = {
		Title = "طلب تييري",
		Description = {
			"\"أرجو أن تتفهم أنني أريد رؤيتها في أسرع وقت، لكن علي الانتظار حتى يتوقف عملاء ريكنبر عن البحث عني. سلم هذا الدواء إلى أوسلان بأسرع ما يمكن، فحياتها تعتمد عليه.\""
		},
		Summary = "سلم الدواء إلى أوسلان"
	},
	[8053] = {
		Title = "اعثر على بوستيل",
		Description = {
			"\"اعثر على بوستيل ابن ألين وأخبره بأن يحضر دواء والده! اتجه شرقا واخرج من المدينة، وستتمكن من العثور عليه.\""
		},
		Summary = ""
	},
	[8054] = {
		Title = "رسالة من بوستيل",
		Description = {
			"طلب منك بوستيل التأكد من أن والده لن يورط نفسه في المزيد من المشكلات."
		},
		Summary = "عد إلى ألين"
	},
	[8055] = {
		Title = "رعاية ألين",
		Description = {
			"\"ماذا لو أصبت بنوبة قرحة أخرى قبل أن يحضر بوستيل دوائي؟ قد لا أنجو! أيها المغامر، هل تبقى بجانبي حتى يصل ابني؟\""
		},
		Summary = "اعتن بألين"
	},
	[8056] = {
		Title = "مكافأة صغيرة",
		Description = {
			"\"تفقد درج الأدوية وخذ منه ما يعجبك.\" ~ألين"
		},
		Summary = "تفقد درج الأدوية"
	},
	[8057] = {
		Title = "ماناين المتذمرة",
		Description = {
			"تحدث مع ماناين عن شجرة الراحة."
		},
		Summary = ""
	},
	[8058] = {
		Title = "تحدث مع إل شات",
		Description = {
			"\"تعني هذه الشجرة الكثير لجميع سكان البلدة، ولكل منا ذكريات خاصة في هذا المكان. لكن إل شات يخطط لقطعها من أجل متجره...\" -ماناين"
		},
		Summary = ""
	},
	[8059] = {
		Title = "تحدث مع بيرفيتز",
		Description = {
			"قال إل شات إن والده كان يريد بناء متجر هنا منذ مدة طويلة. تحدث مع والده بيرفيتز واستمع إلى وجهة نظره."
		},
		Summary = ""
	},
	[8060] = {
		Title = "إل شات العنيد",
		Description = {
			"\"رغم سعادتي، ينتابني شعور بأن هناك خطبا ما، وكأنه متحمس أكثر من اللازم لقطع تلك الشجرة. ربما يكون هذا العجوز كثير الشك فقط~\" -بيرفيتز"
		},
		Summary = ""
	},
	[8061] = {
		Title = "قصص الماضي",
		Description = {
			"قال إل شات إنه كان سيحمي الشجرة بحياته في الماضي، لكن ذلك ينبغي أن يبقى مدفونا فيه. اعثر على شخص قد يعرف شيئا عن ماضيه."
		},
		Summary = ""
	},
	[8062] = {
		Title = "كاناين",
		Description = {
			"\"أصبح إل شات الآن عديم القلب ولا يهتم إلا بالمال... لقد تغير تماما. كانت أختي ستتقلب في قبرها لو رأته الآن...\" -ماناين"
		},
		Summary = ""
	},
	[8063] = {
		Title = "روح كاناين",
		Description = {
			"\"هل يمكنني استعارة جسد أختي؟ نعم، إن تعاونت معي، فربما... ربما ينجح الأمر. يجب أن أفعل شيئا قبل أن... قبل أن يؤذي نفسه أكثر...\""
		},
		Summary = ""
	},
	[8064] = {
		Title = "حساء كعك السمك من سيليت",
		Description = {
			"سلم طلب حساء كعك السمك هذا إلى صديقتي نيها. أنا ممتنة لأنها زبونة دائمة."
		},
		Summary = "سلم الطلب إلى نيها"
	},
	[8065] = {
		Title = "حساء كعك السمك من سيليت",
		Description = {
			"سلم طلب حساء كعك السمك التالي إلى ماهيوان، وهي زبونة دائمة أخرى."
		},
		Summary = "سلم الطلب إلى ماهيوان"
	},
	[8066] = {
		Title = "حساء كعك السمك من سيليت",
		Description = {
			"سلمه إلى زميلتي في السكن لايوما. لكن احذر، فهي شديدة الاهتمام بالمواعيد. حاول ألا تتأخر..."
		},
		Summary = "سلم الطلب إلى لايوما"
	},
	[8067] = {
		Title = "حساء كعك السمك من سيليت",
		Description = {
			"أسرع وسلم حساء كعك السمك هذا إلى إرجان. لكن احذر، فهو شديد التدقيق..."
		},
		Summary = "سلم الطلب إلى إرجان"
	},
	[8068] = {
		Title = "حساء كعك السمك من سيليت",
		Description = {
			"تأخرت! ألا تعرف أن هذا الحساء لا يكون لذيذا إن لم يكن ساخنا؟ لكنني سأسامحك بشرط واحد. أحضر لي ^FF0000سوطا واحدا^000000 لأعاقبك به. أسرع، وإلا فلن أسامحك بسهولة."
		},
		Summary = "أحضر سوطا واحدا إلى نيها"
	},
	[8069] = {
		Title = "حساء كعك السمك من سيليت",
		Description = {
			"\"آه، لكنك تأخرت! هذا خطؤك، وأنت تعرف ذلك، صحيح؟ يمكنني مسامحتك إن ساعدتني في مجموعتي. أحضر لي مشبك كتاب الذكريات واحدا، حسنا؟\""
		},
		Summary = "أحضر مشبك كتاب الذكريات إلى ماهيوان"
	},
	[8070] = {
		Title = "حساء كعك السمك من سيليت",
		Description = {
			"\"لا يمكنني السماح لك بمواصلة التوصيل لسيليت حتى تثبت أنك جدير بالثقة. أحضر لي ^ff0000بوغ فطر واحدا^000000، وسأنسى الأمر كله.\""
		},
		Summary = "أحضر بوغ فطر واحدا إلى لايوما"
	},
	[8071] = {
		Title = "حساء كعك السمك من سيليت",
		Description = {
			"\"بصفتي الابن الأول لعائلة فرانشيسفيشو، لا يمكنني تناول هذا الحساء ما لم يقدم بصورة لائقة. اذهب! آمرك بإحضار ^ff0000طبق خزف العامة^000000!\""
		},
		Summary = "أحضر طبق خزف العامة إلى إرجان"
	},
	[8072] = {
		Title = "حساء كعك السمك من سيليت",
		Description = {
			"\"أوه، هل ضربتك بالسوط مرتين عن طريق الخطأ؟ هيه هيه... حسنا، أنا راضية. سأخبر سيليت بأنك أديت عملا جيدا... أتمنى أن توصل حسائي مجددا~\""
		},
		Summary = "عد إلى سيليت"
	},
	[8073] = {
		Title = "حساء كعك السمك من سيليت",
		Description = {
			"\"رائع، لقد أحضرت مشبك كتاب الذكريات حقا! سيكون إضافة ممتازة إلى مجموعتي~ وأعطني حسائي أيضا. شكرا على التوصيل~\""
		},
		Summary = "عد إلى سيليت"
	},
	[8074] = {
		Title = "حساء كعك السمك من سيليت",
		Description = {
			"\"حسنا، ربما يمكنني الاعتماد عليك للعمل لدى زميلتي سيليت مدة أطول. وأخبرها من فضلك ألا تعود إلى المنزل متأخرة دائما، حسنا؟\""
		},
		Summary = "عد إلى سيليت"
	},
	[8075] = {
		Title = "حساء كعك السمك من سيليت",
		Description = {
			"\"يمكنك الانصراف. غادر الآن وعد إلى سيليت حاملا شكري النبيل.\""
		},
		Summary = "عد إلى سيليت"
	},
	[8076] = {
		Title = "كليتزر وكالا",
		Description = {
			"أعرف أنني أتصرف كالأحمق تماما، لكنني مستعد لفعل أي شيء لرؤية كالا... لا تستمع إلى شيء مما أقوله. أنا مجرد أحمق مسكين أحب الشخص الخطأ. لا بد أن هذا هو السبب..."
		},
		Summary = ""
	},
	[8077] = {
		Title = "كليتزر وكالا",
		Description = {
			"ربما لا أستطيع رؤيته، لكن هل تسلم كماني إلى كليتزر؟ كنت أعزف له عليه دائما..."
		},
		Summary = "خذ كمان كالا إلى كليتزر"
	},
	[8078] = {
		Title = "كليتزر وكالا",
		Description = {
			"هذا كمان ابنتي. أهديته إليها في عيد ميلادها السادس عشر... لقد تجاوزت حدودك أيها الوقح! أيها الحراس! تعالوا إلى هنا!"
		},
		Summary = "تمت مصادرة كمان كالا"
	},
	[8079] = {
		Title = "كليتزر وكالا",
		Description = {
			"كل ما عليك فعله هو إعطاؤها ^FF0000زهرة واحدة^000000. لا أملك الزيني، ولا أظن أنني مرحب بي في قصر كابيلثاين."
		},
		Summary = "أحضر زهرة واحدة إلى كالا"
	},
	[8080] = {
		Title = "كليتزر وكالا",
		Description = {
			"إن مررت بإينبروخ، فهل تشكر كليتزر على الزهرة نيابة عني؟ وأخبره أيضا بأنني أشتاق إليه كثيرا."
		},
		Summary = "سلم رسالة كالا إلى كليتزر"
	},
	[8081] = {
		Title = "كليتزر وكالا",
		Description = {
			"أشعر بتحسن كبير الآن. عندما يتوفر لديك الوقت، لم لا تتحدث مع أمي؟ إنها تحب دائما مقابلة أصدقائي."
		},
		Summary = "قابل والدة كليتزر"
	},
	[8082] = {
		Title = "كليتزر وكالا",
		Description = {
			"لا أحتمل رؤية الكراهية التافهة بين بلدتينا تمنع ابني من رؤية المرأة التي يحبها... اعثر على شخص يعرف تاريخ إينبروخ وإينبيخ."
		},
		Summary = ""
	},
	[8083] = {
		Title = "كليتزر وكالا",
		Description = {
			"لم لا تحضر لي ^990000الفحم^000000؟ الأمر ليس مستحيلا على شخص مثلك، لكنه سيتطلب منك بعض الجهد."
		},
		Summary = "أحضر الفحم إلى ساترا"
	},
	[8084] = {
		Title = "كليتزر وكالا",
		Description = {
			"حسنا، سأحاول إيجاد استخدام لهذا الفحم. أخشى أن الهدية التي طلبتها منك ليست عملية جدا. فيم يستخدم الفحم عادة؟ لدي فكرة جديدة! يبدو أن إحضار المزيد من الفحم سيجعل ساترا تتحدث."
		},
		Summary = "أحضر المزيد من الفحم إلى ساترا"
	},
	[8085] = {
		Title = "كليتزر وكالا",
		Description = {
			"على أي حال، عندما تقابل كليتزر مجددا، أخبره بأن يزورني قريبا. وذكره بأن يرتدي ملابس مناسبة لهذه المناسبة الخاصة. هو هو هو هو هو~!"
		},
		Summary = "سلم الرسالة إلى كليتزر"
	},
	[8086] = {
		Title = "كليتزر وكالا",
		Description = {
			"ماذا...؟ ماذا قلت للتو؟ هل قلت إن والدة كالا تريد تناول الشاي معي؟ يا إلهي...!!"
		},
		Summary = ""
	},
	[8087] = {
		Title = "كليتزر وكالا",
		Description = {
			"شكرا لمساعدتك ابني كليتزر. للأسف، ذلك الأحمق الصغير لا يعرف شيئا عن اختيار الملابس. ينبغي للرجل ارتداء ملابس أنيقة، مثل البدلة الرسمية أو بدلة السهرة، في الاجتماعات المهمة والمناسبات الخاصة."
		},
		Summary = "احصل لكليتزر على ملابس أنيقة"
	},
	[8088] = {
		Title = "كليتزر وكالا",
		Description = {
			"لقد فتحت عيني حقا. سأبذل قصارى جهدي من الآن لكسب موافقة والدي كالا، ولأصبح جديرا بحبها."
		},
		Summary = ""
	},
	[8089] = {
		Title = "الحجر الكريم المسروق",
		Description = {
			"\"لا أملك دليلا، لكنني أشتبه في أن فوبي، الخادم الذي اختفى في الوقت نفسه تقريبا، هو من سرقه. ربما عليك سؤال الخدم الآخرين عن مكانه.\" - <NAVI>فينسنت<INFO>ra_in01,384,246,0,101,0</INFO></NAVI>"
		},
		Summary = "اجمع معلومات عن مكان فوبي"
	},
	[8090] = {
		Title = "السيد مانسون",
		Description = {
			"\"في الحقيقة، لا أعرف الكثير لأنني بدأت العمل هنا حديثا. لم لا تسأل الموظفين الأقدم؟ يمكنك سؤال السيد مانسون داخل القصر.\" - <NAVI>لوغان<INFO>rachel,114,232,0,101,0</INFO></NAVI>"
		},
		Summary = "اعثر على السيد مانسون"
	},
	[8091] = {
		Title = "جيني البستانية",
		Description = {
			"\"بستانيتنا جيني هي التي عرفتني عليه. لقد عملت لدى الكاهن المتقدم زيد مدة طويلة، وهي تحب الأطفال. إن أردت معرفة المزيد عن ذلك الطفل، فتحدث مع جيني.\" - <NAVI>مانسون<INFO>ra_in01,372,200,0,101,0</INFO></NAVI>"
		},
		Summary = "اعثر على جيني"
	},
	[8092] = {
		Title = "البحث في السوق",
		Description = {
			"حسنا، سأذهب إلى السوق وأسأل الناس هناك."
		},
		Summary = "اذهب إلى السوق"
	},
	[8093] = {
		Title = "رسالة غامضة",
		Description = {
			"طلب مني رجل ليلة أمس إبلاغ أي شخص يبحث عن شخص يدعى فوبي برسالة. يريد منك الذهاب إلى \"كهف الجليد\". كان اسمه... نوغان؟ روغان؟ شيء من هذا القبيل."
		},
		Summary = "اذهب إلى كهف الجليد"
	},
	[8094] = {
		Title = "هل تعرضت للخيانة؟",
		Description = {
			"كانت تعليمات فينسنت هي هزيمة أي شخص يسأل عن روغان، وهو اسم اخترعه. يبدو أنه نصب لنا فخا يا رجل. آسف، لو كنت أعرف لما فعلت ذلك."
		},
		Summary = "عد إلى فينسنت"
	},
	[8095] = {
		Title = "اعثر على فوبي",
		Description = {
			"لن تقع في مشكلة إن عثرت على الجوهرة وفوبي قبل عودة الكاهن المتقدم زيد، لذلك سأحاول العثور عليهما بأسرع ما يمكن. فوبي مجرد طفل، ولذلك ربما يختبئ في مكان ما داخل المدينة..."
		},
		Summary = "حاول العثور على فوبي"
	},
	[8096] = {
		Title = "العثور على الحجر الكريم المسروق",
		Description = {
			"للعلم، لا أنوي العودة إلى المنزل! ليس الآن على الأقل. لكن أخبر أمي بأنني بخير ولا داعي للقلق."
		},
		Summary = "عد إلى فينسنت"
	},
	[8097] = {
		Title = "إبلاغ جيني",
		Description = {
			"بينما أعيد هذه الجوهرة، هل تخبر زوجتي جيني بأن ابننا بخير؟ كانت شديدة القلق عليه..."
		},
		Summary = "جيني"
	},
	[8098] = {
		Title = "الحفاظ على السر",
		Description = {
			"شكرا لك على كل مساعدتك أيها المغامر~"
		},
		Summary = "عد إلى فينسنت"
	},
	[8099] = {
		Title = "توصية فينسنت",
		Description = {
			"هذه رسالة توصية كتبتها لك. سلمها إلى الكاهن المتقدم زيد بأسرع ما يمكن. وداعا، وشكرا لك على كل شيء."
		},
		Summary = "اذهب لمقابلة الكاهن المتقدم زيد"
	},
	[8100] = {
		Title = "توصية الكاهن المتقدم زيد",
		Description = {
			"بينما أنتهي من كتابة هذه التوصية، سأشرح لك طريق الوصول إلى مكتب البابا الذي عليك زيارته بعد جمع 40 قلبا جليديا."
		},
		Summary = "اجمع 40 قلبا جليديا وقابل البابا"
	},
	[8101] = {
		Title = "توصية الكاهن المتقدم زيد",
		Description = {
			"أشكرك حقا على مجيئك للتحدث معي. قضيت وقتا ممتعا وتعلمت الكثير. علي الآن الذهاب لإقامة الشعائر، لذا... وداعا في الوقت الحالي..."
		},
		Summary = "عد إلى زيد"
	},
	[8102] = {
		Title = "توصية الكاهن المتقدم زيد",
		Description = {
			"أعتذر، لكننا لم ننته من حديثنا بعد. لم لا تنتظر وتستريح في الغرفة المجاورة في هذه الأثناء؟"
		},
		Summary = ""
	},
	[8103] = {
		Title = "توصية الكاهن المتقدم زيد",
		Description = {
			"أريد تقديم نصيحة صغيرة لك. لا تقترب كثيرا من الكاهن المتقدم زيد، وإلا فقد تورط نفسك في المتاعب..."
		},
		Summary = "عد إلى زيد"
	},
	[8104] = {
		Title = "توصية الكاهن المتقدم زيد",
		Description = {
			"قبل أن تذهب، أحذرك من ^FF0000الاقتراب من الأرض المقدسة^000000. أكرر، ابتعد عن الأرض المقدسة."
		},
		Summary = ""
	},
	[8105] = {
		Title = "توصية الكاهن المتقدم زيد",
		Description = {
			"حذرت بيكينتو من أنه قد يسبب لك مشكلة، لكن يبدو أنك سببت له المشكلة بدلا من ذلك. افهم هذا: يعاقب معظم المتسللين بشدة، لكنني سأتساهل معك بسبب صداقتي مع بيكينتو. تذكر ذلك..."
		},
		Summary = "عد إلى زيد"
	},
	[8106] = {
		Title = "ابنة السيد شيندار",
		Description = {
			"قال السيد شيندار إن ابنته كانت تواعد شخصا ما. ذهبت إلى مدينة ما من أجل ذلك الشاب، ولم يسمع عنها منذ ذلك الحين. اعثر على شخص قد يعرف ما حدث لها."
		},
		Summary = ""
	},
	[8107] = {
		Title = "شهادة لاتشيلن",
		Description = {
			"أنا غيورة جدا من بروسبيتي! لقد أصبحت تقضي وقتا طويلا مع حبيبها الجديد مؤخرا... لكنها ما زالت ترفض إخباري باسمه. لنر... لقد نشأ في لايت هالزن؟ هذا كل ما أعرفه."
		},
		Summary = "اعثر على غريب في المدينة"
	},
	[8108] = {
		Title = "الغريب كاتينشويل",
		Description = {
			"أخبرك كاتينشويل بأن علاقته بحبيبته انتهت. ربما يتحدث عن ابنة السيد شيندار. اسأله عن الأمر."
		},
		Summary = "تحدث مع السيد شيندار"
	},
	[8109] = {
		Title = "رائحة بروسبيتي",
		Description = {
			"قال السيد شيندار إن لابنته بروسبيتي رائحة جميلة ومميزة مثل أمها. ابحث في لايت هالزن عن شخص يحمل رائحة جميلة مميزة."
		},
		Summary = "ابحث عن رائحة بروسبيتي في لايت هالزن"
	},
	[8110] = {
		Title = "رائحة بروسبيتي",
		Description = {
			"هذه الرائحة... إنها جميلة للغاية! كبتلات الورد التي تحملها نسمة لطيفة... هل يمكن أن تكون هذه الرائحة التي ذكرها والد بروسبيتي؟"
		},
		Summary = "عد إلى راشيل وقابل لاتشيلن"
	},
	[8111] = {
		Title = "شهادة لاتشيلن",
		Description = {
			"إن كانت في لايت هالزن، فربما ذهبت إلى هناك لمعرفة المزيد عن حبيبها. ربما يمكنك العثور على شيء إن تفقدت المكان الذي اعتادا الذهاب إليه في مواعيدهما."
		},
		Summary = "اعثر على نبع فريا"
	},
	[8112] = {
		Title = "نبع فريا",
		Description = {
			"أعتذر إن أفزعتك، لكن الأرض التي تقف عليها زلقة جدا."
		},
		Summary = "عد إلى السيد شيندار"
	},
	[8113] = {
		Title = "مذكرات بروسبيتي",
		Description = {
			"بصفتي أبا محبا، لا أستطيع انتهاك خصوصية ابنتي العزيزة، حتى إن تركت مذكراتها بلا مبالاة فوق خزانتها."
		},
		Summary = "ابحث عن المذكرات فوق الخزانة"
	},
	[8114] = {
		Title = "مذكرات بروسبيتي",
		Description = {
			"لا بد أن هذه مذكرات بروسبيتي! لكن قراءتها ستجعلك تشعر كأنك شخص متطفل حقا. اسأل كاتينشويل إن كان يعرف سبب وجود بروسبيتي في لايت هالزن."
		},
		Summary = "اذهب لمقابلة كاتينشويل"
	},
	[8115] = {
		Title = "كاتينشويل المريب",
		Description = {
			"يصر كاتينشويل على أن تتركه وشأنه. ربما يعرف شخص آخر شيئا عن اهتمام بروسبيتي بنبع فريا ولايت هالزن."
		},
		Summary = "اذهب لمقابلة لاتشيلن"
	},
	[8116] = {
		Title = "شهادة لاتشيلن",
		Description = {
			"نبع فريا؟ أنا أحب ذلك المكان! وبالمناسبة، أعرف شخصا يدعى كاتينشويل كان يذهب إليه كثيرا. عادة لا يذهب الرجال إلى هناك بمفردهم..."
		},
		Summary = "اذهب إلى نبع فريا"
	},
	[8117] = {
		Title = "نبع فريا",
		Description = {
			"هل ترى حافة النبع؟ يأتي الشاب نفسه كثيرا إلى ذلك المكان ويحدق في الماء ممتلئا بالحزن. لا ينبغي لشخص في مثل عمره أن يشعر هكذا."
		},
		Summary = "عد إلى السيد شيندار"
	},
	[8118] = {
		Title = "تحدث مع السيد شيندار",
		Description = {
			"انتظر... هل كان شخص ما يتسلل إلى هنا؟ هذا غريب. لحظة، ذلك الرجل الذي قد يكون حبيب بروسبيتي..."
		},
		Summary = "احصل على مذكرات بروسبيتي"
	},
	[8119] = {
		Title = "مذكرات بروسبيتي",
		Description = {
			"لديك الآن إذن بأخذ المذكرات لتكتشف إن كانت هناك علاقة بين بروسبيتي وكاتينشويل... خذ المذكرات إلى كاتينشويل."
		},
		Summary = "كاتينشويل"
	},
	[8120] = {
		Title = "تحدث مع كاتينشويل",
		Description = {
			"أخبرني بالحقيقة! في الواقع، لم لا نواجه الحقيقة معا؟ ما رأيك؟"
		},
		Summary = "واصل التحدث مع كاتينشويل"
	},
	[8121] = {
		Title = "تحدث مع كاتينشويل",
		Description = {
			"ما زال يقاومني... كيف أجعله يكشف الحقيقة؟ ربما يوجد شيء يمكنني استخدامه لإجباره على الاعتراف..."
		},
		Summary = "واصل التحدث مع كاتينشويل"
	},
	[8122] = {
		Title = "مثوى بروسبيتي",
		Description = {
			"أرجوك، اتركني وشأني. فقدت المرأة التي أحبها بسبب أمر أحمق فعلته في الماضي. إن أردت الإبلاغ عني، فافعل..."
		},
		Summary = "اذهب إلى نبع فريا"
	},
	[8123] = {
		Title = "طبق أيوثايا الشهير عالميا، توم يوم غونغ",
		Description = {
			"يستطيع أي شخص صنع توم يوم غونغ، لكنني أنصحك بزيارة ^0000FFمالي الحارة^000000. إنها أفضل طاهية. لم لا تطلب منها أن تطبخه لك؟"
		},
		Summary = ""
	},
	[8124] = {
		Title = "طبق أيوثايا الشهير عالميا، توم يوم غونغ",
		Description = {
			"يمكنك شراء الروبيان الطازج من رجل يدعى ^0000FFثونغبول^000000. احصل على 20 حبة روبيان لطهو توم يوم غونغ."
		},
		Summary = "أحضر 20 حبة روبيان إلى مالي الحارة"
	},
	[8125] = {
		Title = "طبق أيوثايا الشهير عالميا، توم يوم غونغ",
		Description = {
			"عثرت مالي الحارة على شجرة ليمون جيدة جدا في المنطقة، لكن ثمارها ليست للبيع. عليك الحصول على بعض الليمون من مالك الشجرة."
		},
		Summary = "أحضر 10 حبات ليمون إلى مالي الحارة"
	},
	[8126] = {
		Title = "طبق أيوثايا الشهير عالميا، توم يوم غونغ",
		Description = {
			"عليك الآن الحصول على ^CE0000الفلفل الحار^000000 وبقية المواد من السوق. اسأل التاجر هناك لتعرف المواد المطلوبة."
		},
		Summary = "أحضر 30 حبة فلفل حار والمواد الأخرى إلى مالي الحارة"
	},
	[8127] = {
		Title = "رحلة موموتارو الميدانية",
		Description = {
			"قال الزعيم إن دوكيبي جمع 20 مليون زيني من اختراق حسابات الآخرين. ولأن أهل البلدة يقضون وقتهم في الجلوس والدردشة، فمستواهم منخفض ولا يستطيعون هزيمته. اقض عليه نيابة عنهم."
		},
		Summary = "اهزم دوكيبي"
	},
	[8128] = {
		Title = "رحلة موموتارو الميدانية",
		Description = {
			"انتهت قصة موموتارو. عد إلى الناشرة التي قابلتها في البداية لتحصل على مكافأتك."
		},
		Summary = ""
	},
	[8129] = {
		Title = "رحلة موموتارو الميدانية",
		Description = {
			"يفترض أن يعيدك المدرب الآن، لكنه سيمنحك فرصة أخيرة. إن فشلت، ^3163FFفلن تستطيع خوض هذا التحدي مجددا.^000000 وستكون المعركة شاقة."
		},
		Summary = "اقض على دوكيبي"
	},
	[8130] = {
		Title = "رحلة موموتارو الميدانية",
		Description = {
			"أثنى المدرب على مهارتك وأراك المخرج بعد انتهاء الوقت. لا تنس العودة إلى الناشرة لاستلام مكافأتك."
		},
		Summary = ""
	},
	[8131] = {
		Title = "والدة حاكم أماتسو",
		Description = {
			"تستريح والدة حاكم أماتسو في هذا المنزل. إنها مريضة منذ أشهر وتحتاج إلى الهدوء."
		},
		Summary = ""
	},
	[8132] = {
		Title = "والدة حاكم أماتسو",
		Description = {
			"طلب منك إيشيدا يوشيناغا، سيد قصر توكوجيو، علاج والدته. تقيم في منزل خارج القصر؛ عد إليه بعد أن تعرف سبب مرضها وتعالجها."
		},
		Summary = "اعثر على علاج لوالدة الحاكم"
	},
	[8133] = {
		Title = "أغنية الثعلب",
		Description = {
			"أيها الكاهن، أيها الكاهن~ ثعلب يلاحقني! إن لم يرحل حين أصرخ وأصيح، فسيساعدني كاهن الضريح الشمالي~ رال رال را، رال رال را، رال رال را رال رال را~~"
		},
		Summary = ""
	},
	[8134] = {
		Title = "الفتى عند المعبد الشمالي",
		Description = {
			"قال تاكيهو إن روحا أقوى تستطيع طرد الثعلب من جسد الإنسان. اصرخ أمام والدة الحاكم وأظهر قوة روحك!"
		},
		Summary = ""
	},
	[8135] = {
		Title = "طرد الثعلب",
		Description = {
			"^FF6060عواء! عواء! عواء! أيها الإنسان! كيف تجرؤ على طردي من هذا الجسد! اللعنة عليك! سألعن عائلة إيشيدا، فاحذر مني!^000000"
		},
		Summary = "خذ ذيل الثعلب دليلا وعد إلى إيشيدا يوشيناغا"
	},
	[8136] = {
		Title = "تحذير من الذئب الرمادي",
		Description = {
			"قابلت ذئبا رماديا حذرك من شخص يدعى كوشي الخالد، وطلب منك مغادرة هذا المكان. لكن من يكون كوشي بالضبط؟ ربما يعود الذئب الرمادي ليشرح لك المزيد..."
		},
		Summary = ""
	},
	[8137] = {
		Title = "العثور على صانع المفاتيح",
		Description = {
			"يبدو أن كوشي كائن شرير خالد ختمته فتاة تدعى ماريا. يجب تحرير ماريا من سجنها الحجري بالعثور على صانع مفاتيح ليصنع ^0000ffالمفتاح الذهبي^000000."
		},
		Summary = ""
	},
	[8138] = {
		Title = "طلب الحداد",
		Description = {
			"طلب منك الحداد إحضار 25 قطعة فولاذ. ووعدك بشرح كيفية صنع \"المفتاح الذهبي\" بعد إحضارها."
		},
		Summary = ""
	},
	[8139] = {
		Title = "المفتاح الذهبي",
		Description = {
			"قال الحداد إن صنع المفتاح الذهبي يتطلب ^0000ffياقوتتين ملعونتين و3 قطع ذهب وخاتما أحمر واحدا وشعرتين من لوسالكا و10 خيوط ذهبية^000000. تحدث مع الحداد ليخبرك بكيفية الحصول على المواد. ولا تنس ارتداء الحذاء الفولاذي المتين."
		},
		Summary = ""
	},
	[8140] = {
		Title = "الخاتم الأحمر",
		Description = {
			"قال الجد فاسيلي إنه كان يملك خاتما أحمر، لكنه أعطاه إلى ابنته ماشينكا التي توفيت للأسف. لديه ابنة أخرى تدعى ريوبابا، وربما تعرف شيئا عن الخاتم الأحمر."
		},
		Summary = "ريوبابا"
	},
	[8141] = {
		Title = "خاتم ماشينكا الأحمر",
		Description = {
			"أخبرتك ريوبابا بأن أختها ماشينكا كانت ترتدي الخاتم الأحمر على الأرجح عندما اختفت قرب المستنقع."
		},
		Summary = ""
	},
	[8142] = {
		Title = "البحث في المستنقع",
		Description = {
			"تحدثت مع راعية قرب المستنقع، وطلبت منك إحضار ^0000ff‏25 غصنا مدببا^000000 أثناء بحثك عن ماشينكا وخاتمها الأحمر."
		},
		Summary = ""
	},
	[8143] = {
		Title = "صوت الناي",
		Description = {
			"صنعت لك الراعية نايا خشبيا من الأغصان التي أحضرتها. وعند العزف عليه، يغني صوت غريب أغنية حزينة. اسأل ريوبابا عن الصوت الذي يغني داخل الناي."
		},
		Summary = ""
	},
	[8144] = {
		Title = "اعتراف ريوبابا",
		Description = {
			"لن ترتاح إن لم تخبر فاسيلي بالحقيقة عما حدث بين ابنتيه. أخبره بما اعترفت به ريوبابا بشأن ماشينكا، وأحضر الناي الخشبي دليلا."
		},
		Summary = ""
	},
	[8145] = {
		Title = "طلب الأم القلقة",
		Description = {
			"قابلت أما قلقة أخبرتك بقصة حورية الماء لوسالكا، التي قد تكون ابنتها أو لا تكون. واصل الحديث مع الأم القلقة."
		},
		Summary = ""
	},
	[8146] = {
		Title = "العثور على لوسالكا",
		Description = {
			"للعثور على حورية الماء لوسالكا، عليك البحث قرب المياه بين الساعة 5 مساء والساعة 6 صباحا بتوقيت PST، وإحضار ماء مقدس لحماية نفسك من نظرتها الخطيرة."
		},
		Summary = ""
	},
	[8147] = {
		Title = "حبيب لوسالكا",
		Description = {
			"طلبت منك لوسالكا العثور على حبيبها إيغور في عاصمة مملكة رون ميدغارد، وتسليمه قرطيها الذهبيين وإبلاغه بأن يتوقف عن المعاناة."
		},
		Summary = ""
	},
	[8148] = {
		Title = "حبيب لوسالكا",
		Description = {
			"عثرت على مسافر من موسكوفيا سافر إلى برونتيرا مع إيغور، لكنهما افترقا لاحقا. قال إن إيغور اتجه إلى صحراء... وأقرب صحراء تعرفها هي..."
		},
		Summary = ""
	},
	[8149] = {
		Title = "البحث عن إيغور",
		Description = {
			"قال قروي في موروك إنه ربما رأى إيغور يدخل الهرم. ربما تمكنت أخيرا من تعقبه لتسليمه قرطي لوسالكا الذهبيين."
		},
		Summary = ""
	},
	[8150] = {
		Title = "رسالة إيغور",
		Description = {
			"طلب منك إيغور العودة إلى لوسالكا وإخبارها بأنه ما زال يحبها. ربما توافق الآن على منحك شعرها لصنع المفتاح الذهبي. تذكر إحضار \"ماء مقدس\" عند التحدث معها لحماية نفسك من نظرتها."
		},
		Summary = ""
	},
	[8151] = {
		Title = "كهف ماروزكا",
		Description = {
			"قال ماروزكا إنه يحتاج إلى اختبار مدى جدارتك بقتال كوشي. أحضر له 100 قطعة بسكويت مخبوز جيدا من الفرن الحجري و100 تفاحة من شجرة التفاح داخل كهفه."
		},
		Summary = ""
	},
	[8152] = {
		Title = "الخيط الذهبي",
		Description = {
			"أحضرت البسكويت والتفاح إلى ماروزكا. قال إن صنع الخيط الذهبي سيستغرق بعض الوقت. عد بعد ساعة واحدة، وسيكون جاهزا بالتأكيد."
		},
		Summary = ""
	},
	[8153] = {
		Title = "اختبار العقل والحكمة",
		Description = {
			"عليك اجتياز جميع اختبارات ماروزكا، وسيمنحك الخيط الذهبي الذي صنعه."
		},
		Summary = ""
	},
	[8154] = {
		Title = "صانع المفاتيح",
		Description = {
			"يوجد صانع المفاتيح في كوخ عميق داخل الغابة. احذر كلماته، ولا تنس تعويذة الحداد الواقية: \"^0000ffحماية درع التعويذة^000000\"."
		},
		Summary = ""
	},
	[8155] = {
		Title = "طلب بابا ياغا",
		Description = {
			"طلبت منك بابا ياغا العثور على بقرتها الهاربة وإلقاء تعويذة العودة عليها. التعويذة هي: \"^ff0000العلف الجيد بنكهة البرتقال^000000\"."
		},
		Summary = ""
	},
	[8156] = {
		Title = "طلب بابا ياغا",
		Description = {
			"ألقيت تعويذة العودة على بقرة بابا ياغا. عد إليها وأخبرها بأنك نفذت طلبها."
		},
		Summary = ""
	},
	[8157] = {
		Title = "طلب بابا ياغا",
		Description = {
			"طلبت منك بابا ياغا إيجاد طريقة لإسكات التابوت المزعج خلف منزلها، مقابل أن تصنع لك المفتاح الذهبي."
		},
		Summary = ""
	},
	[8158] = {
		Title = "طلب بابا ياغا",
		Description = {
			"تمكنت من إسكات التابوت المزعج خلف منزل بابا ياغا. عد إليها وأخبرها بأنك نفذت طلبها."
