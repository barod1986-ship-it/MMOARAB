	[21401] = {
		Title = "كوسيرا سيرا",
		Description = {
			"اجمع المواد اللازمة لدراسة صلصة جديدة ثم عد إلى بابي Q: اصطد 10 من تارا فروغ واجمع 5 بيوض ضفادع."
		},
		Summary = "جمع المواد والعودة إلى بابي Q"
	},
	[21402] = {
		Title = "كوسيرا سيرا",
		Description = {
			"اسأل سيرابي على الساحل الجنوبي لكومودو عن كوسيرا سيرا."
		},
		Summary = "التحدث مع سيرابي"
	},
	[21403] = {
		Title = "كوسيرا سيرا",
		Description = {
			"يبدو أن القضاء على 10 من ميغالودون سيساعد على إزالة سموم كوسيرا. اقض عليها ثم عد إلى سيرابي."
		},
		Summary = "القضاء على ميغالودون"
	},
	[21404] = {
		Title = "كوسيرا سيرا",
		Description = {
			"حصلت على كوسيرا سيرا عالية الجودة. قيل إنها أرسلت إلى بابي Q بالفعل، فعد إليه."
		},
		Summary = "التحدث مع بابي Q"
	},
	[21405] = {
		Title = "كوسيرا سيرا",
		Description = {
