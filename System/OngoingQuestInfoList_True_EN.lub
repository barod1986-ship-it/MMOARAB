	[7104] = {
		Title = "تغيير الوظيفة إلى غيلوتين كروس",
		Description = {
			"قالت ميليسا إن الفتاة التي تبحث عنها تدعى إستلدا، وإنها ستمر بعد ساعة بزقاق مسدود في أقصى شمال شرق فينز."
