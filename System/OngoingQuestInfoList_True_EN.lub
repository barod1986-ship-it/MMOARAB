	[8354] = {
		Title = "طلب مركز إدارة العمال المؤقتين للأكشاك",
		IconName = "ico_nq.bmp",
		Description = {
			"لتوظيف عامل مؤقت لكشك بيع أو شراء، تحتاج إلى شهادة توظيف توزعها نقابة التجار. يمكنك مرة واحدة يوميا تنفيذ طلب تعثر عليه ماشا في النقابة، والحصول على شهادة توظيف بدرجة تختلف حسب صعوبة المهمة. أكمل الطلب الذي تلقيته."
		},
		Summary = ""
	},
	[8368] = {
		Title = "ألا ترغب في تجربة عامل مؤقت للكشك؟ - انتظار",
		Description = {
			"حتى دون تنفيذ طلب ماشا المتاح مرة كل 7 أيام، ستمنح شهادة توظيف ترويجية مجانية قابلة للاستخدام لمدة 12 ساعة، مرة يوميا طوال أسبوع واحد."
		},
		Summary = "إعادة الضبط الساعة 04:00"
	},
