	},
	[21219] = {
		Title = "المومياء والصندوق الأزرق",
		Description = {
			"بناء على طلب قائد المجموعة ماكسيم ورفاقه الذين ما زالوا متعلقين بالصندوق الأزرق، اصطد ^0000FF10 من المومياء وأحضر متاع ميت واحدا^000000."
