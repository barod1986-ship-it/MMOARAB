		Summary = "تحدث مع غابرييل فالنتاين"
	},
	[3012] = {
		Title = "تغيير الوظيفة إلى فارس صليبي",
		Description = {
			"\"تحتاج إلى معرفة كافية للتأهل. يؤسفني أن عليك الدراسة أكثر. عد عندما تصبح مستعدا.\""
