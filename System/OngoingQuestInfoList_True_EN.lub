		Summary = "أبلغ عالم اللغات من أرونافلتز"
	},
	[8245] = {
		Title = "التحقيق في عينات اللغات",
		Description = {
			"اعثر على ساحر رون ميدغارد المتجول داخل معسكر البعثة."
		},
		Summary = ""
	},
	[8246] = {
		Title = "التحقيق في عينات اللغات",
		Description = {
			"هل قابلت العرقين الجديدين؟ دفن المغتالون جواهر في تلك المنطقة، لكن احذر عند جمعها، فقد وضعوا عليها بعض الفخاخ."
		},
		Summary = "اعثر على الجواهر وأعدها إلى ساحر رون ميدغارد"
	},
	[8247] = {
		Title = "تقدم البحث",
		Description = {
			"سأرسل الأصوات المستخرجة من الجواهر إلى عالم اللغات من أرونافلتز. إن لم تكن مشغولا، فتحقق من تقدم أبحاثه."
		},
		Summary = ""
	},
	[8248] = {
		Title = "تقدم البحث",
		Description = {
			"كيف سنجمع هذه البيانات الهائلة ونحولها إلى مترجم محمول؟ اسأل عن رأي المهندس الميكانيكي من شفارتزفالد."
		},
		Summary = ""
	},
	[8249] = {
		Title = "ضغط المعلومات",
		Description = {
			"عد إلى ساحر رون ميدغارد واسأله إن كان يعرف كيفية ضغط المعلومات باستخدام السحر."
		},
		Summary = ""
	},
	[8250] = {
		Title = "جوهرة التخزين",
		Description = {
			"توجد خارج فراغ الرماد ^0000ffأحجار غامضة جدا لا توجد في ميدغارد^000000. هل يمكنك إحضار واحد منها؟"
		},
		Summary = "اعثر على معدن مجهول وأحضره إلى الساحر ويسبر"
	},
	[8251] = {
		Title = "حقن السحر",
		Description = {
