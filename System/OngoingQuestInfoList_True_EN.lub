		Summary = "اعثر على آثار تيرا"
	},
	[7058] = {
		Title = "الرسول - طلب آرك",
		IconName = "ico_ep.bmp",
		Description = {
			"سقطت بين جذور شجرة ضخمة، وعثرت على قبيلة عمالقة تدعى \"سافا\"، أجسادهم صلبة كالصخور وضخمة كالجبال. لا يبدو أن هناك آثارا أخرى لتيرا."
		},
		Summary = "أبلغ آرك"
	},
	[7059] = {
		Title = "الرسول - مكان تيرا",
		IconName = "ico_ep.bmp",
		Description = {
			"يشعر آرك بالقلق لأن تيرا غادرت المختبر ومعها براديوم دون إذن. ربما ذهبت إلى قبيلة \"سافا\" الموجودة في ذلك \"الكهف\" حاملة البراديوم."
		},
		Summary = "اعثر على تيرا"
	},
	[7060] = {
		Title = "الرسول - مكان تيرا",
		IconName = "ico_ep.bmp",
		Description = {
			"عندما وصلت إلى قبيلة سافا، كانت تيرا قد رحلت منذ وقت طويل. تناثرت قطع معدنية لامعة جدا حول العملاق المتصلب. لا بد أن هذه القطع هي البراديوم."
		},
		Summary = "إن كان البراديوم مرتبطا بالأمر... فهل يتعلق بقبيلة سافا؟"
	},
	[7061] = {
		Title = "الرسول - مكان تيرا",
		IconName = "ico_ep.bmp",
		Description = {
