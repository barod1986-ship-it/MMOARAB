		Summary = ""
	},
	[18019] = {
		Title = "أغاني فيتر",
		Description = {
			"اعثر على أصدقاء فيتر بالترتيب التالي: تشادا في برونتيرا، وغيز في غيفن، ونوسدان في كومودو. استمع إلى أغانيهم ثم غنها لفيتر."
		},
		Summary = "العثور على تشادا وغيز ونوسدان"
	},
	[18020] = {
		Title = "أغاني فيتر",
		Description = {
			"استمعت إلى أغنية تشادا، وحان وقت العثور على غيز في غيفن."
