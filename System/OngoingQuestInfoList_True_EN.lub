		Summary = "البحث عن شخص في قصر غو يانغ الكئيب"
	},
	[16101] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"سلم زجاجة نبيذ الطهي إلى ليكولان في أكاديمية كيل هاير الواقعة جنوب شرق هذا المكان."
		},
		Summary = ""
	},
	[16102] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"قد تحتاج إيلي إلى بعض المساعدة. تحدث معها."
		},
		Summary = ""
	},
	[16103] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"اعثر على مكونات كعك إيلي. يمكنك الحصول على النبيذ من حانة في يونو، والكاكاو من يويو، والدقيق والبيض من كشك الخبز المحمص في يونو."
		},
		Summary = ""
	},
	[16104] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"اذهب إلى صاحب طاحونة الهواء في أحياء لايت هالزن الفقيرة للحصول على الدقيق والبيض من أجل سيزو."
		},
		Summary = ""
	},
	[16105] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"أعد طرد التوصيل إلى سيزو في يونو."
		},
		Summary = ""
	},
	[16106] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"سلم طرد التوصيل إلى إيلي في أكاديمية كيل هاير."
		},
		Summary = ""
	},
	[16107] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"انتظر حتى تنتهي إيلي من خبز الكعك."
		},
		Summary = ""
	},
	[16108] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"سلم البسكويت المخبوز جيدا إلى جد إيلي في كوخ كيل هاير، الواقع على بعد خريطة واحدة شمال الأكاديمية."
		},
		Summary = ""
	},
	[16109] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"عد إلى إيلي وأخبرها بأن جدها غير موجود في الكوخ."
		},
		Summary = ""
	},
	[16110] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"عد إلى كوخ كيل هاير مجددا. أعطتك إيلي مفتاح الكوخ، وينبغي أن يتيح لك الدخول عبر الباب الجانبي."
		},
		Summary = ""
	},
	[16111] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"عثرت على مذكرة مطوية مكتوب عليها: \"6 خطوات إلى الأمام، و3 إلى اليسار، و3 إلى الأمام، و4 إلى اليسار\"."
		},
		Summary = ""
	},
	[16112] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"عثرت على رسالة موجهة إلى إيلي. من الأفضل أن تسلمها إليها."
		},
		Summary = ""
	},
	[16113] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"واصل حديثك مع إيلي."
		},
		Summary = ""
	},
	[16114] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"فتش غرفة الدراسة في الكوخ بحثا عن أدلة ربما تركها جد إيلي لها. بعد العثور على شيء في الكوخ، اذهب إلى السكن الواقع خلف أكاديمية كيل هاير."
		},
		Summary = ""
	},
	[16115] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"عثرت على ورقة فارغة تحمل ختم مؤسسة كيل هاير. من الغريب وجود ختم على ورقة فارغة..."
		},
		Summary = ""
	},
	[16116] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"استخدمت الحبر الأزرق على الورقة الفارغة، فظهرت قصيدة غريبة كتبها ^0000ffالشيطان الصغير الضائع^000000. ماذا يمكن أن تعني؟"
		},
		Summary = ""
	},
	[16117] = {
		Title = "خريطة العالم الغامضة",
		Description = {
			"اعثر على شيء يساعدك على نزع الخريطة من الجدار."
		},
		Summary = ""
	},
	[16118] = {
		Title = "القصيدة المخفية",
		Description = {
			"عثرت خلف الخريطة على ورقة تحمل قصيدة. ربما توجد أدلة أخرى مخفية في هذا المكان."
		},
		Summary = ""
	},
	[16119] = {
		Title = "سيوف الأفاعي",
		Description = {
			"عندما ضغطت الزر الموجود في الحوض، صدر صوت معدني من الدرج عند الممر."
		},
		Summary = ""
	},
	[16120] = {
		Title = "هل كان حلما؟",
		Description = {
			"انجرف وعيك إلى مكان ما... افحص أنابيب الاختبار."
		},
		Summary = ""
	},
	[16121] = {
		Title = "رمز سري؟",
		Description = {
			"طلب منك الصوت الصادر من أنبوب الاختبار ألا تنسى الأرقام ^FF00004^333333، ^FF00007^333333، ^FF00007^333333، ^FF00002^333333، ^FF00009^333333، ^FF00006^333333، ^FF00001^333333."
		},
		Summary = ""
	},
	[16122] = {
		Title = "مفتاح برونزي قديم",
		Description = {
			"عثرت على مفتاح برونزي قديم داخل توت قرع. ترى ما الذي يفتحه هذا المفتاح؟"
		},
		Summary = ""
	},
	[16123] = {
		Title = "بطاقة مفتاح خضراء",
		Description = {
			"عثرت على بطاقة مفتاح خضراء داخل الصندوق المقفل. ترى فيم تستخدم؟"
		},
		Summary = ""
	},
	[16124] = {
		Title = "صندوق فولاذي",
		Description = {
			"عثرت على صندوق فولاذي داخل الخزنة خلف رف الكتب. قد يكون هذا ما أراد جد إيلي منها العثور عليه!"
		},
		Summary = ""
	},
	[16125] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"عثرت في سلة كعك إيلي على مذكرة تقول إنها رأت الشبح. تتذكر بصورة غامضة أنها قالت إن عليك الصراخ إن أصابتها لعنة: \"استيقظي يا إيلي!\"."
		},
		Summary = ""
	},
	[16126] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"استيقظت إيلي للحظة وأسقطت مفتاحا ذهبيا وزرا فاخرا. حاول إيقاظ إيلي!"
		},
		Summary = ""
	},
	[16127] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"يجب أن تعثر على الغرفة السرية للمصنع عند القبر أمام السكن. استخدم بطاقة المفتاح الصفراء للدخول."
		},
		Summary = ""
	},
	[16128] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"تمكنت من دخول المصنع. اعثر على مخبأ أليسيا واستخدم بطاقة المفتاح الزرقاء للدخول."
		},
		Summary = ""
	},
	[16129] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"أقنعت أليسيا بأنك تساعد إيلي بعدما أريتها المفتاح الذهبي."
		},
		Summary = ""
	},
	[16130] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"حصلت على بطاقة مفتاح حمراء تتيح لك دخول المناطق السرية في المصنع. استخدمها للعثور على كيل هاير."
		},
		Summary = ""
	},
	[16131] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"عثرت على كيل هاير محتجزا خلف باب. أعطاك شظية معدنية وطلب منك تسليمها إلى أليسيا."
		},
		Summary = ""
	},
	[16132] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"اذهب إلى قصر كيل هاير في لايت هالزن. يقع شمال دار المزاد مباشرة. أظهر المفتاح الذهبي للسماح لك بالدخول."
		},
		Summary = ""
	},
	[16133] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"يشعر كيل هاير بالامتنان لمساعدتك. يبدو أن دورك هنا قد انتهى. دعه يستريح الآن وغادر القصر."
		},
		Summary = ""
	},
	[16134] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"نصبت لك العميلة ميتشل ليلى من شركة ريكنبر كمينا. طلبت منك العثور على امرأة مسنة في يونو قد تعرف المزيد عن أليسيا."
		},
		Summary = ""
	},
	[16135] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"حصلت على مفاتيح قصر روزيمير. فتش القصر بعناية وأخبر المرأة المسنة بما عثرت عليه."
		},
		Summary = ""
	},
	[16136] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"طلبت منك المرأة المسنة التحدث مع الصياد الذي يعيش جنوب أكاديمية كيل هاير. فهو من عثر على جثة أليسيا في النهر..."
		},
		Summary = ""
	},
	[16137] = {
		Title = "أكاديمية كيل هاير",
		Description = {
			"حقق في الكوخ القريب من معسكر حرس شوارتزفالد، شرق أكاديمية كيل هاير مباشرة."
		},
		Summary = ""
	},
	[16138] = {
