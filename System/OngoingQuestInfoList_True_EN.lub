	[11246] = {
		Title = "وقت استراحة العمل الجزئي",
		Description = {
			"انتهى عمل اليوم الجزئي."
		},
		Summary = "لنعمل بجد مجددا غدا!"
	},
	[11247] = {
		Title = "الوقت من ذهب!",
		Description = {
			"العمل الجزئي في مقهى باعل الخارجي: الزبائن لن ينتظروا إلى الأبد."
		},
		Summary = "المهلة 30 دقيقة، لذا عد بسرعة"
	},
	[11248] = {
		Title = "مقهى باعل الخارجي",
		Description = {
			"اذهب إلى الطابق السفلي من الكهف الموجود أمامك، واصطد 30 من المخلوقات الحمراء ذات الكماشات، ثم أحضرها إلى ميلكي."
		},
		Summary = "تتنزه ميلكي في مكان ما من هذه الجزيرة"
	},
	[11249] = {
		Title = "مقهى باعل الخارجي",
		Description = {
			"اذهب إلى الطابق السفلي من الكهف الموجود أمامك، واصطد 30 من المخلوقات الزرقاء المتمايلة، ثم أحضرها إلى تروكي."
		},
		Summary = "يتنزه تروكي في مكان ما من هذه الجزيرة"
	},
	[11250] = {
		Title = "مقهى باعل الخارجي",
		Description = {
			"اذهب إلى الطابق السفلي من الكهف الموجود أمامك، واقرأ وصفة رودو السرية، ثم عد!"
		},
		Summary = "توجد الوصفة السرية في مكان ما جنوب شرق الطابق السادس من دهليز إزلود"
	},
	[11251] = {
		Title = "مقهى باعل الخارجي",
		Description = {
			"ستكون قائمة اليوم تمبورا الروبيان المصنوعة من جراد البحر!!! أبلغ الأخ باعل بطلبي جيدا~"
		},
		Summary = "تلقيت الطلب. عد إلى باعل"
	},
	[11252] = {
		Title = "مقهى باعل الخارجي",
		Description = {
			"المكونات حية وطازجة للغاية. سأطلب اليوم نقانق الحبار المحشوة بالكريمة!"
		},
		Summary = "تلقيت الطلب. عد إلى باعل"
	},
	[11253] = {
		Title = "مقهى باعل الخارجي",
		Description = {
			"مكونات كعكة الشوكولاتة البحرية: جراد بحر واحد، وحبار، وروبيان، ومحار، ونافورات بحرية، ومأكولات بحرية متنوعة، وطبقة كعك إسفنجية، وشوكولاتة."
		},
		Summary = "قرأت الوصفة السرية. عد إلى باعل"
	},
	[11254] = {
		Title = "مقهى باعل الخارجي",
		Description = {
			"غضب الزبون وغادر."
		},
		Summary = "عد إلى باعل على أي حال"
	},
	[11255] = {
		Title = "ثعلب الماء سامسون",
		Description = {
			"غيرت تسريحة شعرك باستخدام قسيمة تجميل كرياتورا. لا يمكن استخدام القسيمة إلا مرة واحدة."
		},
		Summary = "أناقة~"
	},
	[11264] = {
		Title = "إعادة تعيين المهمة المقدسة",
		Description = {
			"تمت إعادة تعيين المهمة المقدسة."
		},
		Summary = ""
	},
	[11265] = {
		Title = "ماري بوغيير",
		Description = {
			"حصلت على تعزيز من ماري بوغيير. يمكنك الحصول عليه مجددا بعد 16 ساعة."
		},
		Summary = ""
	},
	[11266] = {
		Title = "مسابقة البطيخ اللذيذ",
		Description = {
			"يمكن العثور على البطيخ في أي مكان من ميدغارد إن بحثت جيدا، لذا لن يكون العثور عليه صعبا."
		},
		Summary = "اعثر على البطيخ ثم عد"
	},
	[11267] = {
		Title = "مسابقة البطيخ اللذيذ",
		Description = {
			"ماتشوني يكذب."
		},
		Summary = "تحدث مع روبيريد"
	},
	[11268] = {
		Title = "مسابقة البطيخ اللذيذ",
		Description = {
			"لن يستمع إلي مهما تحدثت، لذا قل له شيئا من فضلك."
		},
		Summary = "تحدث مع ماتشوني"
	},
	[11269] = {
		Title = "مسابقة البطيخ اللذيذ",
		Description = {
			"لا تحضر بطيخ هذا العام إلي مباشرة، بل خذه إلى طبيبي روبيريد."
		},
		Summary = "تحدث مع روبيريد"
	},
	[11270] = {
		Title = "مسابقة البطيخ اللذيذ",
		Description = {
			"يقال إن مسافرا رأى البطيخ في عالم آخر أيضا."
		},
		Summary = "تحدث مع المسافر فراي قرب نزل ألبرتا"
	},
	[11271] = {
