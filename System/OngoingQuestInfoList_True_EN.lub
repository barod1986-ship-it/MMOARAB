	[8234] = {
		Title = "دراسة سوق برونتيرا",
		Description = {
			"يعرض عدد من تجار NPC في برونتيرا مجموعات من 10 جرعات حمراء بأسعار مختلفة. قارن الأسعار واشتر المجموعة الأرخص."
