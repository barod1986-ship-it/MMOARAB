	[9000] = {
		Title = "بدء اختبار الفارس",
		Description = {
			"أخبرك قائد فرسان برونتيرا، \"هيرمان\"، بأن عليك نيل موافقة جميع الفرسان الآخرين كي تصبح فارسا. ابدأ بالسير أندرو."
		},
		Summary = "تحدث إلى السير أندرو في مقر فرسان برونتيرا.",
	},
	[9001] = {
		Title = "اختبار السير أندرو: المجموعة الأولى",
		Description = {
			"اجمع للسير أندرو 5 شارب الجني المسن، و5 جناح خفاش أحمر، و5 قسيمة اوركية، و5 غبار عثة، و5 لسان زاحف، و5 لبدة."
		},
		Summary = "اجمع المواد الست ثم عد إلى السير أندرو.",
	},
	[9002] = {
		Title = "اختبار السير أندرو: المجموعة الثانية",
		Description = {
			"اجمع للسير أندرو 5 ساق حشرة، و5 قلب حورية البحر، و5 زهرة آكلة البشر، و5 لحم محار، و5 مقلاة قديمة، و5 صدفة حلزون."
		},
		Summary = "اجمع المواد الست ثم عد إلى السير أندرو.",
	},
	[9003] = {
		Title = "اختبار المعرفة والشرف",
		Description = {
			"اجتزت اختبار الولاء لدى السير أندرو. توجه الآن إلى السير جيمس سيراكيوز لاختبار معرفتك بالفروسية ومبادئ الشرف."
		},
		Summary = "تحدث إلى السير سيراكيوز في مقر الفرسان.",
	},
	[9004] = {
		Title = "اختبار السير ويندسور",
		Description = {
			"اجتزت اختبار السير سيراكيوز. توجه إلى السير ويندسور بنديكت لبدء اختبار القتال."
		},
		Summary = "تحدث إلى السير ويندسور في مقر الفرسان.",
	},
	[9005] = {
		Title = "دخول اختبار القتال",
		Description = {
			"طلب منك السير ويندسور دخول غرفة الانتظار. ستواجه ثلاث مراحل من الوحوش، ولكل مرحلة ثلاث دقائق."
		},
		Summary = "ادخل غرفة الانتظار وابدأ الاختبار.",
	},
	[9006] = {
		Title = "اختبار القتال",
		Description = {
			"اهزم جميع الوحوش في المراحل الثلاث خلال المهلة المحددة."
		},
		Summary = "أكمل المراحل الثلاث؛ لكل مرحلة 3 دقائق.",
	},
	[9007] = {
		Title = "اختبار الآداب",
		Description = {
			"اجتزت اختبار القتال لدى السير ويندسور. توجه إلى السيدة إيمي بياتريس لاختبار آداب الفارس."
		},
		Summary = "تحدث إلى السيدة إيمي في مقر الفرسان.",
	},
	[9008] = {
		Title = "أسئلة السيدة إيمي",
		Description = {
			"أجب عن أسئلة السيدة إيمي كما يتصرف فارس مهذب ومسؤول تجاه مجموعته والآخرين."
		},
		Summary = "أكمل اختبار الآداب لدى السيدة إيمي.",
	},
	[9009] = {
		Title = "اختبار الصبر",
		Description = {
			"اجتزت اختبار الآداب. توجه إلى السير إدموند غروستر لتتعلم الوقار والصبر."
		},
		Summary = "تحدث إلى السير إدموند في مقر الفرسان.",
	},
	[9010] = {
		Title = "إثبات الصبر",
		Description = {
			"أثبت صبرك من دون قتل أي وحش في غرفة الاختبار، وانتظر ظهور بوابة الخروج."
		},
		Summary = "لا تقتل الوحوش وانتظر بوابة الخروج.",
	},
	[9011] = {
		Title = "الاختبار الأخير",
		Description = {
			"اجتزت اختبار الصبر. تحدث إلى السير غراي بروسفيرو لإجراء المقابلة الأخيرة."
		},
		Summary = "تحدث إلى السير غراي في مقر الفرسان.",
	},
	[9012] = {
		Title = "قرار فرسان برونتيرا",
		Description = {
			"أكملت جميع الاختبارات. عد إلى القائد هيرمان ليجتمع الفرسان ويقرروا أمر تغيير وظيفتك."
		},
		Summary = "عد إلى قائد فرسان برونتيرا.",
	},
	[9013] = {
		Title = "تغيير الوظيفة إلى ساحر عظيم",
		Description = {
			"الاختبار الأول لدى كاثرين هو جمع الجواهر. اجمع 10 من كل من الجوهرة الحمراء والزرقاء والصفراء."
		},
		Summary = "أحضر المواد المطلوبة"
	},
	[9014] = {
		Title = "تغيير الوظيفة إلى ساحر عظيم",
		Description = {
			"الاختبار الأول لدى كاثرين هو جمع أحجار العناصر. اجمع 5 من كل من \"كريستال أزرق\" و\"جرين لايف\" و\"دم أحمر\" و\"ريح الخضرة\"."
		},
		Summary = "أحضر المواد المطلوبة"
	},
	[9015] = {
		Title = "تغيير الوظيفة إلى ساحر عظيم",
		Description = {
			"اجتزت اختبار كاثرين الأول. تحدث الآن إلى الساحر العظيم الكئيب راوليل."
		},
		Summary = "تحدث إلى راوليل"
	},
	[9016] = {
		Title = "تغيير الوظيفة إلى ساحر عظيم",
		Description = {
			"المرحلة الثانية هي الاختبار الكتابي لدى راوليل. أجب عن أسئلته بصورة صحيحة."
		},
		Summary = "تحدث إلى راوليل"
	},
	[9017] = {
		Title = "تغيير الوظيفة إلى ساحر عظيم",
		Description = {
			"المرحلة الثالثة اختبار عملي في غرف الماء والأرض والنار. استخدم العنصر المناسب لهزيمة الوحوش في الوقت المحدد."
		},
		Summary = "اجتز غرف العناصر الثلاث"
	},
	[9018] = {
		Title = "اعتمادك ساحرا عظيما!",
		Description = {
			"اجتزت جميع اختبارات راوليل. عد إلى كاثرين لإتمام تغيير الوظيفة إلى ساحر عظيم."
		},
		Summary = "تحدث إلى كاثرين"
	},
	[9024] = {
		Title = "فتى المهمات من إينبروخ",
		Description = {
			"ساعد عامل المهمات القادم من إينبروخ إلى برونتيرا بجمع 100 من <ITEM>جيلوبي<INFO>909</INFO></ITEM>."
		},
		Summary = "اجمع 100 جيلوبي وعد إلى عامل المهمات"
	},
	[9028] = {
		Title = "هيدرا غريبة",
		Description = {
			"ظهرت هيدرا غريبة في ^993399برازيليس^000000. استخدم <ITEM>كرة هايدرا<INFO>12408</INFO></ITEM> التي حصلت عليها من ^0000FFلوسيا^000000 للإمساك بـ^0000FFهيدرا غريبة^000000."
		},
		Summary = "أمسك بهيدرا غريبة"
	},
	[9029] = {
