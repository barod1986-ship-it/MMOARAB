	[7672] = {
		Title = "الحملان تواصل الهرب",
		Description = {
			"يبدو أن كلب الحراسة يخيف الحملان باستمرار. عد بعد بضع ساعات، فغالبا سيكون بوري قد فقد المزيد من الحملان."
