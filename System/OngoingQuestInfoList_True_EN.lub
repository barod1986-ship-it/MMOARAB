	[16098] = {
		Title = "الغريب في جزيرة السلاحف 2",
		Description = {
			"أخبرتك الفتاة عن عدة أماكن. ابحث عن آثار البروفيسور إييربين في قرية يانغو الموحشة."
		},
		Summary = "البحث عن شخص في قرية يانغو الموحشة"
	},
	[16099] = {
		Title = "الغريب في جزيرة السلاحف 3",
		Description = {
