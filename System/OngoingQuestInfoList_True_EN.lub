	[12026] = {
		Title = "أرشيف ريكنبر السري",
		Description = {
			"تسلل إلى الأرشيف السري باستخدام تصريح ليستين عند تبدل نوبات الحراس. يوجد شيء مكتوب على ظهر التصريح. أحضر أي دليل تعثر عليه."
		},
		Summary = ""
	},
	[12027] = {
		Title = "أرشيف ريكنبر السري",
		Description = {
			"اعثر على إيسونا خارج لايت هالزن وأبلغها بالمعلومات التي عثرت عليها في الأرشيف السري."
		},
		Summary = ""
	},
	[12028] = {
		Title = "كوريل الخائن",
		Description = {
			"عد إلى الرئيس وأبلغه بخيانة كوريل، عضو الجناح السري. ثم عد إلى غالشتاين لتحصل على ترياق السم الأحمر الذي أعطاك إياه."
		},
		Summary = ""
	},
	[12029] = {
		Title = "خاتم الخطوبة المفقود",
		Description = {
			"ساعد شودا في العثور على خاتم خطوبتها الذي ألقاه خطيبها أنون في الماء. ينبغي أن تجد أداة مناسبة لانتشاله."
		},
		Summary = ""
	},
	[12030] = {
		Title = "العثور على خاتم الخطوبة",
		Description = {
			"عثرت على خاتم خطوبة شودا داخل وحش فين اصطدته من الماء. أعده إليها."
		},
		Summary = "شودا"
	},
	[12031] = {
		Title = "العثور على أنون",
		Description = {
			"بعد أن استعادت شودا خاتم خطوبتها، عليك العثور على أنون وإخباره بذلك. لا بد أن أحدا قد رآه."
		},
		Summary = ""
	},
	[12032] = {
		Title = "البحث عن أنون",
		Description = {
			"قابلت رجلا مسنا قال إن شابا مر بجانبه مسرعا نحو الغابة. هل يمكن أن يكون أنون؟ ابحث في الغابة عن أي أثر يدل على مكانه."
		},
		Summary = "آثار أقدام أنون"
	},
	[12033] = {
		Title = "آثار دماء",
		Description = {
			"عثرت على آثار دماء. يبدو أن من ركض في هذا الاتجاه كان مصابا. تقود الآثار نحو الشمال... لا بد أن أنون موجود في مكان قريب."
		},
		Summary = ""
	},
	[12034] = {
		Title = "رواية أنون",
		Description = {
			"عثرت على مكان غريب تغطيه آثار دماء إضافية. لا بد أن أنون هنا... عندما تعثر عليه، اسأله لماذا هرب من شودا."
		},
		Summary = ""
	},
	[12035] = {
		Title = "خيوط مقدسة",
		Description = {
			"طلب منك بونثوم إحضار المواد التالية لصنع عنصر ذي قوة مقدسة: حزمة إبر واحدة، وبكرة خيط واحدة، وقشرة صلبة واحدة، وقارورة ماء مقدس واحدة. بعد ذلك ستتمكن من دخول الطابق الأول من الزنزانة تحت الأرض."
		},
		Summary = ""
	},
	[12036] = {
		Title = "رسالة اللوح الحجري",
		Description = {
