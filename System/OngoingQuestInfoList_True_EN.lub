		},
		Summary = "تحدث مع بائعة عصير البطيخ"
	},
	[11276] = {
		Title = "مسابقة البطيخ اللذيذ",
		Description = {
			"من الأفضل أن نبلغ أولا بأن هناك شخصا تضرر بسبب المسابقة."
		},
		Summary = "عد إلى روبيريد"
	},
	[11277] = {
		Title = "مسابقة البطيخ اللذيذ",
		Description = {
			"لا أستطيع القول إنني لم أتوقع ذلك إطلاقا، لكنني لم أتخيل أن تكون الأضرار كبيرة إلى هذا الحد. من الأفضل مناقشة هذا الأمر مع سيدي."
		},
		Summary = "تحدث مع ماتشوني"
	},
	[11278] = {
		Title = "مسابقة البطيخ اللذيذ",
		Description = {
			"امنحني بعض الوقت للتفكير."
		},
		Summary = "تحدث مع ماتشوني"
	},
	[11279] = {
		Title = "مسابقة البطيخ اللذيذ",
		Description = {
			"لا يبدو أنه قرار يمكنني اتخاذه وحدي. هل يمكنك سؤالها عن رأيها؟"
		},
		Summary = "اذهب إلى لوتي وقابل بائعة عصير البطيخ"
	},
	[11280] = {
		Title = "مسابقة البطيخ اللذيذ",
		Description = {
			"يقال إن ساحرا يدعى كونغ كونغ في غيفن يستطيع إلقاء تعويذة على البطيخ إن أحضرته إليه."
		},
		Summary = "قابل الساحر كونغ كونغ في غيفن"
	},
	[11281] = {
		Title = "مسابقة البطيخ اللذيذ",
		Description = {
			"لا يمكنني تعليمك طريقة حفظ البطيخ لأنها سر تجاري، لكن إن أحضرت البطيخ إلي فسألقي عليه تعويذة."
		},
		Summary = "اجمع 30 بطيخة، وهي من أشهر فواكه الصيف في ميدغارد"
	},
	[11282] = {
		Title = "مسابقة البطيخ اللذيذ",
		Description = {
			"كلما ارتفع مستوى ملقي التعويذة، بدا السحر أسهل وأبسط."
		},
		Summary = "حصلت على البطيخ المسحور. عد إلى روبيريد"
	},
	[11283] = {
		Title = "مسابقة البطيخ اللذيذ",
		Description = {
			"لا يبدو مختلفا كثيرا عن البطيخ العادي، أليس كذلك؟ بهذا يمكنني أخيرا مغادرة الحمام. أسرع وأبلغ سيدي بهذه الأخبار السارة!!!"
		},
		Summary = "تحدث مع ماتشوني"
	},
	[11284] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"تبدو <ITEM>ضمادة متعفنة<INFO>930</INFO></ITEM> متسخة، لكنها منقوعة في عصارة خاصة وتملك قوى مميزة. تكفي ضمادتان لتغطية القدمين."
		},
		Summary = "سلم ضمادتين متعفنتين وتحدث مجددا"
	},
	[11285] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"لا أعرف إن كان الباب مغلقا أو عالقا، لكن بما أنه لا يمكن فتحه منفردا، فلندفعه معا!"
		},
		Summary = "افتح الباب مع لاس"
	},
	[11286] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"دفعت الباب بكل قوتك، لكنه لم يتحرك."
		},
		Summary = "تحدث مع لاس"
	},
	[11287] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"سأتواصل مع المكتب الرئيسي مجددا. هل يمكنك سؤال القرويين عن هذا المستشفى؟"
		},
		Summary = "تحدث مع فتاة القرية الموجودة على اليمين"
	},
	[11288] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"لا أعرف الكثير. المستشفى مغلق منذ زمن طويل، ومن الغريب وصول ممرضة جديدة."
		},
		Summary = "لا يبدو أن فتاة القرية تعرف الكثير. عد إلى لاس"
	},
	[11289] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"لم يكن المكتب الرئيسي ليرسلني إلى مكان كهذا دون التأكد. هل يمكنك التحدث مع قروي آخر؟"
		},
		Summary = "تحدث مع رجل القرية جنوب المستشفى"
	},
	[11290] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"علي إبلاغهم بهذه المعلومات بسرعة. أعتذر، لكن هل يمكنك الذهاب مع الممرضة إلى النزل الموجود وسط القرية؟"
		},
		Summary = "عد إلى لاس حاليا"
	},
	[11291] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"قدماي تؤلمانني ولا أستطيع الحركة. هل يمكنك الذهاب إلى النزل بمفردك؟"
		},
		Summary = "قابل الطبيب في النزل الواقع وسط القرية"
	},
	[11292] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"لا أستطيع الذهاب إلى المستشفى الآن لأن لدي مرضى أعتني بهم. هل يمكنك العودة بالمفتاح وإخبارها: \"افعلي ما تشائين\"؟"
		},
		Summary = "عد إلى لاس"
	},
	[11293] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"أدخلت المفتاح في ثقب باب المستشفى، لكن الباب لا يبدو مقفلا."
		},
		Summary = "تحدث مع لاس"
	},
	[11294] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"يبدو أن الصوت يأتي من الأعشاب قرب مدخل المستشفى."
		},
		Summary = "حقق في المنطقة القريبة"
	},
	[11295] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"لم أتفحصه جيدا خوفا من الإمساك بي، لكنني أتذكر رؤية عصا عندما ذهبت إلى هناك منذ زمن بعد وفاة جدتي."
		},
		Summary = "حقق في محيط المستشفى"
	},
	[11296] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"نزعت العصا المغروسة بعمق. يبدو أن أجواء المستشفى الكئيبة أصبحت أشد."
		},
		Summary = "من الأفضل أخذ تعويذة أغيمات هذه إلى لاس"
	},
	[11297] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"هل يمكنك زيارة جدتي من فضلك؟ سأتجول هنا لتفقد المستشفى."
		},
		Summary = "زر جدتها غرب القرية، شمال المستشفى بقليل"
	},
	[11298] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"توقعت حدوث شيء كهذا عندما قطعوا شجرة القرية القديمة لبناء المستشفى."
		},
