	[7182] = {
		Title = "زيارة سافا",
		Description = {
			"تنتشر شائعات عن وصول أحد أفراد سافا من مانوك لزيارة المعسكر. يثق بي أيلو، ولذلك عينني للتحدث معه. يوجد المندوب في الغرفة اليمنى بالطابق الثاني."
