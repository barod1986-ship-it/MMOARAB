	[6021] = {
		Title = "قسيمة اعتماد قرن الثور الحكيم",
		Description = {
			"\"يمكنني إعداد قسيمة اعتماد تثبت رغبتك في أن تصبح محاربا من محاربي الأرض، لتقدمها إلى مدربي رماة المسدسات.\""
