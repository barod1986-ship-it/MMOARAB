		Summary = ""
	},
	[7641] = {
		Title = "السماح بالدخول",
		Description = {
			"تمت الموافقة على دخول المنطقتين المحظورتين \"المختبرات\" و\"مرافق الأبحاث\". يمكنك من الآن دخول المختبرات ومرافق الأبحاث بحرية."
