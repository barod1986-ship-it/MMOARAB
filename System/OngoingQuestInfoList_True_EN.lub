		Summary = "السيد كيد"
	},
	[7013] = {
		Title = "مطاردة رايان مور",
		Description = {
			"...أوضحت أنك لا تشعر بالراحة تجاه القيام بالأعمال الصغيرة، ونصحك السيد كيد بأن تخبر إكيناسيا بوضوح أنك لا تريد هذه المهمة."
		},
		Summary = "إكيناسيا"
	},
	[7014] = {
		Title = "مطاردة رايان مور",
		Description = {
			"...مع ذلك، لم تتمكن من إقناع إكيناسيا. عد وساعد السيد كيد مهما حدث."
		},
		Summary = "السيد كيد"
	},
	[7015] = {
		Title = "مطاردة رايان مور",
		Description = {
