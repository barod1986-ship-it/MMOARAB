	[3009] = {
		Title = "تغيير الوظيفة إلى فارس صليبي",
		Description = {
			"\"أرى فيك إمكانات الفارس الصليبي. قابل ^0000FFموريناك ميول^000000 في السجن تحت الأرض داخل قلعة برونتيرا، وتحدث إليه أولا.\""
