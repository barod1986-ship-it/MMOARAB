	[11038] = {
		Title = "لقاء الموتى",
		Description = {
			"أخبر إيلي بأن كل ما حدث قبل شهر كان خطئي. اذهب إلى مدينة الموتى وسلم رسالة إيريوس إلى إيلي."
		},
		Summary = "سلم رسالة إيريوس إلى إيلي"
	},
	[11039] = {
		Title = "لقاء الموتى",
		Description = {
			"شخص تريد مقابلته هناك... أظنك ترغب في التواصل مع شخص ميت... تقع مدينة الموتى شمال هذا المكان.",
			"عليك العثور على رجل يدعى \"فايلين\". من المهم جدا أن تخبره بأن بيليك أرسلك إليه. أحضر له وردة لا تذبل."
		},
		Summary = "أحضر وردة لا تذبل إلى فايلين"
	},
	[11040] = {
		Title = "لقاء الموتى",
		Description = {
			"إن أتيت لمقابلة صديق متوفى، فقد جئت إلى الشخص الخطأ. عد من حيث أتيت."
		},
		Summary = "لا يمكنك الاستسلام الآن. واصل التحدث مع فايلين"
	},
	[11041] = {
		Title = "لقاء الموتى",
		Description = {
			"لا أعرف من أخبرك بإمكانية التواصل مع الموتى... لكنني بالتأكيد لم أكن لأخبرك بذلك. كما أن الحديث في هذه الأمور من المحظورات."
		},
		Summary = "لا يمكنك الاستسلام الآن. واصل التحدث مع فايلين"
	},
	[11042] = {
		Title = "لقاء الموتى",
		Description = {
			"فشل استدعاء إيلي."
		},
		Summary = "عد إلى إيريوس على أي حال"
	},
	[11043] = {
		Title = "لقاء الموتى",
		Description = {
			"أرجوك أعطه هذا الصندوق، واطلب منه أن ينساني. ينبغي له أن يعيش بقية حياته سعيدا مع شخص آخر، وأخبره أنني سامحته."
		},
		Summary = "عد إلى إيريوس وسلمه رسالتها والصندوق"
	},
	[11044] = {
		Title = "الدواء العشبي - مساعدة الطبيبة",
		Description = {
