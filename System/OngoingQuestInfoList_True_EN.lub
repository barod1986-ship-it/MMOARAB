	[7436] = {
		Title = "أفانت عالم السحر",
		Description = {
			"لم تتضمن رسالة كاردوي تعريفا فحسب، بل طلبا أيضا للبحث عن والده، أفانت عالم السحر. ساعد هيسي في جمع المزيد من المعلومات عنه داخل إكلاج."
