		Summary = "انتظار المهمة اليومية",
	},
	[7619] = {
		Title = "مساعدة فريق التنقيب",
		Description = {
			"أصبحت الآن عضوا رسميا في فريق التنقيب. اذهب إلى <NAVI>أوريث<INFO>verus04,141,193,0,101,0</INFO></NAVI>."
		},
		Summary = "تحدث مع أوريث"
	},
	[7620] = {
		Title = "دماء شابة؟",
		Description = {
			"طلبت منك أوريث الذهاب إلى <NAVI>لويد<INFO>verus03,103,177,0,101,0</INFO></NAVI> ولوك في الساحة الواقعة وسط فيروس."
		},
		Summary = "اعثر على لويد"
	},
	[7621] = {
		Title = "تعبئة الطاقة",
		Description = {
			"طلب لويد مساعدتك في أبحاثه المتعلقة بالطاقة. استخدم ^0000FFالزجاجات الفارغة^000000 لجمع 10 طاقات مكثفة من الحطام المنتشر في أنحاء فيروس."
		},
		Summary = "10 طاقات مكثفة"
	},
	[7622] = {
		Title = "أخبار سارة!",
		Description = {
			"أبلغ <NAVI>أوريث<INFO>verus04,141,193,0,101,0</INFO></NAVI> بنتائج أبحاث لويد."
		},
		Summary = "تحدث مع أوريث"
	},
	[7623] = {
		Title = "استدعاء أتناد",
		Description = {
			"لدى <NAVI>أتناد من فريق التنقيب<INFO>verus04,144,193,0,101,0</INFO></NAVI> بعض الأعمال لك. تحدث معه."
		},
		Summary = "تحدث مع أتناد"
	},
	[7624] = {
		Title = "البحث عن طعام شهي",
		Description = {
			"اعثر على شيء جاهز للأكل، كثير العصارة ومنعش ونظيف المذاق. اطلب النصيحة من أعضاء الفريق الآخرين."
		},
		Summary = "اعثر على طعام شهي"
	},
	[7625] = {
		Title = "اعتمد علي",
		Description = {
			"سيطبخ لوك شيئا لك إن أحضرت قطعتين من اللحم وحبة يوسفي مورا وموزة واحدة."
		},
		Summary = "قطعتا لحم وحبة يوسفي مورا وموزة واحدة"
	},
	[7626] = {
		Title = "طعام شهي له",
		Description = {
			"خذ خبز لوك المحمص باللحم البقري، طبق مورا الخاص، إلى أتناد."
		},
		Summary = "إلى إيان"
	},
	[7627] = {
		Title = "الاستكشاف الأخير",
		Description = {
