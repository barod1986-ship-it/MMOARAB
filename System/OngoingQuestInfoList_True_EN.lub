			"زهرة للإلهام - وافق لالو على تعليمك طريق الشعراء، لكنه طلب زهرة مميزة تلهمه قبل أن يبدأ التدريب."
		},
		Summary = "أحضر زهرة مميزة إلى لالو"
	},
	[3002] = {
		Title = "تغيير الوظيفة إلى شاعر",
		Description = {
			"الخطوة الأولى نحو الشعر - طلب لالو السفر إلى لوتي، ومصادقة رجل الثلج الناطق سنويسنو، والعودة بهدية من كيسه."
		},
		Summary = ""
	},
	[3003] = {
		Title = "تغيير الوظيفة إلى شاعر",
		Description = {
			"اختبار ترديد الأغنية - سيغني لالو أبياتا متفرقة، وعليك كتابتها وترديدها كما نطقها تماما. النجاح في الاختبار يؤهلك لتصبح شاعرا."
		},
		Summary = ""
	},
	[3004] = {
		Title = "تغيير الوظيفة إلى شاعر",
		Description = {
			"تذكار الارتقاء - أصبحت مؤهلا لتغيير الوظيفة إلى شاعر. ويمكنك اختياريا إحضار 60 جذعا من النوع نفسه ليصنع لالو منها آلة موسيقية تذكارية."
