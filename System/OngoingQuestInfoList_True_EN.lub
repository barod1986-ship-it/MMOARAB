		Summary = "سلم الطرد في برونتيرا"
	},
	[1010] = {
		Title = "تغيير الوظيفة إلى تاجر",
		Description = {
			"خذ طرد التوصيل من المستودع، ثم اذهب إلى نقابة السحرة في غيفن. عند وصولك، قابل مسؤول نقابة السحرة هناك"
		},
		Summary = "سلم الطرد إلى نقابة السحرة في غيفن"
	},
	[1011] = {
		Title = "تغيير الوظيفة إلى تاجر",
		Description = {
			"خذ طرد التوصيل من المستودع، ثم اذهب إلى موروك. عليك العثور على جافا دوليهان، صانع الأصباغ. إنه كثير النسيان، لذا يفضل أن تسلم الطرد إلى أحد طلابه."
		},
		Summary = "سلم الطرد إلى صانع الأصباغ في موروك"
	},
	[1012] = {
		Title = "تغيير الوظيفة إلى تاجر",
		Description = {
