	[60703] = {
		Title = "رأس السنة القمرية",
		Description = {
			"ما زال متدرب الخياط يحتاج إلى مزيد من المواد. أحضر 25 ساقا ليتمكن من إكمال غطاء الرأس."
		},
		Summary = ""
	},
	[60704] = {
		Title = "رأس السنة القمرية",
		Description = {
			"اذهب إلى جزيرة السلاحف واصطد 50 من سبرينغ رابيت لجمع السحر اللازم لغطاء الرأس. اعثر على جد السلاحف في ألبرتا للذهاب إلى جزيرة السلاحف."
		},
		Summary = "اصطد 50 من سبرينغ رابيت في جزيرة السلاحف"
	},
	[60711] = {
		Title = "اختبارات أستريلد",
		Description = {
			"ابحث خلف كنيسة برونتيرا عن والد خطيبة ابن روزماري. أحضر معك باقة زهور لمساعدته على تحمل حزنه."
		},
		Summary = ""
	},
	[60712] = {
		Title = "اختبارات أستريلد",
		Description = {
			"اعثر في غيفن على صديقة ابنة واين، واحرص على إحضار بعض الزهور معك."
		},
		Summary = ""
	},
	[60713] = {
		Title = "اختبارات أستريلد",
		Description = {
			"اعثر في قرية رماة بايون على الرجل الذي خاض الاختبارات، واحرص على إحضار جرعة إيقاظ معك."
		},
		Summary = ""
	},
	[60714] = {
		Title = "اختبارات أستريلد",
		Description = {
			"اعثر في مكتبة برونتيرا على المرأة التي خاضت الاختبارات، واحرص على إحضار شريط معك."
		},
		Summary = ""
	},
	[60715] = {
		Title = "اختبارات أستريلد",
		Description = {
			"حصلت على أداة ترويض. استخدمها لترويض موناك، ثم أحضرها إلى تشي جو، الكاهن الأكبر في معبد بايون."
		},
		Summary = ""
	},
	[60716] = {
		Title = "اختبارات أستريلد",
		Description = {
			"حصلت على أداة ترويض. استخدمها لترويض بونغون، ثم أحضره إلى تشي جو، الكاهن الأكبر في معبد بايون."
		},
		Summary = ""
	},
	[60717] = {
		Title = "اختبارات أستريلد",
		Description = {
			"توغل في كهف بايون واعثر على كاهن سيعطيك مياها مقدسة، ثم أعدها إلى تشي جو في معبد بايون."
		},
		Summary = ""
	},
	[60718] = {
		Title = "اختبارات أستريلد",
		Description = {
			"توغل في كهف بايون واعثر على كاهن سيعطيك مياها مقدسة، ثم أعدها إلى تشي جو في معبد بايون."
		},
		Summary = ""
	},
	[60719] = {
		Title = "اختبارات أستريلد",
		Description = {
			"أعد المياه المقدسة إلى تشي جو، الكاهن الأكبر في معبد بايون."
		},
		Summary = ""
	},
	[60720] = {
		Title = "اختبارات أستريلد",
		Description = {
			"أعد المياه المقدسة إلى تشي جو، الكاهن الأكبر في معبد بايون."
		},
		Summary = ""
	},
	[60721] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"يجب أن أخبر ريباريف دوغ بأنني على وشك المغادرة، لكن علي أولا معرفة المزيد عن المهمة الأخيرة."
		},
		Summary = ""
	},
	[60722] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"غير مستخدم"
		},
		Summary = ""
	},
	[60723] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"اسأل أمين المكتبة جيكان إن كان قد عثر على أوراق المهمة الأخيرة للفرقة الأولى. بصره ضعيف ويحتاج إلى عدسة مكبرة وفانوس."
		},
		Summary = ""
	},
	[60724] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"يبدو جيكان مشغولا. ربما يجدر بي أن أقرأ بعض الوثائق لبعض الوقت، ثم أتفقد الرفوف إلى أن يحدد المكان الذي ينبغي البحث فيه عن \"سجلات الفصيلة الثالثة\"."
		},
		Summary = ""
	},
	[60725] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"يحتاج جيكان إلى مواد لإعداد نسخة من السجلات: ورقتين من الورق الأملس وورقة من الورق الزيتي من أماتسو، و3 من ريش الطيور من موروك، و20 جوهرة زرقاء من غيفن."
		},
		Summary = "أحضر هذه الأدوات إلى جيكان ليسرع في إكمال النسخة"
	},
	[60726] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"تحتوي نسختك من السجلات على سحر بحث غريب. للعثور على معلومات محددة، عليك البدء بموضوع عام ثم الانتقال إلى تفاصيل أكثر: crusader 3rd_company 3rd_platoon 1st_squad."
		},
		Summary = "ابحث عن أسماء الأعضاء لمعرفة أماكنهم في الوقت الحالي"
	},
	[60727] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"اعثر على زان هوادوكو داخل نقابة الحدادين في غيفن. تحدث معه بأدب واسأله عن أحواله قبل أن تسأله مباشرة عن مهمتهم الأخيرة شديدة السرية. نعم، هذه هي الطريقة!"
		},
		Summary = ""
	},
	[60728] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"أخبرك زان هوادوكو بكل ما استطاع. توجه إلى موروك للعثور على \"كواك دونون\" الذي شوهد آخر مرة في النزل. يبدو أنك ستحتاج إلى الإصرار في موروك."
		},
		Summary = ""
	},
	[60729] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"يختبئ كواك دونون في مخبأ لنقابة الروغ، غالبا في \"حصن سانت دارمين (الجنوب)\" (استخدم الخريطة Ctrl + ~). يفترض أن تكون كلمة المرور \"Aragham never hoarded upgrade items\"."
		},
		Summary = "يعاني كواك من صدمة نفسية شديدة وينهار سريعا، لذلك قد يفيد التعامل معه كطفل صغير، وربما استخدام دمية أيضا"
	},
	[60730] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"قال كواك إن الفرقة عثرت على \"ميغينغجارد\" ثم نشب خلاف بينهم... عليك معرفة المزيد عن ذلك الخلاف. ربما يستطيع جاك أو عند أرصفة ألبرتا مساعدتك."
		},
		Summary = "ما زال كروسيدر نشطا، لذلك يفترض أن يكون الحديث معه أكثر سهولة"
	},
	[60731] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"شعر جاك أو ببعض الراحة بعد استخدام عشب أخضر. ربما ينبغي نقل هذه النصيحة إلى بقية الكروسيدر الذين ستقابلهم. توجد إيما سيرث في ألديباران؛ يمكنك ركوب السفينة إلى إزلود ثم استخدام انتقال كافرا إلى ألديباران!"
		},
		Summary = "ربما ينبغي أيضا إحضار وسيلة تساعد هؤلاء الكروسيدر على التذكر، مثل مشبك كتاب من ريد وورد"
	},
	[60732] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"أظن أن علي الإسراع لمقابلة \"ذا ناينبول\" الذي يعمل حارسا في نزل جاواي. سمعت أن ساقيا سابقا من جاواي يعمل في حانة برونتيرا المركزية، وربما يعرف طريقة للوصول إلى جاواي من دون زواج!"
		},
		Summary = "شخص يدعى ناينبول ويعمل حارسا قد يكون قليل الكلام، لذا واصل التحدث معه حتى يتفاعل مع أسئلتك"
	},
	[60733] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"غادر جاواي باستخدام جناح فراشة أو اشرب حتى تعود إلى رون ميدغارد. اذهب إلى كومودو لمقابلة \"رويال ميست\" في الكازينو الجنوبي. عادة يكون الانتقال من موروك إلى كومودو أسهل طريقة."
		},
		Summary = "قد تساعد جرعتان من الكحول على جعل رويال ميست أكثر استعدادا للكلام"
	},
	[60734] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"تحدثت مع جميع الكروسيدر الذين ما زالوا أحياء. يبدو أن شيئا حدث وتبادل الجميع الاتهامات، ومات الكروسيدر إغنيغيم أثناء ذلك. عد إلى قلعة برونتيرا وأبلغهم بما توصلت إليه."
		},
		Summary = "يمكنك الانتقال سريعا بكافرا من كومودو إلى موروك ثم برونتيرا، إلا إن كانت نقطة حفظك في برونتيرا"
	},
	[60735] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"عليك التحدث مع آخر أعضاء الفرقة الأولى، الراحل إغنيغيم. يمكنك الانتقال بكافرا من برونتيرا إلى موروك ثم كومودو وأومبالا، وبعدها التوجه شمالا عبر شجرة الحياة إلى نيفلهايم للوصول إليه."
		},
		Summary = "استمع إلى إغنيغيم واعرف ما يمكنك فعله لإصلاح الأمر"
	},
	[60736] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"برحمة أودين، هذا أمر فظيع. لم تتخيل أن يرتكب كروسيدر مقدس فعلا شريرا كهذا للاستيلاء على قوة ميغينغجارد. تحل بالشجاعة وعد إلى مقر الكروسيدر وأخبر ماكس فون شيدو بما تعرفه."
		},
		Summary = ""
	},
	[60737] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"قبل ماكس فون شيدو تقريري، وقد أزعجه محتواه بشدة، لكن جزءا مني يعتقد أن الواقع السياسي قد يمنع تحقيق العدالة رغم النيات الحسنة."
		},
		Summary = "علي إخبار إغنيغيم بالنتيجة على الأقل، فمن حقه أن يعرف ما الذي مات من أجله"
	},
	[60738] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"باركك إغنيغيم بكل ما تبقى لديه من قوة. تشعر بأن هناك شخصا مميزا يرغب في معرفة مصيره. عليك إخبار إيما سيرث بما حدث له."
		},
		Summary = ""
	},
	[60739] = {
		Title = "ختم ميغينغجارد",
		Description = {
			"لا تستطيع إيما التذكر، لكنها تشعر بالخسارة. ضعف إيمانك بالعدالة الآن... عليك إخبار ماكس فون شيدو، فهو القاضي وينبغي أن يتحمل نصيبه من عبء الذنب."
		},
		Summary = "عد إلى ماكس فون شيدو في قلعة برونتيرا"
	},
	[60801] = {
		Title = "مربي حيوانات WoE",
		Description = {
			"يجب أن تنتظر انتهاء المؤقت قبل استئجار مطية أخرى من مربي الحيوانات الموجود خارج مناطق WoE."
		},
		Summary = ""
	},
	[60810] = {
		Title = "وصول VIP محدود",
		Description = {
			"يتيح لك هذا لمدة 3 أيام استخدام خدمات موظفة كافرا المخفضة، وخدمات بريمو المعزز، وانتقالات خدمة VIP، والحصول من غرامبس على مهمتي صيد وانتقالات. بعد انتهاء المؤقت لن تتمكن من الاستفادة من هذا الوصول."
		},
		Summary = "*ملاحظة: لا تشمل هذه الصلاحية مكافآت EXP الخاصة بـVIP أو خانات الشخصيات الإضافية أو سعة التخزين البالغة 600"
	},
