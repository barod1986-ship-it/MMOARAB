		Summary = "20 جهاز تحكم بالطاقة"
	},
	[7616] = {
		Title = "جمع النوى (انتظار)",
		IconName = "ico_dq.bmp",
		Description = {
			"يركز <NAVI>فريق تنقيب أتناد<INFO>verus04,144,193,0,101,0</INFO></NAVI> على دراسة أجهزة التحكم بالطاقة. استرح ما دمت تستطيع."
		},
		Summary = "انتظار المهمة اليومية",
	},
	[7617] = {
		Title = "تسليم تقرير التنقيب",
		IconName = "ico_dq.bmp",
		Description = {
			"خذ تقرير التنقيب اليومي الخاص بفريق أتناد إلى <NAVI>لويس<INFO>verus04,179,165,0,101,0</INFO></NAVI> في مركز القيادة المركزي. بعد ذلك ينتهي عملك لهذا اليوم!"
		},
		Summary = "سلم التقرير إلى لويس"
	},
	[7618] = {
