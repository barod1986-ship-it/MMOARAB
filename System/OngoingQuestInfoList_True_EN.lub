		Summary = "10 قرون هيلسريون و10 قرون غامضة و10 حوافر خيول"
	},
	[7429] = {
		Title = "أحدث صيحة برية!",
		Description = {
			"يبدو أن المواد التي جمعها مينوئيل أحدثت ضجة بين زينة منازل ياي. اجمع المواد بانتظام للحفاظ على هذه الصيحة."
