		},
		Summary = "عد إلى المستشفى"
	},
	[11300] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"لندخل معا بما أن باب الطابق الأول مفتوح."
		},
		Summary = "تحدث مع لاس داخل المستشفى"
	},
	[11301] = {
		Title = "ممرضة في ميناء مالايا",
		Description = {
			"تفقدت المكان أولا، لكن ربما فاتتني بعض التفاصيل. هل يمكنك تفقد مدخل الطابق الثاني؟"
		},
		Summary = "حقق عند مدخل الطابق الثاني"
