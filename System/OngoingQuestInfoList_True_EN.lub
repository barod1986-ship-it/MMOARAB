		Description = {
			"يقال إن امرأة الشاطئ التي تظهر في الذكريات تعيش في لوتي! قابلها واستمع إلى قصتها المفصلة."
		},
		Summary = "امرأة لوتي"
	},
	[14262] = {
		Title = "امرأة مالانغدو",
		Description = {
			"كانت امرأة الشاطئ التي تظهر في الذكريات في مالانغدو!! قابلها واستمع إلى قصتها المفصلة."
		},
		Summary = "امرأة مالانغدو"
	},
	[14263] = {
		Title = "البحث عن الصديق",
		Description = {
			"استقر صديقي هنا في مالانغدو. يقع منزله في مكان ما جنوبا، فاذهب وابحث عنه. لكن ربما لا يعرف صديقي شيئا أيضا..."
		},
		Summary = "البحث عن الصديق"
	},
	[14264] = {
		Title = "سليل القطط!",
		Description = {
			"يعيش أحد سلالة القطط هنا في مالانغدو. اذهب إليه إن كنت مهتما. كان في مكان ما شمالا."
		},
		Summary = "سليل القطط!!"
	},
	[14265] = {
		Title = "طلب القطة",
		Description = {
			"مياو~ تعرف أنه لا يوجد شيء مجاني في هذا العالم، صحيح؟ سمعت بوجود سمكة شهية، مياو... لم أتذوقها من قبل وأشعر بالفضول، مياو~ هل تحضر لي واحدة؟ إن لم تجد السمكة الشهية، فأحضر ذلك الشيء بدلا منها، مياو~ ألا تعرفه؟ ذلك الشيء، مياو؟"
		},
		Summary = "طلب القطة"
	},
	[14266] = {
		Title = "تخفيض نصف السعر على الأسياخ",
		Description = {
			"لا أشعر تجاهك إلا بالامتنان. سأبيعك الأسياخ بنصف السعر تعبيرا عن شكري. أتمنى تقديمها مجانا، لكن سياسة لجنة إدارة المهرجان تمنعني..."
		},
		Summary = "تخفيض نصف السعر على الأسياخ"
	},
	[14267] = {
		Title = "سيخ الحبار",
		Description = {
			"توجد حفرة حفرها جيلبونغ في مكان ما من الجزيرة. ابحث داخلها عن سيخ للحبار."
		},
		Summary = "العثور على سيخ الحبار!"
	},
