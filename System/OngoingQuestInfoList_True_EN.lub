		Summary = ""
	},
	[7115] = {
		Title = "معلومات من بائع متجول",
		Description = {
			"قال بائع متجول إن هناك فتاة ترتدي ملابس رثة، لكنها تشتري أغراضا طازجة وباهظة الثمن كل يوم."
		},
		Summary = ""
	},
	[7116] = {
		Title = "معلومات من رجل عجوز",
		Description = {
			"قال الرجل العجوز في القرية إن فتاة تظهر في المكان والوقت نفسيهما كل يوم. ربما انتقلت إلى هنا مؤخرا."
		},
		Summary = ""
	},
	[7117] = {
