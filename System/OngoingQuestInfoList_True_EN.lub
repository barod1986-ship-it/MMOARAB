	[1009] = {
		Title = "تغيير الوظيفة إلى تاجر",
		Description = {
			"خذ طرد التوصيل من المستودع، ثم اذهب إلى مقر جمعية السيافين السابق في برونتيرا. عند وصولك، قابل موظفة كافرا الموجودة هناك. اسمها بلوسوم."
