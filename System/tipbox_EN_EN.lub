		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"This is where the headquarters of Rekenber Corporation is located, and the city has developed systematically under the influence of corporations. It is also called the City of Light and Darkness due to the large difference between the place where a lot of the wealthy live and the slum dwelling in the relatively isolated outskirts.\n?<NAVI>[Hotel Royal Dragon]<INFO>lighthalzen,159,133,0,000,0</INFO></NAVI>\n?<NAVI>[Bank]<INFO>lighthalzen,203,257,0,000,0</INFO></NAVI>\n?<NAVI>[Airport]<INFO>lighthalzen,262,75,0,000,0</INFO></NAVI>\n?<NAVI>[General Store]<INFO>lighthalzen,199,164,000,0,0</INFO></NAVI>\n?<NAVI>[Rekenber Headquarters]<INFO>lighthalzen,101,243,0,000,0</INFO></NAVI>\n?<NAVI>[Shadow Workshop]<INFO>lighthalzen,41,56,0,101,0</INFO></NAVI>\n\n?<TIPBOX>Schwartzvald Republic<INFO>4040</INFO></TIPBOX>\n?<TIPBOX>View Tip List<INFO>1000</INFO></TIPBOX>"
