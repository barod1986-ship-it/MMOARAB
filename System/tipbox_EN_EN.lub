		Imgcoord = { Position = 5, Size = 100 },
		Page = {
			"An industrial city lined with machine factories that work non-stop. Perhaps that's why the soot emitted from the factory is thick. It is a planned industrial city created to operate factories by directly refining minerals produced in Einbech.\n?<NAVI>[Airport]<INFO>einbroch,64,204,0,000,0</INFO></NAVI>\n?<NAVI>[Factory]<INFO>einbroch,129,79,0,000,0</INFO></NAVI>\n?<NAVI>[Square]<INFO>einbroch,254,199,0,000,0</INFO></NAVI>\n?<NAVI>[Hotel Einz Essen]<INFO>einbroch,254,199,0,000,0</INFO></NAVI>\n?<NAVI>[Train Station]<INFO>einbroch,232,272,0,000,0</INFO></NAVI>\n?<NAVI>[Weapon Dealer]<INFO>einbroch,216,211,0,000,0</INFO></NAVI>\n?<NAVI>[Lab]<INFO>einbroch,55,52,0,000,0</INFO></NAVI>\n?<NAVI>[Memorial Tower]<INFO>einbroch,178,173,0,000,0</INFO></NAVI>\n\n?<TIPBOX>Schwartzvald Republic<INFO>4040</INFO></TIPBOX>\n?<TIPBOX>View Tip List<INFO>1000</INFO></TIPBOX>"
