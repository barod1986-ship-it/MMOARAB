# Preserve all game/source files byte-for-byte and never normalize their EOLs.
* -text

# Repository documentation and tools are UTF-8/LF.
README.md text eol=lf
AGENTS.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
/docs/** text eol=lf
/glossary/** text eol=lf
/tools/** text eol=lf
/.github/** text eol=lf
/tracking/** text eol=lf

# Show textual diffs while still disabling EOL conversion.
*.txt -text diff
*.lua -text diff
*.lub -text diff
*.yml -text diff
*.yaml -text diff
*.conf -text diff
*.ini -text diff
*.csv -text diff
