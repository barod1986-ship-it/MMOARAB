# Preserve source files exactly and prevent automatic EOL conversion
* -text

# Files intentionally maintained as UTF-8 text in the Git workspace
*.md text eol=lf working-tree-encoding=UTF-8
*.json text eol=lf working-tree-encoding=UTF-8
*.yml text eol=lf
*.yaml text eol=lf

# Ragnarok/rAthena source files: keep byte representation unchanged
*.txt -text
*.lua -text
*.lub -text
*.csv -text

# Binary delivery and workbook formats
*.zip binary
*.7z binary
*.rar binary
*.xlsx binary
*.xls binary
*.grf binary
*.exe binary
