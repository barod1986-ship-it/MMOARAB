{
  "schemaVersion": 1,
  "policyRevision": "benchmark-thresholds-v2",
  "policyNature": "project-release-policy-not-vendor-benchmark",
  "qualityThresholds": {
    "dialogueRecallMin": 0.97,
    "detectionPrecisionMin": 0.9,
    "artworkFalsePositiveAreaRateMax": 0.005,
    "maskOverreachRateMax": 0.03,
    "maskUndercoverageRateMax": 0.05,
    "ocrCerMax": {
      "en": 0.08,
      "ja": 0.12,
      "ko": 0.1,
      "zh-Hans": 0.1,
      "zh-Hant": 0.12
    },
    "readingOrderPairwiseAccuracyMin": 0.98,
    "arabicRendererGoldensMin": 20,
    "inpaintingHumanScoreMin": 4.0,
    "dialogueRecallMinByLanguage": {
      "en": 0.97,
      "ja": 0.94,
      "ko": 0.94,
      "zh-Hans": 0.94,
      "zh-Hant": 0.94
    },
    "detectionPrecisionMinByLanguage": {
      "en": 0.9,
      "ja": 0.88,
      "ko": 0.88,
      "zh-Hans": 0.88,
      "zh-Hant": 0.88
    },
    "ocrSamplesMin": {
      "en": 50,
      "ja": 10,
      "ko": 10,
      "zh-Hans": 5,
      "zh-Hant": 5
    },
    "readingOrderPairwiseAccuracyMinByLanguage": {
      "en": 0.98,
      "ja": 0.96,
      "ko": 0.97,
      "zh-Hans": 0.97,
      "zh-Hant": 0.97
    },
    "readingOrderPagesMin": {
      "en": 20,
      "ja": 10,
      "ko": 10,
      "zh-Hans": 5,
      "zh-Hant": 5
    }
  },
  "humanReviewThresholds": {
    "translationPagesMin": 30,
    "inpaintingPagesMin": 20,
    "arabicNaturalnessMeanMin": 4.0,
    "translationPagesByLanguageMin": {
      "en": 20,
      "ja": 3,
      "ko": 3,
      "zh-Hans": 2,
      "zh-Hant": 2
    }
  },
  "performanceGuardrails": {
    "peakRamMiBMax": 4096,
    "p95PageSecondsMax": 30.0
  },
  "selectionPolicy": {
    "detector": "hard-safety-floors-then-highest-dialogue-recall-then-f1-then-latency",
    "ocr": "hard-CER-floor-then-lowest-CER; choose smaller model only when CER delta <= 0.005 and p95 latency improves >= 15%",
    "inpainter": "zero-critical-human-review-failures; then quality score; then peak VRAM/RAM and latency",
    "runtime": "record-and-freeze-exact-framework-and-hardware-class; newest-version-is-not-an-automatic-winner"
  },
  "notes": [
    "All SFX/uncertain destructive-edit gates are exact-zero and are enforced outside these tunable quality thresholds.",
    "Threshold changes require a new policyRevision and a new benchmark/freeze; never edit a released policy silently.",
    "Performance values are guardrails, not a cross-hardware vendor comparison. Benchmark reports must identify CPU/GPU/runtime versions.",
    "V1 detector comparison uses the two release-qualifiable official PP-OCRv6 detector artifacts (small vs medium); comic-specialized detectors remain post-V1 research until a reviewed pretrained artifact and runtime adapter are available."
  ],
  "candidateCoverage": {
    "detector": [
      "ppocrv6-small",
      "ppocrv6-medium"
    ],
    "ocr-en": [
      "ppocrv6-small",
      "ppocrv6-medium"
    ],
    "ocr-ja": [
      "manga-ocr",
      "ppocrv6"
    ],
    "ocr-ko": [
      "korean-ppocrv5"
    ],
    "ocr-zh": [
      "ppocrv6-small",
      "ppocrv6-medium"
    ],
    "inpaint": [
      "lama",
      "aot"
    ]
  },
  "roleSafety": {
    "productionRevision": "visual-enclosure-sfx-guard-v1",
    "sfxProtectedRecallMin": 1.0,
    "grantPolicy": "translate-replace only on high-confidence enclosed dialogue/narration; all other blocks preserve-original"
  }
}
