{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "rootDir": "src",
    "outDir": ".offline-check",
    "skipLibCheck": true
  },
  "include": [
    "src/page/types.ts",
    "src/page/source-resolver.ts",
    "src/page/scoring.ts",
    "src/page/acquisition/crop-math.ts",
    "src/page/acquisition/remote-policy.ts",
    "src/core/errors.ts",
    "src/pipeline/types.ts",
    "src/pipeline/sha256.ts",
    "src/pipeline/processing-spec.ts",
    "src/pipeline/delivery-gate.ts",
    "src/shared/constants.ts",
    "src/shared/ids.ts",
    "src/queue/priority.ts",
    "src/queue/candidate-admission.ts",
    "src/queue/memory-admission.ts",
    "src/queue/capacities.ts",
    "src/cache/cache-key.ts"
  ]
}
